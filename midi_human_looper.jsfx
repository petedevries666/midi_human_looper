 sw_edit_target=si;sw_edit_new=is_new;ui_sw_selected=si;ui_sw_step=0;ui_sw_editor_open=1;b=sw_cfg(si);j=0;
 loop(SW_STRIDE,mem[SW_DRAFT_BASE+j]=mem[b+j];j+=1;);mem[SW_DRAFT_BASE+23]=0;
 is_new ? (j=0;loop(24,mem[SW_DRAFT_BASE+j]=0;j+=1;);j=32;loop(80,mem[SW_DRAFT_BASE+j]=0;j+=1;);
 mem[SW_DRAFT_BASE]=1;mem[SW_DRAFT_BASE+4]=60+si;mem[SW_DRAFT_BASE+7]=300;mem[SW_DRAFT_BASE+8]=800;
 mem[SW_DRAFT_BASE+12]=127;mem[SW_DRAFT_BASE+14]=SW_NEXT;mem[SW_DRAFT_BASE+17]=si;mem[SW_DRAFT_BASE+18]=si;mem[SW_DRAFT_BASE+19]=si;
 mem[SW_DRAFT_BASE+20]=1;mem[SW_DRAFT_BASE+21]=mem[DS_CFG_BASE+1];mem[DS_CFG_BASE+1]+=1;);
 ););
function sw_commit_edit()
local(si,b,j,target,conflict,changed)
