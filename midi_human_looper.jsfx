desc:MIDI Human Looper v0.5

// Free-time MIDI looper prototype for REAPER JSFX.
// Workflow:
// 1. Press READY.
// 2. Recording starts on the first incoming Note On.
// 3. Press PLAY exactly where the loop should end.
// 4. The captured MIDI loops immediately.
// 5. STOP halts playback without deleting the loop.
// 6. The plugin shows detected BPM + bars after analysis.
//
// v0.2:
// - STOP button
// - supports 1..16 bar inference, including 2 / 3 / 4 / 5 / etc.
// - clearer detected info in the UI
// - loop can be stopped and restarted without re-recording
// v0.4:
// - live MIDI always passes through, including while the loop is playing
// - STOP/CLEAR send explicit Note Off for all 128 notes on all 16 channels

slider1:0<0,1,1>-READY (use GUI button)-
slider2:0<0,1,1>-PLAY (use GUI button)-
slider3:0<0,1,1>-STOP (use GUI button)-
slider4:0<0,1,1>-CLEAR (use GUI button)-
slider5:120<30,240,0.1>BPM DETECTED
slider6:4<1,16,1>BARS DETECTED
slider7:0<0,1,1{RAW,QUANTIZE}>QUANTIZE (reserved)
slider8:16<1,16,1>MIDI OUT CHANNEL

@init

STATE_IDLE = 0;
STATE_READY = 1;
STATE_RECORDING = 2;
STATE_PLAYING = 3;
STATE_STOPPED = 4;

state = STATE_IDLE;

MAX_EVENTS = 8192;
EV_SIZE = 5;

// memory layout per event:
// +0 timestamp in samples
// +1 status
// +2 data1
// +3 data2
// +4 original event offset (reserved)

event_count = 0;
record_sample_pos = 0;
loop_len_samples = 0;
play_sample_pos = 0;
started = 0;
analysis_done = 0;
panic_pending = 0;

prev_ready = 0;
prev_play = 0;
prev_stop = 0;
prev_clear = 0;

function clear_loop()
(
  event_count = 0;
  record_sample_pos = 0;
  loop_len_samples = 0;
  play_sample_pos = 0;
  started = 0;
  analysis_done = 0;
  state = STATE_IDLE;
  slider5 = 120;
  slider6 = 4;
);

function store_event(ts, st, d1, d2, offs)
local(base)
(
  event_count < MAX_EVENTS ? (
    base = event_count * EV_SIZE;
    mem[base] = ts;
    mem[base+1] = st;
    mem[base+2] = d1;
    mem[base+3] = d2;
    mem[base+4] = offs;
    event_count += 1;
  );
);

function infer_tempo()
local(seconds, best_score, bars, bpm, score, target_bpm, i)
(
  loop_len_samples > 0 ? (
    seconds = loop_len_samples / srate;
    best_score = 1000000000;
    target_bpm = 120;

    // v0.3.1: evaluate every bar count from 1 to 16.
    // 4/4 assumption for now.
    i = 1;
    loop(16,
      bars = i;
      bpm = (bars * 4 * 60) / seconds;

      (bpm >= 30 && bpm <= 240) ? (
        // Temporary heuristic:
        // prefer a musically plausible BPM close to 120.
        score = abs(bpm - target_bpm);

        // Slightly prefer common short loop sizes when scores are close,
        // but still allow odd bar counts such as 3, 5, 7, etc.
        (bars == 2 || bars == 4 || bars == 8) ? score -= 0.75;

        score < best_score ? (
          best_score = score;
          slider5 = bpm;
          slider6 = bars;
        );
      );

      i += 1;
    );

    analysis_done = 1;
  );
);

function send_all_notes_off()
local(ch, note)
(
  // Must run from @block. Use explicit 4-argument midisend syntax.
  ch = 0;
  loop(16,
    note = 0;
    loop(128,
      midisend(0, 128 | ch, note, 0);
      note += 1;
    );
    midisend(0, 176 | ch, 64, 0);   // sustain pedal OFF
    midisend(0, 176 | ch, 123, 0);  // all notes off
    midisend(0, 176 | ch, 120, 0);  // all sound off
    ch += 1;
  );
);

@slider

ready_now = slider1;
play_now = slider2;
stop_now = slider3;
clear_now = slider4;

(clear_now > 0.5 && prev_clear <= 0.5) ? (
  panic_pending = 1;
  clear_loop();
  slider1 = 0;
  slider2 = 0;
  slider3 = 0;
  slider4 = 0;
);

(ready_now > 0.5 && prev_ready <= 0.5) ? (
  event_count = 0;
  record_sample_pos = 0;
  loop_len_samples = 0;
  play_sample_pos = 0;
  started = 0;
  analysis_done = 0;
  state = STATE_READY;

  slider2 = 0;
  slider3 = 0;
);

(play_now > 0.5 && prev_play <= 0.5) ? (
  state == STATE_RECORDING ? (
    // PLAY defines the exact loop boundary at the start of this audio block.
    loop_len_samples = record_sample_pos;
    loop_len_samples < 1 ? loop_len_samples = 1;

    infer_tempo();

    play_sample_pos = 0;
    state = STATE_PLAYING;
    slider1 = 0;
  ) :
  state == STATE_STOPPED && loop_len_samples > 0 && event_count > 0 ? (
    // Restart an already captured loop from its beginning.
    play_sample_pos = 0;
    state = STATE_PLAYING;
  );

  slider2 = 0;
);

(stop_now > 0.5 && prev_stop <= 0.5) ? (
  state == STATE_PLAYING ? (
    panic_pending = 1;
    play_sample_pos = 0;
    state = STATE_STOPPED;
  ) :
  state == STATE_RECORDING ? (
    // STOP during recording cancels this take but keeps plugin alive.
    panic_pending = 1;
    event_count = 0;
    record_sample_pos = 0;
    loop_len_samples = 0;
    analysis_done = 0;
    state = STATE_IDLE;
  ) :
  state == STATE_READY ? (
    state = STATE_IDLE;
  );

  slider3 = 0;
);

prev_ready = slider1;
prev_play = slider2;
prev_stop = slider3;
prev_clear = slider4;

@block

// MIDI output belongs in the audio/MIDI thread. The GUI only requests a panic.
panic_pending ? (
  send_all_notes_off();
  panic_pending = 0;
);

while (
  midirecv(offset, msg1, msg23) ?
  (
    status = msg1 & 240;
    d1 = msg23 & 127;
    d2 = (msg23 / 256) & 127;

    is_note_on = (status == 144 && d2 > 0);

    state == STATE_READY && is_note_on ? (
      state = STATE_RECORDING;
      started = 1;
      record_sample_pos = 0;

      // First Note On becomes sample zero.
      store_event(0, msg1, d1, d2, offset);
    ) :
    state == STATE_RECORDING ? (
      store_event(record_sample_pos + offset, msg1, d1, d2, offset);
    );

    // Live MIDI passthrough ALWAYS: you can play over the stored loop.
    midisend(offset, msg1, msg23);
    1;
  );
  0;
);

// Playback captured events.
state == STATE_PLAYING && loop_len_samples > 0 && event_count > 0 ? (
  block_remaining = samplesblock;
  block_cursor = 0;

  while(block_remaining > 0) (
    segment = min(block_remaining, loop_len_samples - play_sample_pos);

    i = 0;
    loop(event_count,
      base = i * EV_SIZE;
      evt_t = mem[base];

      evt_t >= play_sample_pos && evt_t < play_sample_pos + segment ? (
        out_offs = block_cursor + (evt_t - play_sample_pos);

        out_chan = max(1,min(16,slider8)) - 1;
        out_status = (mem[base+1] & 240) | out_chan;
        out_msg23 = (mem[base+2] & 127) | ((mem[base+3] & 127) * 256);

        midisend(out_offs, out_status, out_msg23);
      );

      i += 1;
    );

    play_sample_pos += segment;
    block_cursor += segment;
    block_remaining -= segment;

    play_sample_pos >= loop_len_samples ? play_sample_pos = 0;
  );
);

state == STATE_RECORDING ? record_sample_pos += samplesblock;

@gfx 560 360

function hit(x,y,w,h)
(
  mouse_cap & 1 && !(last_mouse_cap & 1) &&
  mouse_x >= x && mouse_x < x+w &&
  mouse_y >= y && mouse_y < y+h
);

function button(x,y,w,h,label,active)
(
  active ? gfx_set(0.35,0.35,0.35,1) : gfx_set(0.18,0.18,0.18,1);
  gfx_rect(x,y,w,h,1);
  gfx_set(0.8,0.8,0.8,1);
  gfx_rect(x,y,w,h,0);
  gfx_setfont(1,"Arial",16);
  gfx_measurestr(label,tw,th);
  gfx_x=x+(w-tw)/2;
  gfx_y=y+(h-th)/2;
  gfx_drawstr(label);
);

bx=20; by=18; bw=115; bh=42; gap=10;

button(bx,by,bw,bh,"READY",state==STATE_READY || state==STATE_RECORDING);
button(bx+bw+gap,by,bw,bh,"PLAY",state==STATE_PLAYING);
button(bx+(bw+gap)*2,by,bw,bh,"STOP",state==STATE_STOPPED);
button(bx+(bw+gap)*3,by,bw,bh,"CLEAR",0);

hit(bx,by,bw,bh) ? (
  event_count=0; record_sample_pos=0; loop_len_samples=0; play_sample_pos=0;
  started=0; analysis_done=0; state=STATE_READY;
);

hit(bx+bw+gap,by,bw,bh) ? (
  state==STATE_RECORDING ? (
    loop_len_samples=record_sample_pos;
    loop_len_samples<1 ? loop_len_samples=1;
    infer_tempo();
    play_sample_pos=0;
    state=STATE_PLAYING;
  ) : state==STATE_STOPPED && loop_len_samples>0 && event_count>0 ? (
    play_sample_pos=0;
    state=STATE_PLAYING;
  );
);

hit(bx+(bw+gap)*2,by,bw,bh) ? (
  state==STATE_PLAYING ? (
    panic_pending = 1;
    play_sample_pos=0;
    state=STATE_STOPPED;
  ) : state==STATE_RECORDING ? (
    panic_pending = 1;
    event_count=0; record_sample_pos=0; loop_len_samples=0;
    analysis_done=0; state=STATE_IDLE;
  ) : state==STATE_READY ? state=STATE_IDLE;
);

hit(bx+(bw+gap)*3,by,bw,bh) ? (
  panic_pending = 1;
  clear_loop();
);

last_mouse_cap=mouse_cap;

gfx_set(0.8,0.8,0.8,1);

gfx_setfont(1, "Arial", 22);
gfx_x = 20;
gfx_y = 78;

state == STATE_IDLE ? gfx_drawstr("IDLE") :
state == STATE_READY ? gfx_drawstr("READY - waiting for first Note On") :
state == STATE_RECORDING ? gfx_drawstr("RECORDING FREE TIME") :
state == STATE_PLAYING ? gfx_drawstr("LOOPING") :
state == STATE_STOPPED ? gfx_drawstr("STOPPED - loop stored");

gfx_setfont(1, "Arial", 16);

gfx_x = 20;
gfx_y = 112;
gfx_drawstr("Events: ");
gfx_drawnumber(event_count,0);

gfx_x = 20;
gfx_y = 142;
state == STATE_RECORDING ? (
  gfx_drawstr("Recording length: ");
  gfx_drawnumber(record_sample_pos / srate,3);
  gfx_drawstr(" s");
) : loop_len_samples > 0 ? (
  gfx_drawstr("Loop length: ");
  gfx_drawnumber(loop_len_samples / srate,3);
  gfx_drawstr(" s");
);

analysis_done ? (
  gfx_setfont(1, "Arial", 24);

  gfx_x = 20;
  gfx_y = 182;
  gfx_drawstr("DETECTED");

  gfx_setfont(1, "Arial", 21);

  gfx_x = 20;
  gfx_y = 220;
  gfx_drawstr("Tempo: ");
  gfx_drawnumber(slider5,2);
  gfx_drawstr(" BPM");

  gfx_x = 20;
  gfx_y = 255;
  gfx_drawstr("Length: ");
  gfx_drawnumber(slider6,0);
  slider6 == 1 ? gfx_drawstr(" bar") : gfx_drawstr(" bars");

  gfx_setfont(1, "Arial", 13);
  gfx_x = 20;
  gfx_y = 308;
  gfx_drawstr("4/4 assumed | v0.5 duration-based inference");
) : (
  gfx_setfont(1, "Arial", 13);
  gfx_x = 20;
  gfx_y = 200;
  gfx_drawstr("READY -> first note starts capture -> PLAY closes loop");
);
