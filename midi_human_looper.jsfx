local(j,found)
(j=0;found=0;loop(max(0,min(TRANSFORM_SLOTS,floor(mem[INST_TRANSFORM_COUNT_BASE+gi]))),abs(mem[INST_TRANSFORM_TYPE_BASE+gi*TRANSFORM_SLOTS+j])==code?found=1;j+=1;);found;);
function tf_submit(gi,op,arg)
local(ui_q,ui_ok,ui_code)
(ui_ok=gi>=0 && gi<INSTRUMENTS && ui_tf_queue_write-tf_queue_read<TF_QUEUE_SIZE;ui_ok?(
 ui_q=TF_QUEUE_BASE+(ui_tf_queue_write%TF_QUEUE_SIZE)*TF_QUEUE_STRIDE;
 ui_code=op==1?arg:abs(mem[INST_TRANSFORM_TYPE_BASE+gi*TRANSFORM_SLOTS+arg]);
 mem[ui_q]=gi;mem[ui_q+1]=op;mem[ui_q+2]=ui_code;mem[ui_q+3]=op==1?0:tf_id(gi,ui_code);ui_tf_queue_write+=1;
 );ui_ok;);
function tf_queue_process()
local(q,gi,op,arg,c,code,typ,b,j,idx,ready,limit,targetcode)
(
  limit=TF_QUEUE_SIZE;while(tf_queue_read<ui_tf_queue_write && limit>0)(
    q=TF_QUEUE_BASE+(tf_queue_read%TF_QUEUE_SIZE)*TF_QUEUE_STRIDE;gi=mem[q];op=mem[q+1];arg=mem[q+2];c=max(0,min(TRANSFORM_SLOTS,floor(mem[INST_TRANSFORM_COUNT_BASE+gi])));
    op!=1 ? (targetcode=arg;arg=-1;j=0;loop(c,abs(mem[INST_TRANSFORM_TYPE_BASE+gi*TRANSFORM_SLOTS+j])==targetcode && tf_id(gi,targetcode)==mem[q+3]?arg=j;j+=1;););
    code=op==1?arg:arg>=0 && arg<c?abs(mem[INST_TRANSFORM_TYPE_BASE+gi*TRANSFORM_SLOTS+arg]):0;
    typ=op==1?arg:transform_type(gi,code);ready=(typ==6 || mem[PARAM_ACTIVE_BASE+gi]<=0);
    ready ? (
      op==1 && c<TRANSFORM_SLOTS && (arg==1 || arg==2 || arg==4 || arg==6 || !tf_has_code(gi,arg)) ? (
        code=arg;tf_has_code(gi,arg)?(code=7;while(code<=11 && tf_has_code(gi,code))(code+=1;););
        code<=11 ? (
          code>=7 ? (
            idx=cc_index(gi,code);b=cc_cfg(idx);mem[tf_record(idx)]=arg;
            mem[b]=mem[CC_CFG_BASE+1];mem[CC_CFG_BASE+1]+=1;
            mem[b+1]=arg==6?1:0;mem[b+2]=arg==4?1:0;mem[b+3]=arg==2?127:0;
            j=0;loop(3,tf_linear(cc_ti(idx,j));j+=1;);
          ) : (
            code==6?(mem[CC_CFG_BASE+2+gi]=mem[CC_CFG_BASE+1];mem[CC_CFG_BASE+1]+=1;mem[PARAM_MOD_CC_BASE+gi]=1;mem[INST_MOD_BASE+gi]=0;tf_linear(param_ti(gi,EXP_T_MOD));tf_linear(param_ti(gi,PARAM_MOD_CC));):(
              mem[TF_PRIMARY_IDS+gi*TRANSFORM_TYPES+code-1]=mem[CC_CFG_BASE+1];mem[CC_CFG_BASE+1]+=1;
              code==1?(mem[INST_TRANSPOSE_BASE+gi]=0;tf_linear(param_ti(gi,PARAM_TRANSPOSE)););
              code==2?(mem[INST_RANGE_MODE_BASE+gi]=0;mem[INST_RANGE_LOW_BASE+gi]=0;mem[INST_RANGE_HIGH_BASE+gi]=127;j=0;loop(3,tf_linear(param_ti(gi,PARAM_RANGE_MODE+j));j+=1;););
              code==4?(mem[INST_VEL_BASE+gi]=1;tf_linear(param_ti(gi,EXP_T_VEL)););
            );
          );
          mem[INST_TRANSFORM_TYPE_BASE+gi*TRANSFORM_SLOTS+c]=code;mem[INST_TRANSFORM_COUNT_BASE+gi]=c+1;
        );
      );
      op==2 && arg>=0 && arg<c ? (
        j=arg;loop(c-arg-1,mem[INST_TRANSFORM_TYPE_BASE+gi*TRANSFORM_SLOTS+j]=mem[INST_TRANSFORM_TYPE_BASE+gi*TRANSFORM_SLOTS+j+1];j+=1;);
        mem[INST_TRANSFORM_TYPE_BASE+gi*TRANSFORM_SLOTS+c-1]=0;mem[INST_TRANSFORM_COUNT_BASE+gi]=c-1;
      );
      op==3 && arg>=0 && arg<c?mem[INST_TRANSFORM_TYPE_BASE+gi*TRANSFORM_SLOTS+arg]*=-1;
      (op==2 || op==3) && typ==5 ? (
        arp_release_instrument(gi);j=0;loop(128,mem[ARP_SOURCE_COUNT_BASE+gi*128+j]=0;mem[ARP_HELD_COUNT_BASE+gi*128+j]=0;
          mem[SW_ARP_PHRASE_BASE+gi*128+j]=0;mem[SW_ARP_PHRASE_SOURCE_BASE+gi*128+j]=0;j+=1;);
      );
      tf_queue_read+=1;
    ) : limit=0;
    limit-=1;
  );
);

restore_after_init ? (
  restore_after_init=0;
  restore_current_patch_raw();
);

@serialize
// Deliberately trivial. Patch persistence is external JSON from v1.5.0 onward.
serialize_guard=serialize_guard;

@slider
// Transport/CLEAR are handled by the custom @gfx UI and @block engine.
// Keep this section intentionally empty: legacy slider-button handling called
// shared engine functions from @slider and caused REAPER compile failures.

@block

gmem[0]==3 ? external_patch_apply();
gmem[0]==4 ? (io_status=4; gmem[0]=0;);
gmem[0]==5 ? (io_status=5; gmem[0]=0;);

sw_queue_process();tf_queue_process();
param_expression_tick();cc_expression_tick();
// SAVE includes safe pending parameter edits as well as queued switch edits.
patch_save_request>0 && gmem[0]==0 ? (save_patch_file_snapshot(patch_save_request);patch_save_request=0;);
ii=0;
loop(INSTRUMENTS,
  mem[CC_DIRTY_BASE+ii]>0.5 ? (
    send_instrument_cc(ii,mem[INST_LEVEL_CC_BASE+ii],mem[INST_LEVEL_BASE+ii]);
    mem[CC_DIRTY_BASE+ii]=0;
  );
  ii+=1;
);
cc_generators_tick();
ii=0;loop(INSTRUMENTS,mem[CC_DIRTY_MOD_BASE+ii]=0;ii+=1;);

save_flash>0 ? save_flash-=samplesblock;
save_flash<0 ? save_flash=0;

restore_flash>0 ? restore_flash-=samplesblock;
restore_flash<0 ? restore_flash=0;


panic_pending ? (
  send_all_notes_off();
  panic_pending=0;
);

// HOLD STOP: release the currently latched phrase and clear its runtime ownership.
hold_stop_request>=0 ? (
  stopped_layer=hold_stop_request;
  hold_stop_request=-1;
  mem[HOLD_ACTIVE_BASE+stopped_layer]>0.5 ? (
    release_phrase_notes();
    arp_flush_nonhold_sources();
    vi=0;
    loop(MAX_ONCE_VOICES,
      mem[VOICE_ACTIVE_BASE+vi]>0.5 && mem[VOICE_LAYER_BASE+vi]==stopped_layer ? mem[VOICE_ACTIVE_BASE+vi]=0;
      vi+=1;
    );
    mem[HOLD_ACTIVE_BASE+stopped_layer]=0;
    stopped_layer==last_trigger_layer ? last_trigger_layer=-1;
  );
);

// Existing GUI/phrase requests execute at the block boundary.
process_phrase_trigger(0,0);

while (
  midirecv(offset,msg1,msg23) ?
  (
    status=msg1&240;
    d1=msg23&127;
    d2=(msg23/256)&127;
    is_note_on=(status==144 && d2>0);

    !sw_input(msg1,d1,d2,offset) ? (
    status==176 ? (
      // Learning was already consumed by the exclusive input capture above.
      ci=0;loop(CONTROLLERS,learn_matches(SW_COUNT+ci,2,msg1&15,d1)?controller_set_value(ci,d2/127);ci+=1;);
    );

    status==144 || status==128 ? (
      ci=0;loop(CONTROLLERS,learn_matches(SW_COUNT+ci,1,msg1&15,d1)?controller_set_value(ci,is_note_on?1:0);ci+=1;);
    );
    // Learned PHRASES inputs are playback commands, independent of record/overdub.
    (
      is_trigger_command=0;
      status==144 || status==128 ? (
        ti=0;
        loop(LAYERS,
          learn_matches(SW_COUNT+CONTROLLERS+ti,1,msg1&15,d1) ? (
            is_trigger_command=1;
            is_note_on && layer_count(ti)>0 ? (
              mem[MODE_BASE+ti]<.5 ? (
                loop_len_samples>0 ? (mem[TRIG_BASE+ti]=1;state=STATE_PLAYING;);
              ) : (trigger_request=ti;process_phrase_trigger(offset,1););
            );
          );
          ti+=1;
        );
      );
    );

    overdub_wait_note && overdub_armed && is_note_on && !is_trigger_command ? (
      // First played note starts the overdub take and retriggers the original ONCE/HOLD.
      overdub_wait_note=0;overdub_armed=0;overdub_active=1;
      overdub_pos=0;
      trigger_request=overdub_layer;
    );

    !is_trigger_command ? (
    state==STATE_READY && is_note_on && layer_count(record_layer)==0 ? (
      // Only a truly empty phrase can enter destructive first-take recording.
      clear_layer(record_layer);
      state=STATE_RECORDING;
      record_sample_pos=0;
      store_event(record_layer,0,msg1,d1,d2,offset);
    ) :
    state==STATE_READY && layer_count(record_layer)>0 ? (
      // Safety fallback: never erase an existing phrase via READY.
      state=STATE_STOPPED;
    ) :
    state==STATE_RECORDING ? (
      store_event(record_layer,record_sample_pos+offset,msg1,d1,d2,offset);
    ) :
    overdub_active && (mem[MODE_BASE+overdub_layer]<0.5 || overdub_pos+offset<mem[LEN_BASE+overdub_layer]) ? (
      store_event(overdub_layer,overdub_pos+offset,msg1,d1,d2,offset);
    );

    );
    // Trigger keys do not leak into the instrument signal path.
    !is_trigger_command ? send_to_instruments(offset,msg1,d1,d2,1);
    );
    1;
  );
  0;
);

sw_poll(sw_clock+samplesblock,samplesblock-1);sw_clock+=samplesblock;

// arm -> active exactly at the next wrap
state==STATE_PLAYING && overdub_armed && !overdub_active && !overdub_wait_note && mem[MODE_BASE+overdub_layer]<0.5 ? (
  play_sample_pos==0 ? (
    // Overdub must preserve the existing events.
    overdub_pos=0;
    overdub_active=1;
    overdub_armed=0;
  );
);

// playback LOOP layers
state==STATE_PLAYING && loop_len_samples>0 ? (
  block_remaining=samplesblock;
  block_cursor=0;

  while(block_remaining>0) (
    segment=min(block_remaining,loop_len_samples-play_sample_pos);

    layer=0;
    loop(LAYERS,
      layer_audible(layer) && mem[MODE_BASE+layer]<0.5 && mem[TRIG_BASE+layer]>0.5 ? (
        count=layer_count(layer);
        i=0;
        loop(count,
          base=layer_base(layer,i);
          evt_t=mem[base];
          evt_q=quantize_ts(evt_t);
          evt_q>=loop_len_samples ? evt_q-=loop_len_samples;
          evt_q<0 ? evt_q+=loop_len_samples;

          evt_q>=play_sample_pos && evt_q<play_sample_pos+segment ? (
            out_offs=block_cursor+(evt_q-play_sample_pos);

            slider8==0 ? (
              out_status=mem[base+1]&255;
            ) : (
              out_chan=max(1,min(16,slider8))-1;
              out_status=(mem[base+1]&240)|out_chan;
            );

            out_d1=mem[base+2]&127;
            out_d2=mem[base+3]&127;

            ((out_status&240)==144 && out_d2>0) ? (
              velmul=slider9*mem[VEL_BASE+layer];
              out_d2=floor(out_d2*velmul+0.5);
              out_d2=max(1,min(127,out_d2));
            );

            // out_d2 already includes phrase/global velocity; instrument velocity is applied in router.
            sw_playback_origin=1;send_to_instruments(out_offs,out_status,out_d1,out_d2,1);sw_playback_origin=0;
          );

          i+=1;
        );
      );
      layer+=1;
    );

    play_sample_pos+=segment;
    block_cursor+=segment;
    block_remaining-=segment;

    play_sample_pos>=loop_len_samples ? (
      play_sample_pos=0;

      overdub_active && mem[MODE_BASE+overdub_layer]<0.5 ? (
        overdub_active=0;
        overdub_pos=0;
      ) :
      overdub_armed && !overdub_wait_note && mem[MODE_BASE+overdub_layer]<0.5 ? (
        // Never clear a layer when transitioning to overdub.
        overdub_pos=0;
        overdub_active=1;
        overdub_armed=0;
      );
    );
  );
);



// polyphonic ONCE / HOLD attack voice pool
vi=0;
loop(MAX_ONCE_VOICES,
  mem[VOICE_ACTIVE_BASE+vi]>0.5 ? (
    once_layer=mem[VOICE_LAYER_BASE+vi];
    once_start=mem[VOICE_POS_BASE+vi];
    once_end=once_start+samplesblock;
    once_time=mem[VOICE_TIME_BASE+vi];
    phrase_end=max(1,mem[LEN_BASE+once_layer]*once_time);
    count=layer_count(once_layer);
    i=0;
    loop(count,
      base=layer_base(once_layer,i);
      evt_t=mem[base]*once_time;
      evt_t>=once_start && evt_t<once_end && evt_t<phrase_end ? (
        out_offs=evt_t-once_start;
        slider8==0 ? out_status=mem[base+1]&255 : (
          out_chan=max(1,min(16,slider8))-1;
          out_status=(mem[base+1]&240)|out_chan;
        );
        out_d1=mem[base+2]&127;
        out_d2=mem[base+3]&127;
        velmul=slider9*mem[VEL_BASE+once_layer]*mem[VOICE_GAIN_BASE+vi];
        // HOLD replays the human attack exactly, but recorded Note Offs do not terminate it.
        // STOP / next phrase performs the release.
        is_recorded_noteoff=((out_status&240)==128) || ((out_status&240)==144 && out_d2==0);
        !(mem[MODE_BASE+once_layer]>=1.5 && is_recorded_noteoff) ? send_once_to_instruments(out_offs,out_status,out_d1,out_d2,velmul);
      );
      i+=1;
    );
    mem[VOICE_POS_BASE+vi]=once_end;
    mem[VOICE_POS_BASE+vi]>=phrase_end ? (
      mem[VOICE_ACTIVE_BASE+vi]=0;
      mem[VOICE_POS_BASE+vi]=0;
      // Do not global-release here: another overlapping voice of the same phrase may still be sounding.
    );
  );
  vi+=1;
);

// ONE SHOT phrases can end without a final matching Note Off after aggressive retrigger/choke.
// Once no ONE SHOT voice remains, a non-HOLD arp must not retain those orphaned notes.
once_any_active=0;
vi=0;
loop(MAX_ONCE_VOICES,
  mem[VOICE_ACTIVE_BASE+vi]>0.5 ? once_any_active=1;
  vi+=1;
);
once_any_active<0.5 && last_trigger_layer>=0 ? (
  !(mem[MODE_BASE+last_trigger_layer]>=1.5 && mem[HOLD_ACTIVE_BASE+last_trigger_layer]>0.5) ? (
    arp_flush_nonhold_sources();
    last_trigger_layer=-1;
  );
);

state==STATE_RECORDING ? record_sample_pos+=samplesblock;
overdub_active ? (
  overdub_pos+=samplesblock;
  mem[MODE_BASE+overdub_layer]>=0.5 ? (
    // One-shot overdub ends at the recorded phrase length, independently of LOOP.
    overdub_pos>=max(1,mem[LEN_BASE+overdub_layer]) ? (
      overdub_active=0;
      overdub_pos=0;
    );
  ) : (
    overdub_pos>=loop_len_samples ? overdub_pos=loop_len_samples-1;
  );
);

// POST instrument arpeggiators
ii=0;
loop(INSTRUMENTS,
  arp_process_instrument(ii);
  ii+=1;
);

@gfx 900 720

// Expression curve editor state is GUI-only, not patch data.
// EEL variables can survive hot recompiles: reject any stale / invalid popup state before drawing.
(exp_gui_initialized!=1 || options_open<0 || options_open>1 || controller_assign_ti>=UI_PARAM_TOTAL || controller_assign_ti<-1 || controller_assign_ti!=floor(controller_assign_ti)) ? (
  exp_gui_initialized=0;
  options_open=0;
  controller_assign_ti=-1;
  controller_learn=-1;
);

// Expression curve editor state is GUI-only, not patch data.
exp_gui_initialized!=1 ? (
  exp_editor_ti=-1;ui_capture_ti=-1;
  exp_drag_point=-1;
  exp_drag_segment=-1;
  exp_bend_segment=-1;
  custom_save_armed=0;
  transform_menu_gi=-1;
  selected_transform_gi=-1;selected_transform_slot=-1;
  options_open=0;controller_assign_ti=-1;controller_assign_x=0;controller_assign_y=0;
  exp_gui_initialized=1;
);

exp_editor_ti<0 || exp_editor_ti>=UI_PARAM_TOTAL || exp_editor_ti!=floor(exp_editor_ti) ? (
  exp_editor_ti=-1;exp_drag_point=-1;exp_drag_segment=-1;exp_bend_segment=-1;
);
// Small-window vertical scrolling.
// Existing GUI is rendered unchanged into an offscreen content buffer, then a viewport is blitted.
ui_content_h=2020;
ui_view_h=gfx_h;
ui_max_scroll=max(0,ui_content_h-ui_view_h);
mouse_wheel!=0 ? (
  ui_scroll=max(0,min(ui_max_scroll,ui_scroll-mouse_wheel/120*42));
  mouse_wheel=0;
);
screen_mouse_y=mouse_y;
mouse_y=screen_mouse_y+ui_scroll;
gfx_setimgdim(1,gfx_w,ui_content_h);
gfx_dest=1;
gfx_set(0,0,0,1); gfx_rect(0,0,gfx_w,ui_content_h,1);

// Save input once. A modal popup owns this whole frame, including dismissal.
ui_real_cap=mouse_cap;
ui_frame_modal=ui_modal=controller_assign_ti>=0 || transform_menu_gi>=0 || options_open || ui_sw_editor_open || ui_sw_delete_slot>=0 || learn_candidate>=0;
ui_modal ? mouse_cap=0;
!(ui_real_cap&1)?ui_td_reset_latch=0;
!(ui_real_cap&1) ? ui_capture_ti=-1;

function hit(hx,hy,hw,hh)
local(res)
(
  res = !ui_modal && mouse_cap&1 && !(last_mouse_cap&1) &&
        mouse_x>=hx && mouse_x<hx+hw &&
        mouse_y>=hy && mouse_y<hy+hh;
  res;
);

function button(bx_,by_,bw_,bh_,blabel,bactive)
local(tw,th)
(
  bactive ? gfx_set(0.38,0.38,0.38,1) : gfx_set(0.18,0.18,0.18,1);
  gfx_rect(bx_,by_,bw_,bh_,1);
  gfx_set(0.8,0.8,0.8,1);
  gfx_rect(bx_,by_,bw_,bh_,0);
  gfx_setfont(1,"Arial",15);
  gfx_measurestr(blabel,tw,th);
  gfx_x=bx_+(bw_-tw)/2;
  gfx_y=by_+(bh_-th)/2;
  gfx_drawstr(blabel);
);

function smallbtn(sx_,sy_,sw_,sh_,slabel,sactive)
local(tw,th)
(
  sactive ? gfx_set(0.45,0.45,0.45,1) : gfx_set(0.16,0.16,0.16,1);
  gfx_rect(sx_,sy_,sw_,sh_,1);
  gfx_set(0.75,0.75,0.75,1);
  gfx_rect(sx_,sy_,sw_,sh_,0);
  gfx_setfont(1,"Arial",12);
  gfx_measurestr(slabel,tw,th);
  gfx_x=sx_+(sw_-tw)/2;
  gfx_y=sy_+(sh_-th)/2;
  gfx_drawstr(slabel);
);

function phrase_icon(x,y,w,h,kind,lit)
local(cx,cy,ui_j)
(
  lit ? gfx_set(.94,.24,.18,1) : gfx_set(.82,.82,.82,1);
  cx=x+w/2;cy=y+h/2;
  kind==0 ? (
    gfx_rect(cx-10,cy-6,20,12,0);
    ui_j=0;loop(5,gfx_line(cx-8+ui_j*4,cy+1,cx-8+ui_j*4,cy+6);ui_j+=1;);
    gfx_rect(cx-5,cy-6,3,7,1);gfx_rect(cx+3,cy-6,3,7,1);
  ) : kind==1 ? (
    gfx_circle(cx,cy,10,1);
    gfx_set(.08,.08,.08,1);
    gfx_line(cx-5,cy-4,cx+5,cy-4);
    gfx_line(cx-5,cy,cx+5,cy);
    gfx_line(cx-5,cy+4,cx+5,cy+4);
  ) : kind==2 ? (
    gfx_rect(cx-5,cy-4,10,11,0);
    gfx_line(cx-7,cy-6,cx+7,cy-6);
    gfx_line(cx-3,cy-8,cx+3,cy-8);
    gfx_line(cx-2,cy-2,cx-2,cy+5);
    gfx_line(cx+2,cy-2,cx+2,cy+5);
  ) : kind==3 ? (
    gfx_arc(cx,cy,8,0.4,5.6,1);
    gfx_triangle(cx+6,cy-8,cx+12,cy-7,cx+8,cy-2,1);
  ) : kind==4 ? (
    gfx_circle(cx,cy,9,0);
    gfx_triangle(cx-3,cy-5,cx-3,cy+5,cx+5,cy,1);
  ) : kind==5 ? (
    gfx_arc(cx-5,cy,5,0,6.28,1);
    gfx_arc(cx+5,cy,5,0,6.28,1);
  ) : kind==6 ? (
    gfx_triangle(cx-5,cy-8,cx-5,cy+8,cx+8,cy,1);
  );
);

function phrase_icon_btn(x,y,w,h,kind,lit)
(
  gfx_set(.15,.15,.15,1);gfx_rect(x,y,w,h,1);
  gfx_set(.45,.45,.45,1);gfx_rect(x,y,w,h,0);
  phrase_icon(x,y,w,h,kind,lit);
);

function centered_text(tx,ty,twid,thgt,label)
local(mw,mh)
(
  gfx_measurestr(label,mw,mh);
  gfx_x=tx+(twid-mw)/2; gfx_y=ty+(thgt-mh)/2; gfx_drawstr(label);
);

function name_len(ui_base)
local(ui_k,ui_n)
(
  ui_k=0; ui_n=0;
  loop(NAME_CHARS, mem[ui_base+ui_k]>0 ? ui_n=ui_k+1; ui_k+=1;);
  ui_n;
);

function draw_name_chars(ui_base,x,y)
local(ui_k,c)
(
  gfx_x=x;gfx_y=y;
  ui_k=0;
  loop(NAME_CHARS,
    c=floor(mem[ui_base+ui_k]+0.5);
    c>0 ? gfx_drawchar(c);
    ui_k+=1;
  );
);

function edit_name_key(ui_base,key)
local(ui_n,ui_k)
(
  ui_n=name_len(ui_base);
  key==8 ? (
    ui_n>0 ? mem[ui_base+ui_n-1]=0;
  ) :
  key>=32 && key<=126 && ui_n<NAME_CHARS ? mem[ui_base+ui_n]=key;
);

keychar=gfx_getchar();
edit_name_type>0 && keychar>0 ? (
  keychar==13 || keychar==27 ? edit_name_type=0 :
  edit_name_type==1 ? edit_name_key(PHRASE_NAME_BASE+edit_name_index*NAME_CHARS,keychar) :
  edit_name_type==2 ? edit_name_key(INSTR_NAME_BASE+edit_name_index*NAME_CHARS,keychar) :
  edit_name_type==3 ? edit_name_key(sw_edit_cfg(edit_name_index)+SW_NAME,keychar);
);
// Hard square identity header.
gfx_set(.055,.055,.055,1);gfx_rect(12,10,1010,48,1);
gfx_set(.42,.42,.42,1);gfx_rect(12,10,1010,48,0);
gfx_setfont(1,"Courier New",22,'b');gfx_set(.95,.95,.08,1);
gfx_x=24;gfx_y=20;gfx_drawstr("MIDI BAD MOTHERFUCKER V.1.26.0");
gfx_setfont(1,"Courier New",14,'b');gfx_set(.68,.68,.68,1);
gfx_x=760;gfx_y=25;gfx_drawstr("ANONYMALZ LIVE ENGINE");

smallbtn(790,68,92,30,"OPTIONS",options_open);
hit(790,68,92,30)?(options_open=1-options_open;controller_assign_ti=-1;);
bx=20; by=68; bw=92; bh=30; gap=10;

rp_label="READY";
state==STATE_RECORDING ? rp_label="PLAY";
loop_len_samples>0 && state==STATE_STOPPED ? rp_label="PLAY";
button(bx,by,bw,bh,rp_label,state==STATE_READY || state==STATE_RECORDING || state==STATE_PLAYING);

as_label="ABORT";
state==STATE_PLAYING || state==STATE_STOPPED ? as_label="STOP";
button(bx+bw+gap,by,bw,bh,as_label,state==STATE_STOPPED);

button(bx+(bw+gap)*2,by,bw,bh,"CLEAR ALL",0);

// two persistent patch slots
py=108;
smallbtn(20,py,70,30,"PATCH 1",current_patch==1);
smallbtn(96,py,52,30,"SAVE",0);
smallbtn(170,py,70,30,"PATCH 2",current_patch==2);
smallbtn(246,py,52,30,"SAVE",0);
smallbtn(310,py,92,30,"LOAD FILE",0);

hit(20,py,70,30) ? current_patch=1;
hit(96,py,52,30) ? patch_save_request=1;
hit(170,py,70,30) ? current_patch=2;
hit(246,py,52,30) ? patch_save_request=2;
hit(310,py,92,30) ? external_patch_load_request(current_patch);

save_flash>0 ? (
  gfx_set(0.82,0.82,0.82,1);
  gfx_setfont(1,"Arial",13);
  gfx_x=420; gfx_y=116;
  gfx_drawstr("PATCH ");
  gfx_drawnumber(save_flash_patch,0);
  gfx_drawstr(" SAVED");
);

gfx_setfont(1,"Arial",12);
gfx_x=420; gfx_y=116;
gmem[15]>0.5 ? (gmem[16]>=IO_SCHEMA?gfx_drawstr("FILE I/O READY"):gfx_drawstr("UPDATE PATCH I/O SCRIPT")) : gfx_drawstr("RUN PATCH I/O SCRIPT");
patch_save_request>0 || io_status==1 ? (gfx_x=740;gfx_y=116;gfx_drawstr("SAVING..."););
io_status==3 ? (gfx_x=740; gfx_y=116; gfx_drawstr("LOADED"););
io_status==4 ? (gfx_x=740; gfx_y=116; gfx_drawstr("SAVED"););
io_status==5 ? (gfx_x=740; gfx_y=116; gfx_drawstr("I/O ERROR"););

hit(bx,by,bw,bh) ? (
  loop_len_samples>0 && (state==STATE_STOPPED || state==STATE_IDLE) ? (
    play_sample_pos=0;
    state=STATE_PLAYING;
  ) :
  state==STATE_IDLE && loop_len_samples<=0 ? (
    clear_layer(0);
    record_layer=0;
    record_sample_pos=0;
    play_sample_pos=0;
    analysis_done=0;
    state=STATE_READY;
  ) :
  state==STATE_RECORDING ? finish_phrase_record();
);

hit(bx+bw+gap,by,bw,bh) ? (
  state==STATE_READY ? state=STATE_IDLE :
  state==STATE_RECORDING ? (
    panic_pending=1;
    clear_layer(record_layer);
    record_sample_pos=0;
    record_layer==0 ? (
      loop_len_samples=0;
      analysis_done=0;
    );
    state=loop_len_samples>0 ? STATE_STOPPED : STATE_IDLE;
  ) :
  state==STATE_PLAYING ? (
    panic_pending=1;
    play_sample_pos=0;
    overdub_armed=0;
    overdub_active=0;
    state=STATE_STOPPED;
  );
);

hit(bx+(bw+gap)*2,by,bw,bh) ? (
  panic_pending=1;
  reset_all_phrases();
);

gfx_set(0.82,0.82,0.82,1);
gfx_setfont(1,"Courier New",13,'b');
gfx_x=330; gfx_y=76;
state==STATE_IDLE ? gfx_drawstr("IDLE") :
state==STATE_READY ? (
  gfx_drawstr("READY L");
  gfx_drawnumber(record_layer+1,0);
  gfx_drawstr(" - waiting for first Note On");
) :
state==STATE_RECORDING ? gfx_drawstr("RECORDING MASTER LOOP") :
state==STATE_PLAYING ? (
  overdub_active ? gfx_drawstr("LOOPING + OVERDUB") :
  overdub_armed ? gfx_drawstr("LOOPING - OVERDUB ARMED") :
                  gfx_drawstr("LOOPING")
) :
state==STATE_STOPPED ? gfx_drawstr("STOPPED - loop stored");

// phrase browser: 6 compact rows per page
gfx_setfont(1,"Arial",16);
gfx_x=20; gfx_y=158; gfx_drawstr("PHRASES");

smallbtn(115,152,34,26,"<",0);
smallbtn(154,152,88,26,phrase_page==0 ? "P1-6" : phrase_page==1 ? "P7-12" : "P13-16",1);
smallbtn(247,152,34,26,">",0);
hit(115,152,34,26) ? phrase_page=max(0,phrase_page-1);
hit(247,152,34,26) ? phrase_page=min(PHRASE_PAGES-1,phrase_page+1);

gfx_set(.10,.10,.10,1);gfx_rect(16,182,605,236,1);
gfx_set(.39,.39,.39,1);gfx_rect(16,182,605,236,0);
rowy=190;
gui_row=0;
loop(PHRASES_PER_PAGE,
  gui_layer=phrase_page*PHRASES_PER_PAGE+gui_row;
  gui_layer<LAYERS ? (
    phrase_has_events=layer_count(gui_layer)>0;
    active_phrase=(state==STATE_READY || state==STATE_RECORDING) && record_layer==gui_layer;
    overdub_lit=overdub_layer==gui_layer && (overdub_armed || overdub_active);
    gfx_set(active_phrase ? .92 : overdub_lit ? .88 : phrase_has_events ? .47 : .19,
            active_phrase ? .18 : overdub_lit ? .42 : phrase_has_events ? .47 : .19,
            active_phrase ? .16 : overdub_lit ? .08 : phrase_has_events ? .47 : .19,1);
    gfx_circle(39,rowy+14,11,1);
    gfx_set(1,1,1,1);gfx_setfont(1,"Arial",12);
    gfx_x=gui_layer+1<10 ? 36 : 32;gfx_y=rowy+7;gfx_drawnumber(gui_layer+1,0);
    hit(26,rowy,26,28) ? (phrase_context=-1;select_phrase_record(gui_layer););
    (mouse_cap&2) && !(last_mouse_cap&2) && mouse_x>=26 && mouse_x<52 && mouse_y>=rowy && mouse_y<rowy+28 ? (
      phrase_context=gui_layer;phrase_context_y=rowy+30;
    );

    nx=56;nw=166;
    gfx_set(phrase_has_events ? .16 : .065,phrase_has_events ? .16 : .09,phrase_has_events ? .16 : .09,1);
    gfx_rect(nx,rowy,nw,28,1);
    gfx_set(phrase_has_events ? .30 : .11,phrase_has_events ? .30 : .17,phrase_has_events ? .30 : .17,1);
    gfx_rect(nx,rowy,nw,28,0);
    gfx_setfont(1,"Arial",11);
    phrase_has_events ? gfx_set(.86,.86,.86,1) : gfx_set(.26,.26,.26,1);
    name_len(PHRASE_NAME_BASE+gui_layer*NAME_CHARS)>0 ?
      draw_name_chars(PHRASE_NAME_BASE+gui_layer*NAME_CHARS,nx+9,rowy+7) : (
        gfx_x=nx+9;gfx_y=rowy+7;gfx_drawstr("PHRASE ");gfx_drawnumber(gui_layer+1,0);
      );
    hit(nx,rowy,nw,28) ? (edit_name_type=1;edit_name_index=gui_layer;);

    kx=226;mx=249;ui_sx=270;modex=294;trigx=336;
    phrase_icon(kx,rowy,20,28,0,phrase_note_learn==gui_layer);
    hit(kx,rowy,20,28) ? sw_learn_request=phrase_note_learn==gui_layer?-2:SW_COUNT+CONTROLLERS+gui_layer;
    phrase_has_events ? (
      gfx_set(mem[MUTE_BASE+gui_layer]>0.5 ? .95 : .82,.82,.82,1);
      gfx_setfont(1,"Arial",12);gfx_x=mx+4;gfx_y=rowy+7;gfx_drawstr("M");
      gfx_set(mem[SOLO_BASE+gui_layer]>0.5 ? .95 : .82,.82,.82,1);
      gfx_x=ui_sx+4;gfx_y=rowy+7;gfx_drawstr("S");
      gfx_set(.82,.82,.82,1);gfx_setfont(1,"Arial",12);
      gfx_x=modex;gfx_y=rowy+7;
      gfx_drawstr(mem[MODE_BASE+gui_layer]<.5 ? "LOOP" : mem[MODE_BASE+gui_layer]<1.5 ? "ONCE" : "HOLD");
      phrase_icon(trigx,rowy,22,28,6,0);
      hit(mx,rowy,19,28) ? mem[MUTE_BASE+gui_layer]=1-mem[MUTE_BASE+gui_layer];
      hit(ui_sx,rowy,19,28) ? mem[SOLO_BASE+gui_layer]=1-mem[SOLO_BASE+gui_layer];
      hit(modex,rowy,40,28) ? (
        selected_mode=(floor(mem[MODE_BASE+gui_layer]+.5)+1)%3;
        mem[MODE_BASE+gui_layer]=selected_mode;
        mem[TRIG_BASE+gui_layer]=selected_mode==0;
        mem[HOLD_ACTIVE_BASE+gui_layer]=0;
        mem[ONCEPOS_BASE+gui_layer]=0;panic_pending=1;
      );
      hit(trigx,rowy,22,28) ? (
        mem[MODE_BASE+gui_layer]<.5 ? (
          mem[ONCEPOS_BASE+gui_layer]=0;mem[TRIG_BASE+gui_layer]=1;
        ) : mem[MODE_BASE+gui_layer]<1.5 ? trigger_request=gui_layer :
        (mem[HOLD_ACTIVE_BASE+gui_layer]>.5 ? hold_stop_request=gui_layer : trigger_request=gui_layer);
      );
    );
    phrase_has_events ? (
      // Per-phrase velocity multiplier and repeat decay.
      vx=369;vw=64;vy=rowy+5;
      gfx_set(.23,.23,.23,1);gfx_rect(vx,vy,vw,17,1);
      vnorm=max(0,min(1,(mem[VEL_BASE+gui_layer]-.2)/2.8));
      gfx_set(.69,.69,.69,1);gfx_rect(vx,vy,vw*vnorm,17,1);
      mouse_cap&1 && mouse_x>=vx && mouse_x<vx+vw && mouse_y>=vy && mouse_y<vy+17 ?
        mem[VEL_BASE+gui_layer]=.2+2.8*((mouse_x-vx)/vw);
      gfx_setfont(1,"Arial",11);gfx_set(.77,.77,.77,1);
      gfx_x=438;gfx_y=rowy+6;gfx_drawstr("VEL x");gfx_drawnumber(mem[VEL_BASE+gui_layer],2);
      dx=498;dw=53;dy=rowy+5;
      gfx_set(.23,.23,.23,1);gfx_rect(dx,dy,dw,17,1);
      dnorm=max(0,min(1,(mem[DECAY_BASE+gui_layer]-.2)/.8));
      gfx_set(.69,.69,.69,1);gfx_rect(dx,dy,dw*dnorm,17,1);
      mouse_cap&1 && mouse_x>=dx && mouse_x<dx+dw && mouse_y>=dy && mouse_y<dy+17 ?
        mem[DECAY_BASE+gui_layer]=.2+.8*((mouse_x-dx)/dw);
      gfx_setfont(1,"Arial",11);gfx_set(.77,.77,.77,1);
      gfx_setfont(1,"Arial",9);gfx_x=556;gfx_y=rowy+2;gfx_drawstr("VEL DECAY");
      gfx_x=556;gfx_y=rowy+13;gfx_drawnumber(mem[DECAY_BASE+gui_layer]*100,0);gfx_drawstr("%");
      // Logarithmic bipolar rail: .5x ... 1x ... 2x, centered at unity.
      ui_td_x=369;ui_td_y=rowy+24;ui_td_w=65;ui_td_h=10;
      // GUI-only scratch; never call the DSP ratio evaluator from @gfx.
      ui_td_addr=SW_CFG_BASE+1+floor(gui_layer/4)*SW_STRIDE+112+gui_layer%4;
      ui_td_ratio=mem[ui_td_addr];ui_td_ratio=ui_td_ratio<=0?1:max(.5,min(2,ui_td_ratio));
      ui_td_norm=.5+.5*log(ui_td_ratio)/log(2);
      gfx_set(.23,.23,.23,1);gfx_rect(ui_td_x,ui_td_y,ui_td_w,ui_td_h,1);
      gfx_set(.69,.69,.69,1);gfx_rect(ui_td_x+min(.5,ui_td_norm)*(ui_td_w-1),ui_td_y,abs(ui_td_norm-.5)*(ui_td_w-1),ui_td_h,1);
      gfx_set(.85,.85,.85,1);gfx_line(ui_td_x+(ui_td_w-1)/2,ui_td_y,ui_td_x+(ui_td_w-1)/2,ui_td_y+ui_td_h);
      hit(ui_td_x,ui_td_y,ui_td_w,ui_td_h) ? (
        ui_td_now=time_precise();
        ui_td_last_phrase==gui_layer && ui_td_last_click>0 && ui_td_now-ui_td_last_click<.3 ? (
          mem[ui_td_addr]=ui_td_ratio=1;ui_td_reset_latch=1;ui_td_last_click=0;
        ) : (ui_td_last_phrase=gui_layer;ui_td_last_click=ui_td_now;);
      );
      !ui_td_reset_latch && mouse_cap&1 && mouse_x>=ui_td_x && mouse_x<ui_td_x+ui_td_w && mouse_y>=ui_td_y && mouse_y<ui_td_y+ui_td_h ?
        mem[ui_td_addr]=ui_td_ratio=pow(2,2*(mouse_x-ui_td_x)/(ui_td_w-1)-1);
      gfx_setfont(1,"Arial",10);gfx_x=438;gfx_y=rowy+23;gfx_drawstr("TIME DECAY ×");gfx_drawnumber(ui_td_ratio,2);
    );
    rowy+=38;
  );
  gui_row+=1;
);

// Contextual phrase CLEAR is intentionally separate from the record/overdub control.
phrase_context>=0 ? (
  gfx_set(.08,.08,.08,1);gfx_rect(26,phrase_context_y,112,30,1);
  gfx_set(.55,.55,.55,1);gfx_rect(9,phrase_context_y,112,30,0);
  gfx_setfont(1,"Arial",12);gfx_x=37;gfx_y=phrase_context_y+8;gfx_drawstr("CLEAR PHRASE");
  hit(26,phrase_context_y,112,30) ? (
    panic_pending=1;clear_layer(phrase_context);phrase_context=-1;
  );
  (mouse_cap&1) && !(last_mouse_cap&1) && !(mouse_x>=26 && mouse_x<138 && mouse_y>=phrase_context_y && mouse_y<phrase_context_y+30) ? phrase_context=-1;
);

function gui_exp_segment_t(t, bend)
local(p)
(
  t=max(0,min(1,t));
  bend=max(-0.98,min(0.98,bend));
  bend>0 ? (
    p=1+5*bend;
    pow(t,p);
  ) : bend<0 ? (
    p=1+5*(-bend);
    1-pow(1-t,p);
  ) : t;
);

function gui_exp_curve_value(ti, xpos)
local(cnt,ui_k,x0,y0,x1,y1,t,bend,res)
(
  cnt=max(2,min(EXP_POINTS,floor(mem[exp_count_addr(ti)]+0.5)));
  xpos=max(0,min(1,xpos));
  x0=mem[exp_x_addr(ti)];
  y0=mem[exp_y_addr(ti)];
  res=y0;
  ui_k=1;
  loop(cnt-1,
    x1=mem[exp_x_addr(ti)+ui_k];
    y1=mem[exp_y_addr(ti)+ui_k];
    xpos>=x1 ? res=y1 :
    xpos>=x0 && xpos<x1 ? (
      t=(xpos-x0)/max(0.000001,x1-x0);
      bend=mem[exp_bend_addr(ti)+ui_k-1];
      t=gui_exp_segment_t(t,bend);
      res=y0+(y1-y0)*t;
    );
    x0=x1; y0=y1;
    ui_k+=1;
  );
  xpos>=x0 ? res=y0;
  max(0,min(1,res));
);

// --- INSTRUMENTS -----------------------------------------------------------
// Curve preset helpers -------------------------------------------------------
function curve_clear_bends(ti)
local(ui_k)
(
  ui_k=0; loop(EXP_POINTS, mem[exp_bend_addr(ti)+ui_k]=0; ui_k+=1;);
);

function curve_factory(ti, preset)
local(ui_k)
(
  curve_clear_bends(ti);
  preset==0 ? ( // flat 50%
    mem[exp_count_addr(ti)]=2;
    mem[exp_x_addr(ti)]=0; mem[exp_y_addr(ti)]=0.5;
    mem[exp_x_addr(ti)+1]=1; mem[exp_y_addr(ti)+1]=0.5;
  ) :
  preset==1 ? ( // 0% first third, rise to 80% over second third, then plateau
    mem[exp_count_addr(ti)]=4;
    mem[exp_x_addr(ti)]=0;       mem[exp_y_addr(ti)]=0;
    mem[exp_x_addr(ti)+1]=1/3;  mem[exp_y_addr(ti)+1]=0;
    mem[exp_x_addr(ti)+2]=2/3;  mem[exp_y_addr(ti)+2]=0.8;
    mem[exp_x_addr(ti)+3]=1;     mem[exp_y_addr(ti)+3]=0.8;
  ) :
  preset==2 ? ( // inverse
    mem[exp_count_addr(ti)]=4;
    mem[exp_x_addr(ti)]=0;       mem[exp_y_addr(ti)]=0.8;
    mem[exp_x_addr(ti)+1]=1/3;  mem[exp_y_addr(ti)+1]=0.8;
    mem[exp_x_addr(ti)+2]=2/3;  mem[exp_y_addr(ti)+2]=0;
    mem[exp_x_addr(ti)+3]=1;     mem[exp_y_addr(ti)+3]=0;
  ) :
  preset==3 ? ( // rise
    mem[exp_count_addr(ti)]=2;
    mem[exp_x_addr(ti)]=0; mem[exp_y_addr(ti)]=0;
    mem[exp_x_addr(ti)+1]=1; mem[exp_y_addr(ti)+1]=1;
  ) : ( // fall
    mem[exp_count_addr(ti)]=2;
    mem[exp_x_addr(ti)]=0; mem[exp_y_addr(ti)]=1;
    mem[exp_x_addr(ti)+1]=1; mem[exp_y_addr(ti)+1]=0;
  );
  mem[param_last_addr(ti)]=-999;
);

function curve_custom_save(ti, slot)
local(ui_base,cnt,ui_k)
(
  ui_base=CUSTOM_PRESET_BASE+slot*CUSTOM_PRESET_STRIDE;
  cnt=max(2,min(EXP_POINTS,floor(mem[exp_count_addr(ti)]+0.5)));
  mem[ui_base]=cnt;
  ui_k=0; loop(EXP_POINTS,
    mem[ui_base+1+ui_k]=mem[exp_x_addr(ti)+ui_k];
    mem[ui_base+1+EXP_POINTS+ui_k]=mem[exp_y_addr(ti)+ui_k];
    mem[ui_base+1+EXP_POINTS*2+ui_k]=mem[exp_bend_addr(ti)+ui_k];
    ui_k+=1;
  );
);

function curve_custom_load(ti, slot)
local(ui_base,cnt,ui_k)
(
  ui_base=CUSTOM_PRESET_BASE+slot*CUSTOM_PRESET_STRIDE;
  cnt=floor(mem[ui_base]+0.5);
  cnt>=2 ? (
    mem[exp_count_addr(ti)]=min(EXP_POINTS,cnt);
    ui_k=0; loop(EXP_POINTS,
      mem[exp_x_addr(ti)+ui_k]=mem[ui_base+1+ui_k];
      mem[exp_y_addr(ti)+ui_k]=mem[ui_base+1+EXP_POINTS+ui_k];
      mem[exp_bend_addr(ti)+ui_k]=mem[ui_base+1+EXP_POINTS*2+ui_k];
      ui_k+=1;
    );
    mem[exp_x_addr(ti)]=0;
    mem[exp_x_addr(ti)+min(EXP_POINTS,cnt)-1]=1;
    mem[param_last_addr(ti)]=-999;
  );
);

// Tiny preset thumbnail. source_type 0=factory, 1=custom.
function draw_curve_preset_thumb(x,y,w,h,source_type,pidx)
local(ui_k,cnt,xx0,yy0,xx1,yy1,ui_base)
(
  gfx_set(0.16,0.16,0.16,1); gfx_rect(x,y,w,h,1);
  gfx_set(0.48,0.48,0.48,1); gfx_rect(x,y,w,h,0);
  source_type==0 ? (
    pidx==0 ? (gfx_line(x+2,y+h/2,x+w-2,y+h/2);) :
    pidx==1 ? (
      gfx_line(x+2,y+h-2,x+w/3,y+h-2); gfx_line(x+w/3,y+h-2,x+2*w/3,y+0.2*h);
      gfx_line(x+2*w/3,y+0.2*h,x+w-2,y+0.2*h);
    ) :
    pidx==2 ? (
      gfx_line(x+2,y+0.2*h,x+w/3,y+0.2*h); gfx_line(x+w/3,y+0.2*h,x+2*w/3,y+h-2);
      gfx_line(x+2*w/3,y+h-2,x+w-2,y+h-2);
    ) :
    pidx==3 ? gfx_line(x+2,y+h-2,x+w-2,y+2) :
              gfx_line(x+2,y+2,x+w-2,y+h-2);
  ) : (
    ui_base=CUSTOM_PRESET_BASE+pidx*CUSTOM_PRESET_STRIDE;
    cnt=max(0,min(EXP_POINTS,floor(mem[ui_base]+0.5)));
    cnt>=2 ? (
      ui_k=0;
      loop(cnt-1,
        xx0=x+2+(w-4)*mem[ui_base+1+ui_k];
        yy0=y+h-2-(h-4)*mem[ui_base+1+EXP_POINTS+ui_k];
        xx1=x+2+(w-4)*mem[ui_base+1+ui_k+1];
        yy1=y+h-2-(h-4)*mem[ui_base+1+EXP_POINTS+ui_k+1];
        gfx_line(xx0,yy0,xx1,yy1);
        ui_k+=1;
      );
    ) : (
      gfx_setfont(1,"Arial",7); gfx_x=x+3; gfx_y=y+2; gfx_drawstr("EMPTY");
    );
  );
);

// Read-only preview of this parameter's curve. All sampling scratch is GUI-local.
function draw_exp_badge(ti, x, y, w, h)
local(asg,sample,samples,pos,px,py,prevx,prevy)
(
  ti>=0 && ti<UI_PARAM_TOTAL ? (
    asg=floor(mem[exp_assign_addr(ti)]+.5);
    asg>=1 && asg<=CONTROLLERS ? (
      h==18 ? ( // Slider rails; keep the ARP enable button's badge compact.
        gfx_set(.03,.03,.03,.55);gfx_rect(x+1,y+1,w-2,h-2,1);
        // Sample the actual multipoint/bend curve at rail pixel resolution.
        samples=max(1,ceil(w-4));sample=0;
        prevx=x+2;prevy=y+h-2-(h-4)*gui_exp_curve_value(ti,0);
        gfx_set(.98,.94,.65,1);
        loop(samples,
          sample+=1;pos=sample/samples;
          px=x+2+(w-4)*pos;py=y+h-2-(h-4)*gui_exp_curve_value(ti,pos);
          gfx_line(prevx,prevy,px,py);prevx=px;prevy=py;
        );
      );
      gfx_set(.95,.85,.15,1);gfx_rect(x,y,w,h,0);
      gfx_rect(x+w-4,y+1,3,max(1,h-2),1);
    );
  );
);

function draw_note_name(note, x, y)
local(pc,oct)
(
  note=max(0,min(127,floor(note+0.5)));
  pc=note%12;
  oct=floor(note/12)-1;
  gfx_x=x; gfx_y=y;
  pc==0 ? gfx_drawstr("C") :
  pc==1 ? gfx_drawstr("C#") :
  pc==2 ? gfx_drawstr("D") :
  pc==3 ? gfx_drawstr("D#") :
  pc==4 ? gfx_drawstr("E") :
  pc==5 ? gfx_drawstr("F") :
  pc==6 ? gfx_drawstr("F#") :
  pc==7 ? gfx_drawstr("G") :
  pc==8 ? gfx_drawstr("G#") :
