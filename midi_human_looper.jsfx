function restore_current_patch_raw()
local(pb,j,valid)
(
  valid = current_patch==2 ? patch_valid2 : patch_valid1;
  valid ? (
    pb = current_patch==2 ? PATCH2_BASE : PATCH1_BASE;
    j=0;
    loop(WORK_MEM_SIZE,
      mem[j]=mem[pb+PATCH_HEADER_SIZE+j];
      j+=1;
    );
    param_bank_load(current_patch);
    loop_len_samples=mem[pb+0];
    analysis_done=mem[pb+1];
    slider4=mem[pb+2];
    slider5=mem[pb+3];
    slider6=mem[pb+4];
    slider7=mem[pb+5];
    slider8=mem[pb+6];
    slider9=mem[pb+7];
    record_layer=mem[pb+8];
    record_sample_pos=0;
    play_sample_pos=0;
    overdub_armed=0;
    overdub_active=0;
    overdub_pos=0;
    state = loop_len_samples>0 ? STATE_STOPPED : STATE_IDLE;
  );
);

function infer_tempo()
local(seconds,best_score,bars,bpm,score,target_bpm,i)
(
  loop_len_samples > 0 ? (
    seconds=loop_len_samples/srate;
    best_score=1000000000;
    target_bpm=120;
    i=1;
    loop(16,
      bars=i;
      bpm=(bars*4*60)/seconds;
      (bpm>=30 && bpm<=240) ? (
        score=abs(bpm-target_bpm);
        (bars==2 || bars==4 || bars==8) ? score-=0.75;
        score<best_score ? (
          best_score=score;
          slider6=bpm;
          slider7=bars;
        );
      );
      i+=1;
    );
    analysis_done=1;
  );
);

function finish_phrase_record()
local(phrase_len)
(
  state==STATE_RECORDING ? (
    phrase_len=max(1,record_sample_pos);
    mem[LEN_BASE+record_layer]=phrase_len;
    (record_layer==0 || loop_len_samples<=0) ? (
      loop_len_samples=phrase_len;
      infer_tempo();
    );
    play_sample_pos=0;
    state=STATE_STOPPED;
  ) : state==STATE_READY ? (
    state=loop_len_samples>0 ? STATE_STOPPED : STATE_IDLE;
  );
);

function select_phrase_record(layer)
(
  // A phrase change always disarms the previous overdub.
  (overdub_armed || overdub_active) && overdub_layer!=layer ? (
    overdub_armed=0;
    overdub_active=0;
    overdub_wait_note=0;
    overdub_pos=0;
  );

  (state==STATE_RECORDING || state==STATE_READY) ? (
    record_layer==layer ? (
      finish_phrase_record();
    ) : (
      finish_phrase_record();
      arm_layer(layer);
    );
  ) : (
    layer_count(layer)>0 ? (
      overdub_layer==layer && (overdub_active || overdub_armed) ? (
        overdub_active=0;
        overdub_armed=0;
        overdub_wait_note=0;
        overdub_pos=0;
      ) : (
        overdub_layer=layer;
        overdub_armed=1;
        overdub_active=0;
        overdub_pos=0;
        // ONCE/HOLD never arm against the global LOOP transport.
        overdub_wait_note=mem[MODE_BASE+layer]>=0.5;
        overdub_wait_note ? (
          play_sample_pos=0;
        ) : (
          state!=STATE_PLAYING && loop_len_samples>0 ? state=STATE_PLAYING;
        );
      );
    ) : arm_layer(layer);
  );
);

function send_all_notes_off()
local(ch,note)
(

  param_input_reset();
  ch=SW_PHRASE_OUT_BASE;loop(SW_MEMORY_END-SW_PHRASE_OUT_BASE,mem[ch]=0;ch+=1;);
  ch=0;
  loop(16,
    note=0;
    loop(128,
      midisend(0,128|ch,note,0);
      note+=1;
    );
    midisend(0,176|ch,64,0);
    ch+=1;
  );
);

function release_phrase_notes()
local(ch,note,key,mi,mn)
(

  param_release_owned();
  // Targeted choke for ONE SHOT voices only.
  // Release exactly the notes that our ownership table says are still sounding.
  ch=0;
  loop(16,
    note=0;
    loop(128,
      key=NOTE_REF_BASE + ch*128 + note;
      mem[key]>0 ? (
        midisend(0,128|ch,note,0);
        mi=0;loop(INSTRUMENTS,mem[SW_PHRASE_OUT_BASE+(mi*16+ch)*128+note]=0;mi+=1;);
        mem[key]=0;
      );
      note+=1;
    );
    mem[SUSTAIN_REF_BASE+ch]>0 ? (
      midisend(0,176|ch,64,0);
      mem[SUSTAIN_REF_BASE+ch]=0;
    );
    ch+=1;
  );
  // A phrase choke / HOLD stop also forgets mono source ownership.
  mi=0;
  loop(INSTRUMENTS,
    mem[MONO_ACTIVE_NOTE_BASE+mi]=-1;
    mn=0;
    loop(128,
      mem[MONO_HELD_COUNT_BASE+mi*128+mn]=0;
      mem[SW_MONO_PHRASE_BASE+mi*128+mn]=0;
      mem[MONO_HELD_VEL_BASE+mi*128+mn]=0;
      mem[MONO_ORDER_BASE+mi*128+mn]=0;
      mn+=1;
    );
    mi+=1;
  );
);

function any_solo()
local(li,res)
(
  res=0;
  li=0;
  loop(LAYERS,
    mem[SOLO_BASE+li] > 0.5 ? res=1;
    li+=1;
  );
  res;
);

function layer_audible(layer)
local(soloing)
(
  soloing=any_solo();
  soloing ? (mem[SOLO_BASE+layer] > 0.5) : (mem[MUTE_BASE+layer] < 0.5);
);

function quant_grid_samples()
local(beats_per_grid)
(
  // slider4: 0=1 bar,1=1/2,2=1/4,3=1/8,4=1/16,5=1/32
  // derive grid from detected BPM. If analysis is unavailable, return 0.
  analysis_done && slider6 > 0 ? (
    slider4==0 ? beats_per_grid=4 :
    slider4==1 ? beats_per_grid=2 :
    slider4==2 ? beats_per_grid=1 :
    slider4==3 ? beats_per_grid=0.5 :
    slider4==4 ? beats_per_grid=0.25 :
                 beats_per_grid=0.125;
    (60/slider6)*srate*beats_per_grid;
  ) : 0;
);

function quantize_ts(ts)
local(grid,q,target)
(
  slider5 <= 0 ? ts : (
    // same mapping as quant_grid_samples(), written inline to avoid hidden side effects
    analysis_done && slider6 > 0 ? (
      slider4==0 ? grid=(60/slider6)*srate*4 :
      slider4==1 ? grid=(60/slider6)*srate*2 :
      slider4==2 ? grid=(60/slider6)*srate :
      slider4==3 ? grid=(60/slider6)*srate*0.5 :
      slider4==4 ? grid=(60/slider6)*srate*0.25 :
                   grid=(60/slider6)*srate*0.125;
      grid > 0 ? (
        q=floor(ts/grid+0.5);
        target=q*grid;
        ts + (target-ts)*(slider5/100);
      ) : ts;
    ) : ts;
  );
);

function process_phrase_trigger(start_offset,play_only)
local(requested_layer,voice_slot,vi)
(
trigger_request>=0 ? (
  requested_layer=trigger_request;
  trigger_request=-1;
  !play_only && overdub_wait_note && overdub_armed && overdub_layer==requested_layer ? (
    // ONCE/HOLD: record from this trigger, not from the looping transport.
    overdub_wait_note=0;overdub_armed=0;overdub_active=1;
    overdub_pos=0;
  );

  requested_layer!=last_trigger_layer ? (
    last_trigger_layer>=0 ? (
      release_phrase_notes();
      arp_flush_nonhold_sources();
      vi=0;
      loop(MAX_ONCE_VOICES,
        mem[VOICE_ACTIVE_BASE+vi]=0;
        vi+=1;
      );
      mem[REPEAT_BASE+last_trigger_layer]=0;
      mem[HOLD_ACTIVE_BASE+last_trigger_layer]=0;
    );
    mem[REPEAT_BASE+requested_layer]=0;
    last_trigger_layer=requested_layer;
  ) : (
    mem[REPEAT_BASE+requested_layer]+=1;
  );

  // Find a free voice. If all are busy, recycle the oldest slot safely.
  voice_slot=-1;
  vi=0;
  loop(MAX_ONCE_VOICES,
    voice_slot<0 && mem[VOICE_ACTIVE_BASE+vi]<0.5 ? voice_slot=vi;
    vi+=1;
  );
  voice_slot<0 ? (
    release_phrase_notes();
    arp_flush_nonhold_sources();
    vi=0;
    loop(MAX_ONCE_VOICES,
      mem[VOICE_ACTIVE_BASE+vi]=0;
      vi+=1;
    );
    voice_slot=0;
  );

  mem[VOICE_ACTIVE_BASE+voice_slot]=1;
  mem[VOICE_LAYER_BASE+voice_slot]=requested_layer;
  mem[VOICE_POS_BASE+voice_slot]=-max(0,min(samplesblock-1,start_offset));
  mem[VOICE_TIME_BASE+voice_slot]=phrase_time_factor(requested_layer);
  mem[VOICE_GAIN_BASE+voice_slot]=pow(mem[DECAY_BASE+requested_layer],mem[REPEAT_BASE+requested_layer]);
  mem[MODE_BASE+requested_layer]>=1.5 ? mem[HOLD_ACTIVE_BASE+requested_layer]=1;
);

);


function sw_assign(si,kind,ch,num,press,release)
local(b,j,other,ok)
(
  b=sw_edit_cfg(si);ok=si>=0 && si<SW_COUNT && kind>=0 && kind<=2 && ch>=0 && ch<16 && num>=0 && num<128;
  kind==2 && (press==release || press<0 || press>127 || release<0 || release>127) ? ok=0;
  j=0;loop(SW_COUNT,
    other=sw_cfg(j);j!=si && kind>0 && mem[other]>0 && mem[other+2]==kind && mem[other+3]==ch && mem[other+4]==num ? ok=0;j+=1;
  );
  ok ? (mem[b+2]=kind;mem[b+3]=ch;mem[b+4]=num;mem[b+12]=press;mem[b+13]=release;mem[sw_rt(si)+17]=0;)
     : mem[sw_rt(si)+17]=1;
  ok;
);
function sw_submit(si,op,arg,value)
local(b,ok)
(
  ok=sw_queue_write-sw_queue_read<SW_QUEUE_SIZE;
  ok ? (
    b=SW_QUEUE_BASE+(sw_queue_write%SW_QUEUE_SIZE)*SW_QUEUE_STRIDE;
    mem[b]=si;mem[b+1]=op;mem[b+2]=arg;mem[b+3]=value;sw_queue_write+=1;
  );ok;
);
function sw_traverse(si)
local(b,r,n,step,k,j,tmp,last,choice,restart)
(
  b=sw_cfg(si);r=sw_rt(si);n=max(0,min(SW_STEPS,floor(mem[b+11])));step=-1;
  n>0 ? (
    restart=sw_last_active!=si && mem[b+10]>.5;restart ? sw_reset(si);
    sw_last_active=si;
    mem[b+9]==3 ? (
      mem[r+9]<=0 ? (
        k=0;loop(n,mem[sw_bag(si)+k]=k;k+=1;);
        k=n-1;loop(n-1,j=floor(rand(k+1));tmp=mem[sw_bag(si)+k];mem[sw_bag(si)+k]=mem[sw_bag(si)+j];mem[sw_bag(si)+j]=tmp;k-=1;);
        // Draw from the end. Avoid the same phrase at bag boundaries if possible.
        last=mem[r+10];choice=-1;k=0;
        mem[b+SW_LIST+mem[sw_bag(si)+n-1]]==last ? loop(n-1,
          mem[b+SW_LIST+mem[sw_bag(si)+k]]!=last && choice<0 ? choice=k;k+=1;
        );
        choice>=0 ? (tmp=mem[sw_bag(si)+n-1];mem[sw_bag(si)+n-1]=mem[sw_bag(si)+choice];mem[sw_bag(si)+choice]=tmp;);
        restart ? (
          k=0;choice=0;loop(n,mem[sw_bag(si)+k]==0?choice=k;k+=1;);
          tmp=mem[sw_bag(si)+n-1];mem[sw_bag(si)+n-1]=0;mem[sw_bag(si)+choice]=tmp;
        );
        mem[r+9]=n;
      );
      mem[r+9]-=1;step=mem[sw_bag(si)+mem[r+9]];
    ) : mem[b+9]==1 ? (step=restart?0:mem[r+6]<0?n-1:(mem[r+6]-1+n)%n;) : mem[b+9]==2 ? (
      mem[r+6]<0 ? step=0 : n==1 ? step=0 : (
        step=mem[r+6]+mem[r+8];step>=n?(mem[r+8]=-1;step=n-2;);step<0?(mem[r+8]=1;step=1;);
      );
    ) : step=(mem[r+6]+1)%n;
    mem[r+6]=step;mem[r+7]=step;mem[r+10]=mem[b+SW_LIST+step];
  );step;
);
function sw_stop_phrases()
local(gi,ch,n,key,live,mi,idx,remain,old,desired,mode,src)
(
  // Stop only playback-owned output. Live-through output remains untouched.
  gi=0;loop(INSTRUMENTS,
    n=0;loop(128,
      idx=MONO_HELD_COUNT_BASE+gi*128+n;
      mem[idx]=max(0,mem[idx]-mem[SW_MONO_PHRASE_BASE+gi*128+n]);mem[SW_MONO_PHRASE_BASE+gi*128+n]=0;
      src=mem[SW_ARP_PHRASE_BASE+gi*128+n];
      mem[ARP_HELD_COUNT_BASE+gi*128+n]=max(0,mem[ARP_HELD_COUNT_BASE+gi*128+n]-src);
      mem[ARP_SOURCE_COUNT_BASE+gi*128+n]=max(0,mem[ARP_SOURCE_COUNT_BASE+gi*128+n]-mem[SW_ARP_PHRASE_SOURCE_BASE+gi*128+n]);mem[SW_ARP_PHRASE_SOURCE_BASE+gi*128+n]=0;mem[SW_ARP_PHRASE_BASE+gi*128+n]=0;n+=1;
    );
