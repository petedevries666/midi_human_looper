desc:MIDI Human Looper v1.4.7

// Free-time MIDI phrase instrument prototype for REAPER JSFX.
// v1.4.7:
// - REAL recall fix: file_avail(0)<0 means WRITE, not fresh instance
// - @serialize
// REAPER: file_avail(0) < 0 = WRITE, >= 0 = READ.
writing = file_avail(0) < 0;

writing ? (
  // Saving the REAPER project should always capture the state currently on screen,
  // even if the user did not press our explicit PATCH SAVE button first.
  save_patch(current_patch);
);

file_var(0,patch_valid1);
file_var(0,patch_valid2);
file_var(0,current_patch);
file_mem(0,PATCH1_BASE,PATCH_DATA_SIZE*2);

!writing ? (
  // Important: @init may run AFTER @serialize. This flag tells @init not to
  // overwrite the state we have just restored.
  serialized_loaded=1;

  pb = current_patch==2 ? PATCH2_BASE : PATCH1_BASE;
  valid = current_patch==2 ? patch_valid2 : patch_valid1;
  valid ? (
    j=0;
    loop(WORK_MEM_SIZE,
      mem[j]=mem[pb+PATCH_HEADER_SIZE+j];
      j+=1;
    );
    loop_len_samples=mem[pb+0];
    analysis_done=mem[pb+1];
    slider4=mem[pb+2];
    slider5=mem[pb+3];
    slider6=mem[pb+4];
    slider7=mem[pb+5];
    slider8=mem[pb+6];
    slider9=mem[pb+7];
    record_layer=mem[pb+8];
    state=loop_len_samples>0 ? STATE_STOPPED : STATE_IDLE;
  );
);

@slider

readyplay_now=slider1;
abortstop_now=slider2;
clear_now=slider3;

(clear_now>0.5 && prev_clear<=0.5) ? (
  panic_pending=1;
  clear_all();
  slider1=0; slider2=0; slider3=0;
);

(readyplay_now>0.5 && prev_readyplay<=0.5) ? (
  loop_len_samples>0 && (state==STATE_STOPPED || state==STATE_IDLE) ? (
    play_sample_pos=0;
    state=STATE_PLAYING;
  ) :
  state==STATE_IDLE && loop_len_samples<=0 ? (
    clear_layer(0);
    record_layer=0;
    record_sample_pos=0;
    loop_len_samples=0;
    play_sample_pos=0;
    analysis_done=0;
    state=STATE_READY;
  ) :
  state==STATE_RECORDING ? (
    phrase_len=max(1,record_sample_pos);
    mem[LEN_BASE+record_layer]=phrase_len;
    (record_layer==0 || loop_len_samples<=0) ? (
      loop_len_samples=phrase_len;
      infer_tempo();
    );
    play_sample_pos=0;
    state=STATE_STOPPED;
  );
  slider1=0;
);

(abortstop_now>0.5 && prev_abortstop<=0.5) ? (
  state==STATE_READY ? (
    state=STATE_IDLE;
  ) :
  state==STATE_RECORDING ? (
    panic_pending=1;
    clear_layer(record_layer);
    record_sample_pos=0;
    loop_len_samples=0;
    analysis_done=0;
    state=STATE_IDLE;
  ) :
  state==STATE_PLAYING ? (
    panic_pending=1;
    play_sample_pos=0;
    overdub_armed=0;
    overdub_active=0;
    state=STATE_STOPPED;
  );
  slider2=0;
);

prev_readyplay=slider1;
prev_abortstop=slider2;
prev_clear=slider3;

@block

save_flash>0 ? save_flash-=samplesblock;
save_flash<0 ? save_flash=0;

panic_pending ? (
  send_all_notes_off();
  panic_pending=0;
);

// Process ONE SHOT trigger atomically in the audio thread.
// Same layer = add an overlapping voice. Different layer = soft choke previous phrase group.
trigger_request>=0 ? (
  requested_layer=trigger_request;
  trigger_request=-1;

  requested_layer!=last_trigger_layer ? (
    last_trigger_layer>=0 ? (
      release_phrase_notes();
      vi=0;
      loop(MAX_ONCE_VOICES,
        mem[VOICE_ACTIVE_BASE+vi]=0;
        vi+=1;
      );
      mem[REPEAT_BASE+last_trigger_layer]=0;
    );
    mem[REPEAT_BASE+requested_layer]=0;
    last_trigger_layer=requested_layer;
  ) : (
    mem[REPEAT_BASE+requested_layer]+=1;
  );

  // Find a free voice. If all are busy, recycle the oldest slot safely.
  voice_slot=-1;
  vi=0;
  loop(MAX_ONCE_VOICES,
    voice_slot<0 && mem[VOICE_ACTIVE_BASE+vi]<0.5 ? voice_slot=vi;
    vi+=1;
  );
  voice_slot<0 ? (
    release_phrase_notes();
    vi=0;
    loop(MAX_ONCE_VOICES,
      mem[VOICE_ACTIVE_BASE+vi]=0;
      vi+=1;
    );
    voice_slot=0;
  );

  mem[VOICE_ACTIVE_BASE+voice_slot]=1;
  mem[VOICE_LAYER_BASE+voice_slot]=requested_layer;
  mem[VOICE_POS_BASE+voice_slot]=0;
  mem[VOICE_GAIN_BASE+voice_slot]=pow(mem[DECAY_BASE+requested_layer],mem[REPEAT_BASE+requested_layer]);
);

while (
  midirecv(offset,msg1,msg23) ?
  (
    status=msg1&240;
    d1=msg23&127;
    d2=(msg23/256)&127;
    is_note_on=(status==144 && d2>0);

    state==STATE_READY && is_note_on ? (
      clear_layer(record_layer);
      state=STATE_RECORDING;
      record_sample_pos=0;
      store_event(record_layer,0,msg1,d1,d2,offset);
    ) :
    state==STATE_RECORDING ? (
      store_event(record_layer,record_sample_pos+offset,msg1,d1,d2,offset);
    ) :
    overdub_active ? (
      store_event(overdub_layer,overdub_pos+offset,msg1,d1,d2,offset);
    );

    // live MIDI passes through the same instrument router as phrase playback.
    send_to_instruments(offset,msg1,d1,d2,1);
    1;
  );
  0;
);

// arm -> active exactly at the next wrap
state==STATE_PLAYING && overdub_armed && !overdub_active ? (
  play_sample_pos==0 ? (
    clear_layer(overdub_layer);
    overdub_pos=0;
    overdub_active=1;
    overdub_armed=0;
  );
);

// playback LOOP layers
state==STATE_PLAYING && loop_len_samples>0 ? (
  block_remaining=samplesblock;
  block_cursor=0;

  while(block_remaining>0) (
    segment=min(block_remaining,loop_len_samples-play_sample_pos);

    layer=0;
    loop(LAYERS,
      layer_audible(layer) && mem[MODE_BASE+layer]<0.5 ? (
        count=layer_count(layer);
        i=0;
        loop(count,
          base=layer_base(layer,i);
          evt_t=mem[base];
          evt_q=quantize_ts(evt_t);
          evt_q>=loop_len_samples ? evt_q-=loop_len_samples;
          evt_q<0 ? evt_q+=loop_len_samples;

          evt_q>=play_sample_pos && evt_q<play_sample_pos+segment ? (
            out_offs=block_cursor+(evt_q-play_sample_pos);

            slider8==0 ? (
              out_status=mem[base+1]&255;
            ) : (
              out_chan=max(1,min(16,slider8))-1;
              out_status=(mem[base+1]&240)|out_chan;
            );

            out_d1=mem[base+2]&127;
            out_d2=mem[base+3]&127;

            ((out_status&240)==144 && out_d2>0) ? (
              velmul=slider9*mem[VEL_BASE+layer];
              out_d2=floor(out_d2*velmul+0.5);
              out_d2=max(1,min(127,out_d2));
            );

            // out_d2 already includes phrase/global velocity; instrument velocity is applied in router.
            send_to_instruments(out_offs,out_status,out_d1,out_d2,1);
          );

          i+=1;
        );
      );
      layer+=1;
    );

    play_sample_pos+=segment;
    block_cursor+=segment;
    block_remaining-=segment;

    play_sample_pos>=loop_len_samples ? (
      play_sample_pos=0;

      overdub_active ? (
        mem[LEN_BASE+overdub_layer]=loop_len_samples;
        overdub_active=0;
        overdub_pos=0;
      ) :
      overdub_armed ? (
        clear_layer(overdub_layer);
        overdub_pos=0;
        overdub_active=1;
        overdub_armed=0;
      );
    );
  );
);



// polyphonic ONE SHOT voice pool
vi=0;
loop(MAX_ONCE_VOICES,
  mem[VOICE_ACTIVE_BASE+vi]>0.5 ? (
    once_layer=mem[VOICE_LAYER_BASE+vi];
    once_start=mem[VOICE_POS_BASE+vi];
    once_end=once_start+samplesblock;
    phrase_end=max(1,mem[LEN_BASE+once_layer]);
    count=layer_count(once_layer);
    i=0;
    loop(count,
      base=layer_base(once_layer,i);
      evt_t=mem[base];
      evt_t>=once_start && evt_t<once_end && evt_t<phrase_end ? (
        out_offs=evt_t-once_start;
        slider8==0 ? out_status=mem[base+1]&255 : (
          out_chan=max(1,min(16,slider8))-1;
          out_status=(mem[base+1]&240)|out_chan;
        );
        out_d1=mem[base+2]&127;
        out_d2=mem[base+3]&127;
        velmul=slider9*mem[VEL_BASE+once_layer]*mem[VOICE_GAIN_BASE+vi];
        send_once_to_instruments(out_offs,out_status,out_d1,out_d2,velmul);
      );
      i+=1;
    );
    mem[VOICE_POS_BASE+vi]=once_end;
    mem[VOICE_POS_BASE+vi]>=phrase_end ? (
      mem[VOICE_ACTIVE_BASE+vi]=0;
      mem[VOICE_POS_BASE+vi]=0;
      // Do not global-release here: another overlapping voice of the same phrase may still be sounding.
    );
  );
  vi+=1;
);

state==STATE_RECORDING ? record_sample_pos+=samplesblock;
overdub_active ? (
  overdub_pos+=samplesblock;
  overdub_pos>=loop_len_samples ? overdub_pos=loop_len_samples-1;
);

@gfx 900 720

function hit(hx,hy,hw,hh)
local(res)
(
  res = mouse_cap&1 && !(last_mouse_cap&1) &&
        mouse_x>=hx && mouse_x<hx+hw &&
        mouse_y>=hy && mouse_y<hy+hh;
  res;
);

function button(bx_,by_,bw_,bh_,blabel,bactive)
local(tw,th)
(
  bactive ? gfx_set(0.38,0.38,0.38,1) : gfx_set(0.18,0.18,0.18,1);
  gfx_rect(bx_,by_,bw_,bh_,1);
  gfx_set(0.8,0.8,0.8,1);
  gfx_rect(bx_,by_,bw_,bh_,0);
  gfx_setfont(1,"Arial",15);
  gfx_measurestr(blabel,tw,th);
  gfx_x=bx_+(bw_-tw)/2;
  gfx_y=by_+(bh_-th)/2;
  gfx_drawstr(blabel);
);

function smallbtn(sx_,sy_,sw_,sh_,slabel,sactive)
local(tw,th)
(
  sactive ? gfx_set(0.45,0.45,0.45,1) : gfx_set(0.16,0.16,0.16,1);
  gfx_rect(sx_,sy_,sw_,sh_,1);
  gfx_set(0.75,0.75,0.75,1);
  gfx_rect(sx_,sy_,sw_,sh_,0);
  gfx_setfont(1,"Arial",12);
  gfx_measurestr(slabel,tw,th);
  gfx_x=sx_+(sw_-tw)/2;
  gfx_y=sy_+(sh_-th)/2;
  gfx_drawstr(slabel);
);

bx=20; by=18; bw=160; bh=44; gap=12;

rp_label="READY";
state==STATE_RECORDING ? rp_label="PLAY";
loop_len_samples>0 && state==STATE_STOPPED ? rp_label="PLAY";
button(bx,by,bw,bh,rp_label,state==STATE_READY || state==STATE_RECORDING || state==STATE_PLAYING);

as_label="ABORT";
state==STATE_PLAYING || state==STATE_STOPPED ? as_label="STOP";
button(bx+bw+gap,by,bw,bh,as_label,state==STATE_STOPPED);

button(bx+(bw+gap)*2,by,110,bh,"CLEAR ALL",0);

// two persistent patch slots
py=76;
smallbtn(20,py,70,30,"PATCH 1",current_patch==1);
smallbtn(96,py,52,30,"SAVE",0);
smallbtn(170,py,70,30,"PATCH 2",current_patch==2);
smallbtn(246,py,52,30,"SAVE",0);

hit(20,py,70,30) ? load_patch(1);
hit(96,py,52,30) ? save_patch(1);
hit(170,py,70,30) ? load_patch(2);
hit(246,py,52,30) ? save_patch(2);

save_flash>0 ? (
  gfx_set(0.82,0.82,0.82,1);
  gfx_setfont(1,"Arial",13);
  gfx_x=310; gfx_y=84;
  gfx_drawstr("PATCH ");
  gfx_drawnumber(save_flash_patch,0);
  gfx_drawstr(" SAVED");
);

hit(bx,by,bw,bh) ? (
  loop_len_samples>0 && (state==STATE_STOPPED || state==STATE_IDLE) ? (
    play_sample_pos=0;
    state=STATE_PLAYING;
  ) :
  state==STATE_IDLE && loop_len_samples<=0 ? (
    clear_layer(0);
    record_layer=0;
    record_sample_pos=0;
    play_sample_pos=0;
    analysis_done=0;
    state=STATE_READY;
  ) :
  state==STATE_RECORDING ? (
    phrase_len=max(1,record_sample_pos);
    mem[LEN_BASE+record_layer]=phrase_len;
    (record_layer==0 || loop_len_samples<=0) ? (
      loop_len_samples=phrase_len;
      infer_tempo();
    );
    play_sample_pos=0;
    state=STATE_STOPPED;
  );
);

hit(bx+bw+gap,by,bw,bh) ? (
  state==STATE_READY ? state=STATE_IDLE :
  state==STATE_RECORDING ? (
    panic_pending=1;
    clear_layer(record_layer);
    record_sample_pos=0;
    record_layer==0 ? (
      loop_len_samples=0;
      analysis_done=0;
    );
    state=loop_len_samples>0 ? STATE_STOPPED : STATE_IDLE;
  ) :
  state==STATE_PLAYING ? (
    panic_pending=1;
    play_sample_pos=0;
    overdub_armed=0;
    overdub_active=0;
    state=STATE_STOPPED;
  );
);

hit(bx+(bw+gap)*2,by,110,bh) ? (
  panic_pending=1;
  clear_all();
);

gfx_set(0.82,0.82,0.82,1);
gfx_setfont(1,"Arial",21);
gfx_x=330; gfx_y=82;
state==STATE_IDLE ? gfx_drawstr("IDLE") :
state==STATE_READY ? (
  gfx_drawstr("READY L");
  gfx_drawnumber(record_layer+1,0);
  gfx_drawstr(" - waiting for first Note On");
) :
state==STATE_RECORDING ? gfx_drawstr("RECORDING MASTER LOOP") :
state==STATE_PLAYING ? (
  overdub_active ? gfx_drawstr("LOOPING + OVERDUB") :
  overdub_armed ? gfx_drawstr("LOOPING - OVERDUB ARMED") :
                  gfx_drawstr("LOOPING")
) :
state==STATE_STOPPED ? gfx_drawstr("STOPPED - loop stored");

// phrase browser: 6 compact rows per page
gfx_setfont(1,"Arial",16);
gfx_x=20; gfx_y=126; gfx_drawstr("PHRASES");

smallbtn(115,120,34,26,"<",0);
smallbtn(154,120,88,26,phrase_page==0 ? "P1-6" : phrase_page==1 ? "P7-12" : "P13-16",1);
smallbtn(247,120,34,26,">",0);
hit(115,120,34,26) ? phrase_page=max(0,phrase_page-1);
hit(247,120,34,26) ? phrase_page=min(PHRASE_PAGES-1,phrase_page+1);

rowy=152;
gui_row=0;
loop(PHRASES_PER_PAGE,
  gui_layer=phrase_page*PHRASES_PER_PAGE+gui_row;
  gui_layer<LAYERS ? (
  (state==STATE_READY && record_layer==gui_layer) ? gfx_set(1,0.18,0.12,1) : gfx_set(0.78,0.78,0.78,1);
  gfx_setfont(1,"Arial",15);
  gfx_x=20; gfx_y=rowy+9;
  gfx_drawstr("P");
  gfx_drawnumber(gui_layer+1,0);

  hit(16,rowy,40,28) ? arm_layer(gui_layer);

  mx=65; sx=112; ox=159; cx=252; modex=318; trigx=400;
  smallbtn(mx,rowy,38,28,"M",mem[MUTE_BASE+gui_layer]>0.5);
  smallbtn(sx,rowy,38,28,"S",mem[SOLO_BASE+gui_layer]>0.5);
  smallbtn(ox,rowy,82,28,"OVR",overdub_armed && overdub_layer==gui_layer || overdub_active && overdub_layer==gui_layer);
  smallbtn(cx,rowy,58,28,"CLR",0);
  smallbtn(modex,rowy,72,28,mem[MODE_BASE+gui_layer]<0.5 ? "LOOP" : "ONCE",mem[MODE_BASE+gui_layer]>=0.5);
  voice_lit=0; vi=0; loop(MAX_ONCE_VOICES, mem[VOICE_ACTIVE_BASE+vi]>0.5 && mem[VOICE_LAYER_BASE+vi]==gui_layer ? voice_lit=1; vi+=1;);
  smallbtn(trigx,rowy,62,28,"TRIG",voice_lit);

  hit(mx,rowy,38,28) ? mem[MUTE_BASE+gui_layer]=1-mem[MUTE_BASE+gui_layer];
  hit(sx,rowy,38,28) ? mem[SOLO_BASE+gui_layer]=1-mem[SOLO_BASE+gui_layer];

  hit(ox,rowy,82,28) && state==STATE_PLAYING ? (
    overdub_active && overdub_layer==gui_layer ? (
      overdub_active=0;
      overdub_pos=0;
    ) : (
      overdub_layer=gui_layer;
      overdub_armed=1;
      overdub_active=0;
    );
  );

  hit(cx,rowy,58,28) ? (
    panic_pending=1;
    clear_layer(gui_layer);
  );

  hit(modex,rowy,72,28) ? (
    mem[MODE_BASE+gui_layer]=1-mem[MODE_BASE+gui_layer];
    mem[TRIG_BASE+gui_layer]=0;
    mem[ONCEPOS_BASE+gui_layer]=0;
    panic_pending=1;
  );

  hit(trigx,rowy,62,28) && mem[MODE_BASE+gui_layer]>=0.5 && layer_count(gui_layer)>0 ? (
    // Queue only. @block performs kill + restart atomically before playback.
    trigger_request=gui_layer;
  );

  // velocity mini slider
  vx=475; vw=82; vy=rowy+2;
  gfx_set(0.22,0.22,0.22,1); gfx_rect(vx,vy,vw,18,1);
  vnorm=(mem[VEL_BASE+gui_layer]-0.2)/2.8;
  vnorm=max(0,min(1,vnorm));
  gfx_set(0.7,0.7,0.7,1); gfx_rect(vx,vy,vw*vnorm,18,1);
  mouse_cap&1 && mouse_x>=vx && mouse_x<vx+vw && mouse_y>=vy && mouse_y<vy+18 ? (
    mem[VEL_BASE+gui_layer]=0.2+2.8*((mouse_x-vx)/vw);
  );
  gfx_setfont(1,"Arial",13);
  gfx_x=563; gfx_y=rowy+2;
  gfx_drawstr("x");
  gfx_drawnumber(mem[VEL_BASE+gui_layer],2);

  // retrigger velocity decay: 0.20..1.00, displayed as percent
  dx=475; dw=82; dy=rowy+20;
  gfx_set(0.22,0.22,0.22,1); gfx_rect(dx,dy,dw,9,1);
  dnorm=(mem[DECAY_BASE+gui_layer]-0.2)/0.8;
  dnorm=max(0,min(1,dnorm));
  gfx_set(0.7,0.7,0.7,1); gfx_rect(dx,dy,dw*dnorm,9,1);
  mouse_cap&1 && mouse_x>=dx && mouse_x<dx+dw && mouse_y>=dy-3 && mouse_y<dy+13 ? (
    mem[DECAY_BASE+gui_layer]=0.2+0.8*((mouse_x-dx)/dw);
  );
  gfx_setfont(1,"Arial",10);
  gfx_x=563; gfx_y=rowy+20;
  gfx_drawstr("D ");
  gfx_drawnumber(mem[DECAY_BASE+gui_layer]*100,0);
  gfx_drawstr("%");

  gfx_x=675; gfx_y=rowy+2;
  gfx_drawstr("ev ");
  gfx_drawnumber(layer_count(gui_layer),0);

    rowy+=38;
  );
  gui_row+=1;
);

// --- INSTRUMENTS -----------------------------------------------------------
// Explicit per-row renderer: gi is a function parameter/local, so I1/I2/I3 cannot alias.
function draw_instrument_row(gi, iy)
local(ivx,ivw,ivn,ilx,ilw,imx,imw)
(
  gfx_setfont(1,"Arial",13);
  gfx_x=20; gfx_y=iy+7; gfx_drawstr("I"); gfx_drawnumber(gi+1,0);

  smallbtn(52,iy,42,28,mem[INST_ENABLED_BASE+gi]>0.5 ? "ON" : "OFF",mem[INST_ENABLED_BASE+gi]>0.5);
  hit(52,iy,42,28) ? mem[INST_ENABLED_BASE+gi]=1-mem[INST_ENABLED_BASE+gi];

  smallbtn(105,iy,54,28,mem[INST_IN_BASE+gi]==0 ? "ALL" : "CH",0);
  hit(105,iy,54,28) ? mem[INST_IN_BASE+gi]=(mem[INST_IN_BASE+gi]+1)%17;
  gfx_x=164; gfx_y=iy+7; gfx_drawnumber(mem[INST_IN_BASE+gi],0);

  smallbtn(190,iy,54,28,mem[INST_OUT_BASE+gi]==0 ? "ORIG" : "OUT",0);
  hit(190,iy,54,28) ? mem[INST_OUT_BASE+gi]=(mem[INST_OUT_BASE+gi]+1)%17;
  gfx_x=249; gfx_y=iy+7; gfx_drawnumber(mem[INST_OUT_BASE+gi],0);

  ivx=285; ivw=100;
  gfx_set(0.22,0.22,0.22,1); gfx_rect(ivx,iy+5,ivw,16,1);
  ivn=(mem[INST_VEL_BASE+gi]-0.2)/2.8; ivn=max(0,min(1,ivn));
  gfx_set(0.7,0.7,0.7,1); gfx_rect(ivx,iy+5,ivw*ivn,16,1);
  mouse_cap&1 && mouse_x>=ivx && mouse_x<ivx+ivw && mouse_y>=iy+2 && mouse_y<iy+25 ? mem[INST_VEL_BASE+gi]=0.2+2.8*((mouse_x-ivx)/ivw);
  gfx_x=392; gfx_y=iy+7; gfx_drawstr("x"); gfx_drawnumber(mem[INST_VEL_BASE+gi],2);

  ilx=455; ilw=100;
  gfx_set(0.22,0.22,0.22,1); gfx_rect(ilx,iy+5,ilw,16,1);
  gfx_set(0.7,0.7,0.7,1); gfx_rect(ilx,iy+5,ilw*(mem[INST_LEVEL_BASE+gi]/127),16,1);
  mouse_cap&1 && mouse_x>=ilx && mouse_x<ilx+ilw && mouse_y>=iy+2 && mouse_y<iy+25 ? (
    mem[INST_LEVEL_BASE+gi]=floor(127*((mouse_x-ilx)/ilw)+0.5);
    send_instrument_cc(gi,11,mem[INST_LEVEL_BASE+gi]);
  );
  gfx_x=562; gfx_y=iy+7; gfx_drawnumber(mem[INST_LEVEL_BASE+gi],0);

  imx=610; imw=100;
  gfx_set(0.22,0.22,0.22,1); gfx_rect(imx,iy+5,imw,16,1);
  gfx_set(0.7,0.7,0.7,1); gfx_rect(imx,iy+5,imw*(mem[INST_MOD_BASE+gi]/127),16,1);
  mouse_cap&1 && mouse_x>=imx && mouse_x<imx+imw && mouse_y>=iy+2 && mouse_y<iy+25 ? (
    mem[INST_MOD_BASE+gi]=floor(127*((mouse_x-imx)/imw)+0.5);
    send_instrument_cc(gi,1,mem[INST_MOD_BASE+gi]);
  );
  gfx_x=717; gfx_y=iy+7; gfx_drawnumber(mem[INST_MOD_BASE+gi],0);
);

inst_y=152 + PHRASES_PER_PAGE*38 + 16;
gfx_setfont(1,"Arial",16);
gfx_x=20; gfx_y=inst_y; gfx_drawstr("INSTRUMENTS   IN -> OUT   VEL    LEVEL(CC11)   MOD(CC1)");
inst_y+=28;
draw_instrument_row(0,inst_y);
draw_instrument_row(1,inst_y+34);
draw_instrument_row(2,inst_y+68);
inst_y+=102;

// Mouse-test expression strips. Slider10/11 are also automatable REAPER parameters.
exp_y=inst_y+18;
gfx_setfont(1,"Arial",16); gfx_x=20; gfx_y=exp_y; gfx_drawstr("EXPRESSION TEST");
exp_y+=28;
gfx_setfont(1,"Arial",13);
gfx_x=20; gfx_y=exp_y+4; gfx_drawstr("EXP A");
ex=90; ew=300;
gfx_set(0.22,0.22,0.22,1); gfx_rect(ex,exp_y,ew,20,1);
gfx_set(0.7,0.7,0.7,1); gfx_rect(ex,exp_y,ew*slider10,20,1);
mouse_cap&1 && mouse_x>=ex && mouse_x<ex+ew && mouse_y>=exp_y-3 && mouse_y<exp_y+23 ? (slider10=max(0,min(1,(mouse_x-ex)/ew)); sliderchange(slider10); send_expression_ccs(););
gfx_x=400; gfx_y=exp_y+4; gfx_drawnumber(slider10*100,0); gfx_drawstr("%   -> instrument LEVEL / CC11");

exp_y+=32;
gfx_x=20; gfx_y=exp_y+4; gfx_drawstr("EXP B");
gfx_set(0.22,0.22,0.22,1); gfx_rect(ex,exp_y,ew,20,1);
gfx_set(0.7,0.7,0.7,1); gfx_rect(ex,exp_y,ew*slider11,20,1);
mouse_cap&1 && mouse_x>=ex && mouse_x<ex+ew && mouse_y>=exp_y-3 && mouse_y<exp_y+23 ? (slider11=max(0,min(1,(mouse_x-ex)/ew)); sliderchange(slider11); send_expression_ccs(););
gfx_x=400; gfx_y=exp_y+4; gfx_drawnumber(slider11*100,0); gfx_drawstr("%   -> instrument MOD / CC1");

last_mouse_cap=mouse_cap;
