    old>=0 && desired==old ? mem[SW_LIVE_OUT_BASE+(gi*16+mem[MONO_ACTIVE_CH_BASE+gi])*128+old]=max(1,mem[SW_LIVE_OUT_BASE+(gi*16+mem[MONO_ACTIVE_CH_BASE+gi])*128+old]);
