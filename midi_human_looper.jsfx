  );
);

function tf_linear(ti)
local(j)
(mem[exp_assign_addr(ti)]=0;mem[exp_count_addr(ti)]=2;j=0;loop(EXP_POINTS,
 mem[exp_x_addr(ti)+j]=(j==1);mem[exp_y_addr(ti)+j]=(j==1);mem[exp_bend_addr(ti)+j]=0;j+=1;);
 mem[param_last_addr(ti)]=-999;mem[param_pending_addr(ti)]=-999;);
