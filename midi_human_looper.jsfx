 si=sw_edit_target;si>=0?(
  b=SW_DRAFT_BASE;conflict=-1;j=0;loop(SW_COUNT+CONTROLLERS+LAYERS,
   j!=si && mem[b+2]>0 && learn_matches(j,mem[b+2],mem[b+3],mem[b+4])?conflict=j;j+=1;);
  conflict<0 || mem[b+23]>0 ? (
