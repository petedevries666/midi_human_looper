desc:MIDI Human Looper v1.26.0
options:gmem=MIDI_HUMAN_LOOPER

// Release history: CHANGELOG.md. Free-time MIDI phrase instrument.

// Native REAPER sliders intentionally hidden.
// Keep these legacy engine/control values internal until they receive proper custom-UI controls.
slider1=0; slider2=0; slider3=0;
slider4=0; slider5=0;
slider6=120; slider7=4;
slider8=0; slider9=1;
slider10=0; slider11=0;

@init

STATE_IDLE = 0;
STATE_READY = 1;
STATE_RECORDING = 2;
STATE_PLAYING = 3;
STATE_STOPPED = 4;

// External patch I/O bridge (companion Lua ReaScript).
// gmem[0] command: 0 idle, 1 SAVE request, 2 LOAD request, 3 LOAD ready, 4 SAVE done, 5 error.
// gmem[1] selected slot, [2] schema, [3] PATCH_PAYLOAD_SIZE, [4..] globals, payload starts at 32.
IO_SCHEMA = 6;
TF_SCHEMA=5;
CC_SCHEMA=4;
SW_SCHEMA=3;
PARAM_SCHEMA=2;
IO_PAYLOAD_BASE = 32;

MAX_ONCE_VOICES = 12;

state = STATE_IDLE;

LAYERS = 16;
// 2048 events/phrase keeps 16 phrases + two serialized patch banks comfortably below JSFX memory ceiling.
MAX_EVENTS_PER_LAYER = 2048;
EV_SIZE = 5;
LAYER_STRIDE = MAX_EVENTS_PER_LAYER * EV_SIZE;

// per-layer arrays live after event memory
COUNT_BASE = LAYERS * LAYER_STRIDE;
MUTE_BASE = COUNT_BASE + LAYERS;
SOLO_BASE = MUTE_BASE + LAYERS;
VEL_BASE = SOLO_BASE + LAYERS;
MODE_BASE = VEL_BASE + LAYERS;
TRIG_BASE = MODE_BASE + LAYERS;
ONCEPOS_BASE = TRIG_BASE + LAYERS;
LEN_BASE = ONCEPOS_BASE + LAYERS;
DECAY_BASE = LEN_BASE + LAYERS;
REPEAT_BASE = DECAY_BASE + LAYERS;

// INSTRUMENT routing table. 8 lightweight MIDI destinations.
// IN: 0=ALL, 1..16 source channel. OUT: 0=ORIGINAL, 1..16 destination channel.
// LEVEL and MOD are CC values (defaults CC11 Expression and CC1 Mod Wheel).
INSTRUMENTS = 3;
INST_IN_BASE = REPEAT_BASE + LAYERS;
INST_OUT_BASE = INST_IN_BASE + INSTRUMENTS;
INST_VEL_BASE = INST_OUT_BASE + INSTRUMENTS;
INST_LEVEL_BASE = INST_VEL_BASE + INSTRUMENTS;
INST_MOD_BASE = INST_LEVEL_BASE + INSTRUMENTS;
INST_ENABLED_BASE = INST_MOD_BASE + INSTRUMENTS;
INST_LEVEL_CC_BASE = INST_ENABLED_BASE + INSTRUMENTS;
INST_ARP_ENABLED_BASE = INST_LEVEL_CC_BASE + INSTRUMENTS;
INST_ARP_RATE_BASE = INST_ARP_ENABLED_BASE + INSTRUMENTS;
INST_ARP_GATE_BASE = INST_ARP_RATE_BASE + INSTRUMENTS;
INST_ARP_HOLD_BASE = INST_ARP_GATE_BASE + INSTRUMENTS;
INST_ARP_MODE_BASE = INST_ARP_HOLD_BASE + INSTRUMENTS;

// Generic expression targets. Each instrument/target pair owns assignment + curve.
EXP_T_VEL=0; EXP_T_LEVEL=1; EXP_T_MOD=2; EXP_T_ARP_ON=3;
EXP_T_ARP_MODE=4; EXP_T_ARP_RATE=5; EXP_T_ARP_GATE=6;
EXP_TARGETS=7;
EXP_POINTS=6;
EXP_TOTAL=INSTRUMENTS*EXP_TARGETS;
INST_EXP_ASSIGN_BASE = INST_ARP_MODE_BASE + INSTRUMENTS;
INST_EXP_COUNT_BASE = INST_EXP_ASSIGN_BASE + EXP_TOTAL;
INST_EXP_X_BASE = INST_EXP_COUNT_BASE + EXP_TOTAL;
INST_EXP_Y_BASE = INST_EXP_X_BASE + EXP_TOTAL*EXP_POINTS;
// One signed curvature value per possible segment slot. 0=linear, -1..+1 bends the segment.
INST_EXP_BEND_BASE = INST_EXP_Y_BASE + EXP_TOTAL*EXP_POINTS;
CUSTOM_PRESETS=4;
CUSTOM_PRESET_STRIDE=1+EXP_POINTS*3; // count + X + Y + bend
CUSTOM_PRESET_BASE = INST_EXP_BEND_BASE + EXP_TOTAL*EXP_POINTS;
NAME_CHARS=16;
PHRASE_NAME_BASE = CUSTOM_PRESET_BASE + CUSTOM_PRESETS*CUSTOM_PRESET_STRIDE;
INSTR_NAME_BASE = PHRASE_NAME_BASE + LAYERS*NAME_CHARS;
INST_NOTE_MODE_BASE = INSTR_NAME_BASE + INSTRUMENTS*NAME_CHARS; // 0 POLY, 1 BASS, 2 LAST, 3 LEGATO
INST_RANGE_MODE_BASE = INST_NOTE_MODE_BASE + INSTRUMENTS; // 0 FULL, 1 DOWN, 2 UP, 3 BOTH
INST_RANGE_LOW_BASE = INST_RANGE_MODE_BASE + INSTRUMENTS;
INST_RANGE_HIGH_BASE = INST_RANGE_LOW_BASE + INSTRUMENTS;
INST_TRANSPOSE_BASE = INST_RANGE_HIGH_BASE + INSTRUMENTS; // -48..+48 semitones
TRANSFORM_TYPES=6; // 1 transpose, 2 range, 3 polyphony, 4 velocity, 5 arp, 6 cc/mod
TRANSFORM_SLOTS=6;
INST_TRANSFORM_COUNT_BASE = INST_TRANSPOSE_BASE + INSTRUMENTS;
INST_TRANSFORM_TYPE_BASE = INST_TRANSFORM_COUNT_BASE + INSTRUMENTS;
CONTROLLERS=4;
CONTROLLER_CC_BASE = INST_TRANSFORM_TYPE_BASE + INSTRUMENTS*TRANSFORM_SLOTS;
PHRASE_NOTE_BASE = CONTROLLER_CC_BASE + CONTROLLERS;
WORK_MEM_SIZE = PHRASE_NOTE_BASE + LAYERS;
PATCH_HEADER_SIZE = 12;
PATCH_DATA_SIZE = PATCH_HEADER_SIZE + WORK_MEM_SIZE;
PATCH1_BASE = WORK_MEM_SIZE + 64;
PATCH2_BASE = PATCH1_BASE + PATCH_DATA_SIZE;

// Runtime ONE SHOT voices must not overlap the large serialized patch banks.
VOICE_ACTIVE_BASE = PATCH2_BASE + PATCH_DATA_SIZE + 64;
VOICE_LAYER_BASE = VOICE_ACTIVE_BASE + MAX_ONCE_VOICES;
VOICE_POS_BASE = VOICE_LAYER_BASE + MAX_ONCE_VOICES;
VOICE_GAIN_BASE = VOICE_POS_BASE + MAX_ONCE_VOICES;

// Runtime ownership counters for overlapping ONE SHOT MIDI voices.
// MIDI has no voice ID: multiple Note Ons for the same channel/note share one Note Off.
// We therefore emit the physical Note Off only when the last logical owner releases it.
NOTE_REF_BASE = VOICE_GAIN_BASE + MAX_ONCE_VOICES;
NOTE_REF_SIZE = 16 * 128;
SUSTAIN_REF_BASE = NOTE_REF_BASE + NOTE_REF_SIZE;
CC_DIRTY_BASE = SUSTAIN_REF_BASE + 16;
CC_DIRTY_MOD_BASE = CC_DIRTY_BASE + INSTRUMENTS;

// Runtime POST-ARP state. Not serialized: only the ARP settings above are patch data.
ARP_HELD_COUNT_BASE = CC_DIRTY_MOD_BASE + INSTRUMENTS;
ARP_HELD_VEL_BASE = ARP_HELD_COUNT_BASE + INSTRUMENTS*128;
ARP_ACTIVE_NOTE_BASE = ARP_HELD_VEL_BASE + INSTRUMENTS*128;
ARP_ACTIVE_CH_BASE = ARP_ACTIVE_NOTE_BASE + INSTRUMENTS;
ARP_STEP_REMAIN_BASE = ARP_ACTIVE_CH_BASE + INSTRUMENTS;
ARP_GATE_REMAIN_BASE = ARP_STEP_REMAIN_BASE + INSTRUMENTS;
ARP_SOURCE_COUNT_BASE = ARP_GATE_REMAIN_BASE + INSTRUMENTS;
EXP_LAST_VALUE_BASE = ARP_SOURCE_COUNT_BASE + INSTRUMENTS*128;
ARP_CURSOR_BASE = EXP_LAST_VALUE_BASE + EXP_TOTAL;
HOLD_ACTIVE_BASE = ARP_CURSOR_BASE + INSTRUMENTS; // LAYERS runtime slots
MONO_HELD_COUNT_BASE = HOLD_ACTIVE_BASE + LAYERS;
MONO_HELD_VEL_BASE = MONO_HELD_COUNT_BASE + INSTRUMENTS*128;
MONO_ORDER_BASE = MONO_HELD_VEL_BASE + INSTRUMENTS*128;
MONO_ACTIVE_NOTE_BASE = MONO_ORDER_BASE + INSTRUMENTS*128;
MONO_ACTIVE_CH_BASE = MONO_ACTIVE_NOTE_BASE + INSTRUMENTS;
// Stable parameter kinds: old seven kinds and their memory offsets are frozen.
PARAM_TRANSPOSE=7; PARAM_RANGE_MODE=8; PARAM_RANGE_LOW=9; PARAM_RANGE_HIGH=10;
PARAM_NOTE_MODE=11; PARAM_ARP_HOLD=12; PARAM_MOD_CC=13;
PARAM_TARGETS=14; PARAM_EXTRA=INSTRUMENTS*(PARAM_TARGETS-EXP_TARGETS);
PARAM_TOTAL=EXP_TOTAL+PARAM_EXTRA;
// Extension lives AFTER all legacy runtime/bank allocations. JSON concatenates
// the frozen working prefix and this extension; banks keep their old addresses.
PARAM_EXT_BASE=MONO_ACTIVE_CH_BASE+INSTRUMENTS;
PARAM_ASSIGN_BASE=PARAM_EXT_BASE+1;
PARAM_COUNT_BASE=PARAM_ASSIGN_BASE+PARAM_EXTRA;
PARAM_X_BASE=PARAM_COUNT_BASE+PARAM_EXTRA;
PARAM_Y_BASE=PARAM_X_BASE+PARAM_EXTRA*EXP_POINTS;
PARAM_BEND_BASE=PARAM_Y_BASE+PARAM_EXTRA*EXP_POINTS;
PARAM_MOD_CC_BASE=PARAM_BEND_BASE+PARAM_EXTRA*EXP_POINTS;
PARAM_EXT_SIZE=PARAM_MOD_CC_BASE+INSTRUMENTS-PARAM_EXT_BASE;
PATCH_PAYLOAD_SIZE=WORK_MEM_SIZE+PARAM_EXT_SIZE;
PARAM_BANK1_BASE=PARAM_EXT_BASE+PARAM_EXT_SIZE;
PARAM_BANK2_BASE=PARAM_BANK1_BASE+PARAM_EXT_SIZE;
PARAM_LAST_BASE=PARAM_BANK2_BASE+PARAM_EXT_SIZE;
PARAM_PENDING_BASE=PARAM_LAST_BASE+PARAM_TOTAL;
// Counts include rejected notes: changing a filter cannot invent a later Note Off.
PARAM_INPUT_BASE=PARAM_PENDING_BASE+PARAM_TOTAL;
PARAM_INPUT_SIZE=2*INSTRUMENTS*16*128;
PARAM_ACTIVE_BASE=PARAM_INPUT_BASE+PARAM_INPUT_SIZE;
PARAM_MOD_CC_LAST_BASE=PARAM_ACTIVE_BASE+INSTRUMENTS;
PARAM_MOD_ON_LAST_BASE=PARAM_MOD_CC_LAST_BASE+INSTRUMENTS;
// Smart Switch configuration is a separate appended wire tail. Old RAM is frozen.
SW_COUNT=4;SW_STEPS=64;SW_STRIDE=128;SW_NAME=32;SW_LIST=48;
// Per-switch fields: enabled/type/kind/channel/number/thru/policy/doubleMs/holdMs,
// traversal/reentry/length/ccPress/ccRelease, three actions, three targets.
// Name is 16 chars at +32; up to 64 zero-based phrase references begin at +48.
// Runtime +0..5: press and gesture state; +6..10: cursor/active/direction/bag/last.
// +11..12: action feedback; +13..19: held-input snapshot, errors and undo flag.
SW_CFG_BASE=PARAM_MOD_ON_LAST_BASE+INSTRUMENTS;
SW_CFG_SIZE=1+SW_COUNT*SW_STRIDE;
SW_BANK1_BASE=SW_CFG_BASE+SW_CFG_SIZE;SW_BANK2_BASE=SW_BANK1_BASE+SW_CFG_SIZE;
SW_RT_BASE=SW_BANK2_BASE+SW_CFG_SIZE;SW_RT_STRIDE=32;
SW_BAG_BASE=SW_RT_BASE+SW_COUNT*SW_RT_STRIDE;
SW_UNDO_BASE=SW_BAG_BASE+SW_COUNT*SW_STEPS;
SW_QUEUE_BASE=SW_UNDO_BASE+SW_COUNT*SW_STRIDE;
SW_QUEUE_SIZE=64;SW_QUEUE_STRIDE=4;
SW_RELEASE_BASE=SW_QUEUE_BASE+SW_QUEUE_SIZE*SW_QUEUE_STRIDE;
SW_RELEASE_SIZE=16;
SW_MODULE_BASE=SW_RELEASE_BASE+SW_RELEASE_SIZE*4;
SW_LEARN_RELEASE_DEADLINE_BASE=SW_MODULE_BASE+INSTRUMENTS*TRANSFORM_TYPES;
SW_PHRASE_OUT_BASE=SW_LEARN_RELEASE_DEADLINE_BASE+SW_RELEASE_SIZE;
SW_LIVE_OUT_BASE=SW_PHRASE_OUT_BASE+INSTRUMENTS*16*128;
SW_LOOP_INPUT_BASE=SW_LIVE_OUT_BASE+INSTRUMENTS*16*128;
SW_MONO_PHRASE_BASE=SW_LOOP_INPUT_BASE+INSTRUMENTS*16*128;
SW_ARP_PHRASE_BASE=SW_MONO_PHRASE_BASE+INSTRUMENTS*128;
SW_ARP_PHRASE_SOURCE_BASE=SW_ARP_PHRASE_BASE+INSTRUMENTS*128;
SW_PHRASE_SUSTAIN_BASE=SW_ARP_PHRASE_SOURCE_BASE+INSTRUMENTS*128;
SW_LIVE_SUSTAIN_BASE=SW_PHRASE_SUSTAIN_BASE+16;
SW_MONO_OWNER_BASE=SW_LIVE_SUSTAIN_BASE+16;
SW_MEMORY_END=SW_MONO_OWNER_BASE+INSTRUMENTS;
// Voice factors are separate from output ownership tables cleared by note release.
VOICE_TIME_BASE=SW_MEMORY_END;
SW_LEGACY_PAYLOAD=WORK_MEM_SIZE+PARAM_EXT_SIZE;
CC_LEGACY_PAYLOAD=SW_LEGACY_PAYLOAD+SW_CFG_SIZE;
// Additional CC generators: stable slot identity survives visual reordering.
// The frozen legacy configuration, banks and runtime retain every address.
CC_EXTRA=INSTRUMENTS*(TRANSFORM_SLOTS-1);CC_STRIDE=4+2*(2+3*EXP_POINTS);
CC_CFG_BASE=VOICE_TIME_BASE+MAX_ONCE_VOICES;
CC_CFG_SIZE=2+INSTRUMENTS+CC_EXTRA*CC_STRIDE;
CC_BANK1_BASE=CC_CFG_BASE+CC_CFG_SIZE;CC_BANK2_BASE=CC_BANK1_BASE+CC_CFG_SIZE;
CC_RT_BASE=CC_BANK2_BASE+CC_CFG_SIZE;CC_RT_STRIDE=8;
CC_PARAM_LAST_BASE=CC_RT_BASE+(CC_EXTRA+INSTRUMENTS)*CC_RT_STRIDE;
CC_PARAM_PENDING_BASE=CC_PARAM_LAST_BASE+CC_EXTRA*2;
TF_TERTIARY_TI=PARAM_TOTAL+CC_EXTRA*2;
TF_LEGACY_PAYLOAD=CC_LEGACY_PAYLOAD+CC_CFG_SIZE;
TF_CFG_BASE=CC_PARAM_PENDING_BASE+CC_EXTRA*2;TF_PRIMARY_IDS=TF_CFG_BASE+1;
TF_RECORD_BASE=TF_PRIMARY_IDS+INSTRUMENTS*TRANSFORM_TYPES;TF_STRIDE=1+2+3*EXP_POINTS;
TF_CFG_SIZE=1+INSTRUMENTS*TRANSFORM_TYPES+CC_EXTRA*TF_STRIDE;
TF_BANK1_BASE=TF_CFG_BASE+TF_CFG_SIZE;TF_BANK2_BASE=TF_BANK1_BASE+TF_CFG_SIZE;
TF_LAST_BASE=TF_BANK2_BASE+TF_CFG_SIZE;TF_PENDING_BASE=TF_LAST_BASE+CC_EXTRA;
TF_QUEUE_BASE=TF_PENDING_BASE+CC_EXTRA;TF_QUEUE_SIZE=32;TF_QUEUE_STRIDE=4;
UI_PARAM_TOTAL=TF_TERTIARY_TI+CC_EXTRA;
DS_LEGACY_PAYLOAD=TF_LEGACY_PAYLOAD+TF_CFG_SIZE;
DS_CFG_BASE=TF_QUEUE_BASE+TF_QUEUE_SIZE*TF_QUEUE_STRIDE;DS_CFG_SIZE=2+12*SW_STRIDE;
DS_BANK1_BASE=DS_CFG_BASE+DS_CFG_SIZE;DS_BANK2_BASE=DS_BANK1_BASE+DS_CFG_SIZE;
DS_RT_BASE=DS_BANK2_BASE+DS_CFG_SIZE;DS_BAG_BASE=DS_RT_BASE+12*SW_RT_STRIDE;
DS_UNDO_BASE=DS_BAG_BASE+12*SW_STEPS;
SW_DRAFT_BASE=DS_UNDO_BASE+12*SW_STRIDE;SW_DRAFT_UNDO_BASE=SW_DRAFT_BASE+SW_STRIDE;
// Runtime quarantine grows with the actual engine collection, not GUI cards.
SW_RELEASE_BASE=SW_DRAFT_UNDO_BASE+SW_STRIDE;SW_RELEASE_SIZE=32;
SW_LEARN_RELEASE_DEADLINE_BASE=SW_RELEASE_BASE+SW_RELEASE_SIZE*4;
SW_COUNT=16;
PATCH_PAYLOAD_SIZE=DS_LEGACY_PAYLOAD+DS_CFG_SIZE;
// Actions: NONE/NEXT/STOP/RESET/RESET ALL/STOP+RESET/PANIC/TOGGLE/ENABLE/DISABLE.
SW_NONE=0;SW_NEXT=1;SW_STOP=2;SW_RESET=3;SW_RESET_ALL=4;SW_STOP_RESET=5;
SW_PANIC=6;SW_TOGGLE=7;SW_ENABLE=8;SW_DISABLE=9;
// patch_valid1 / patch_valid2 / current_patch are serialized state.
// Do NOT clear them here: REAPER may call @init after @serialize.
(patch_valid1<=0 && patch_valid2<=0 && (current_patch<1 || current_patch>2)) ? current_patch=1;
save_flash = 0;
save_flash_patch = 0;
restore_request = 0;
restore_flash = 0;
io_status = 0;
last_trigger_layer = -1;
trigger_request = -1;
hold_stop_request = -1;
mono_order_counter = 0;
phrase_page = 0;
phrase_note_learn=-1;
phrase_context=-1;
phrase_context_y=0;
PHRASES_PER_PAGE = 6;
PHRASE_PAGES = 3;
vi=0;
loop(MAX_ONCE_VOICES,
  mem[VOICE_ACTIVE_BASE+vi]=0;
  mem[VOICE_LAYER_BASE+vi]=0;
  mem[VOICE_POS_BASE+vi]=0;
  mem[VOICE_GAIN_BASE+vi]=1;
  vi+=1;
);
ri=0;
loop(NOTE_REF_SIZE,
  mem[NOTE_REF_BASE+ri]=0;
  ri+=1;
);
ri=0;
loop(16,
  mem[SUSTAIN_REF_BASE+ri]=0;
  ri+=1;
);
ii=0;
loop(INSTRUMENTS,
  mem[CC_DIRTY_BASE+ii]=0;
  mem[CC_DIRTY_MOD_BASE+ii]=0;
  mem[ARP_ACTIVE_NOTE_BASE+ii]=-1;
  mem[ARP_ACTIVE_CH_BASE+ii]=0;
  mem[ARP_STEP_REMAIN_BASE+ii]=0;
  mem[ARP_GATE_REMAIN_BASE+ii]=0;
  et=0; loop(EXP_TARGETS, mem[EXP_LAST_VALUE_BASE+ii*EXP_TARGETS+et]=-1; et+=1;);
  mem[ARP_CURSOR_BASE+ii]=-1;
  nn=0;
  loop(128,
    mem[ARP_HELD_COUNT_BASE+ii*128+nn]=0;
    mem[ARP_HELD_VEL_BASE+ii*128+nn]=0;
    mem[ARP_SOURCE_COUNT_BASE+ii*128+nn]=0;
    nn+=1;
  );
  ii+=1;
);

i=0;
loop(LAYERS,
  mem[COUNT_BASE+i]=0;
  mem[MUTE_BASE+i]=0;
  mem[SOLO_BASE+i]=0;
  mem[VEL_BASE+i]=1;
  mem[MODE_BASE+i]=1; // 0 LOOP, 1 ONCE, 2 HOLD
  mem[TRIG_BASE+i]=0;
  mem[HOLD_ACTIVE_BASE+i]=0;
  mem[ONCEPOS_BASE+i]=0;
  mem[LEN_BASE+i]=0;
  mem[DECAY_BASE+i]=0.8;
  mem[REPEAT_BASE+i]=0;
  mem[PHRASE_NOTE_BASE+i]=-1;
  i+=1;
);

// Instrument 1 enabled by default as transparent ALL -> ORIGINAL route.
// Others are available but disabled until configured.
ii=0;
loop(INSTRUMENTS,
  mem[INST_IN_BASE+ii]=0;
  mem[INST_OUT_BASE+ii]=0;
  mem[INST_VEL_BASE+ii]=1;
  mem[INST_LEVEL_BASE+ii]=127;
  mem[INST_MOD_BASE+ii]=0;
  mem[INST_ENABLED_BASE+ii]=(ii==0);
  mem[INST_LEVEL_CC_BASE+ii]=7;
  mem[INST_ARP_ENABLED_BASE+ii]=0;
  mem[INST_ARP_RATE_BASE+ii]=4;   // x BPM: 4 = 16th notes
  mem[INST_ARP_GATE_BASE+ii]=0.5;
  mem[INST_ARP_HOLD_BASE+ii]=0;
  mem[INST_ARP_MODE_BASE+ii]=0;
  mem[INST_NOTE_MODE_BASE+ii]=0;
  mem[INST_RANGE_MODE_BASE+ii]=0;
  mem[INST_RANGE_LOW_BASE+ii]=0;
  mem[INST_RANGE_HIGH_BASE+ii]=127;
  mem[INST_TRANSPOSE_BASE+ii]=0;
  mem[INST_TRANSFORM_COUNT_BASE+ii]=0;
  ts=0; loop(TRANSFORM_SLOTS, mem[INST_TRANSFORM_TYPE_BASE+ii*TRANSFORM_SLOTS+ts]=0; ts+=1;);
  mem[MONO_ACTIVE_NOTE_BASE+ii]=-1;
  mem[MONO_ACTIVE_CH_BASE+ii]=0;
  nn=0;
  loop(128,
    mem[MONO_HELD_COUNT_BASE+ii*128+nn]=0;
    mem[MONO_HELD_VEL_BASE+ii*128+nn]=0;
    mem[MONO_ORDER_BASE+ii*128+nn]=0;
    nn+=1;
  );
  et=0;
  loop(EXP_TARGETS,
    eti=ii*EXP_TARGETS+et;
    mem[INST_EXP_ASSIGN_BASE+eti]=0;
    mem[INST_EXP_COUNT_BASE+eti]=2;
    mem[INST_EXP_X_BASE+eti*EXP_POINTS+0]=0;
    mem[INST_EXP_Y_BASE+eti*EXP_POINTS+0]=0;
    mem[INST_EXP_X_BASE+eti*EXP_POINTS+1]=1;
    mem[INST_EXP_Y_BASE+eti*EXP_POINTS+1]=1;
    ep=2;
    loop(EXP_POINTS-2,
      mem[INST_EXP_X_BASE+eti*EXP_POINTS+ep]=0;
      mem[INST_EXP_Y_BASE+eti*EXP_POINTS+ep]=0;
      ep+=1;
    );
    ep=0;
    loop(EXP_POINTS,
      mem[INST_EXP_BEND_BASE+eti*EXP_POINTS+ep]=0;
      ep+=1;
    );
    et+=1;
  );
  ii+=1;
);
ci=0;loop(CONTROLLERS,mem[CONTROLLER_CC_BASE+ci]=-1;ci+=1;);
ctrl_val0=slider10;ctrl_val1=slider11;ctrl_val2=0;ctrl_val3=0;controller_learn=-1;
// Custom preset slots start empty. They become part of external JSON patch data.
cp=0;
loop(CUSTOM_PRESETS,
  mem[CUSTOM_PRESET_BASE+cp*CUSTOM_PRESET_STRIDE]=0;
  cp+=1;
);

record_sample_pos = 0;
loop_len_samples = 0;
play_sample_pos = 0;
analysis_done = 0;
panic_pending = 0;

record_layer = 0;
overdub_armed = 0;
overdub_active = 0;
overdub_layer = 1;
overdub_pos = 0;
overdub_wait_note=0;

prev_readyplay=0;
prev_abortstop=0;
prev_clear=0;

// If REAPER loaded @serialize BEFORE @init, @init has just reset working RAM.
// Rehydrate the saved bank now. If @serialize runs after @init, @serialize itself hydrates it.
(patch_valid1>0 || patch_valid2>0) ? restore_after_init=1;

function layer_count(layer)
local(addr)
(
  addr = COUNT_BASE + layer;
  mem[addr];
);

function set_layer_count(layer,count)
local(addr)
(
  addr = COUNT_BASE + layer;
  mem[addr] = count;
);

function layer_base(layer, idx)
local(addr)
(
  addr = layer * LAYER_STRIDE + idx * EV_SIZE;
  addr;
);

// Reserved schema-3 fields +112..115 hold four phrase timing ratios per record.
function phrase_time_addr(layer)
(SW_CFG_BASE+1+floor(layer/4)*SW_STRIDE+112+layer%4;);
function phrase_time_ratio(layer)
local(r)
(r=mem[phrase_time_addr(layer)];r<=0?1:max(.5,min(2,r)););
function phrase_time_factor(layer)
local(exponent)
(
  // Bound the exponent before pow(), including very long retrigger sessions.
  exponent=max(-log(64),min(log(64),log(phrase_time_ratio(layer))*mem[REPEAT_BASE+layer]));
  exp(exponent);
);
function clear_layer(layer)
(
  set_layer_count(layer,0);
  mem[MUTE_BASE+layer]=0;
  mem[SOLO_BASE+layer]=0;
  mem[VEL_BASE+layer]=1;
  mem[TRIG_BASE+layer]=0;
  mem[HOLD_ACTIVE_BASE+layer]=0;
  mem[ONCEPOS_BASE+layer]=0;
  mem[LEN_BASE+layer]=0;
  mem[REPEAT_BASE+layer]=0;
);

function reset_all_phrases()
local(i)
(
  i=0;
  loop(LAYERS,
    clear_layer(i);
    i+=1;
  );
  record_sample_pos=0;
  loop_len_samples=0;
  play_sample_pos=0;
  analysis_done=0;
  overdub_armed=0;
  overdub_active=0;
  overdub_pos=0;
  record_layer=0;
  state=STATE_IDLE;
  slider6=120;
  slider7=4;
);

function cc_cfg(index) (CC_CFG_BASE+2+INSTRUMENTS+index*CC_STRIDE;);
function cc_index(gi,code) (gi*(TRANSFORM_SLOTS-1)+code-7;);
function cc_id(gi,code) (code==6?mem[CC_CFG_BASE+2+gi]:mem[cc_cfg(cc_index(gi,code))];);
function cc_ti(index,row) (row==2?TF_TERTIARY_TI+index:PARAM_TOTAL+index*2+row;);
function extra_index(ti) (ti>=TF_TERTIARY_TI?ti-TF_TERTIARY_TI:floor((ti-PARAM_TOTAL)/2););
function extra_row(ti) (ti>=TF_TERTIARY_TI?2:(ti-PARAM_TOTAL)%2;);
function tf_record(index) (TF_RECORD_BASE+index*TF_STRIDE;);
function transform_type(gi,code) (code<7?code:mem[tf_record(cc_index(gi,code))];);
function tf_id(gi,code) (code<6?mem[TF_PRIMARY_IDS+gi*TRANSFORM_TYPES+code-1]:cc_id(gi,code););
function cc_curve(ti) (ti>=TF_TERTIARY_TI?tf_record(extra_index(ti))+1:cc_cfg(extra_index(ti))+4+extra_row(ti)*(2+3*EXP_POINTS););
function param_last_addr(ti) (ti>=TF_TERTIARY_TI?TF_LAST_BASE+extra_index(ti):ti<PARAM_TOTAL?PARAM_LAST_BASE+ti:CC_PARAM_LAST_BASE+ti-PARAM_TOTAL;);
function param_pending_addr(ti) (ti>=TF_TERTIARY_TI?TF_PENDING_BASE+extra_index(ti):ti<PARAM_TOTAL?PARAM_PENDING_BASE+ti:CC_PARAM_PENDING_BASE+ti-PARAM_TOTAL;);
function cc_defaults()
local(j,b,k,row,a)
(
  mem[CC_CFG_BASE]=CC_SCHEMA;mem[CC_CFG_BASE+1]=INSTRUMENTS+1;j=0;
  loop(INSTRUMENTS,mem[CC_CFG_BASE+2+j]=j+1;j+=1;);j=0;
  loop(CC_EXTRA,b=cc_cfg(j);k=0;loop(CC_STRIDE,mem[b+k]=0;k+=1;);
    mem[b+1]=1;row=0;loop(2,a=b+4+row*(2+3*EXP_POINTS);mem[a+1]=2;
      mem[a+2+1]=1;mem[a+2+EXP_POINTS+1]=1;row+=1;);j+=1;
  );
);
function cc_runtime_reset()
local(j)
(j=0;loop((CC_EXTRA+INSTRUMENTS)*CC_RT_STRIDE,mem[CC_RT_BASE+j]=-999;j+=1;);
 j=0;loop(CC_EXTRA*2,mem[CC_PARAM_LAST_BASE+j]=-999;mem[CC_PARAM_PENDING_BASE+j]=-999;j+=1;););
function cc_bank_save(slot)
local(b,j,pb)
(b=slot==2?CC_BANK2_BASE:CC_BANK1_BASE;pb=slot==2?PATCH2_BASE:PATCH1_BASE;
 mem[pb+11]=CC_SCHEMA;j=0;loop(CC_CFG_SIZE,mem[b+j]=mem[CC_CFG_BASE+j];j+=1;););
function cc_bank_load(slot)
local(b,j,pb)
(pb=slot==2?PATCH2_BASE:PATCH1_BASE;cc_defaults();mem[pb+11]==CC_SCHEMA?(
 b=slot==2?CC_BANK2_BASE:CC_BANK1_BASE;j=0;loop(CC_CFG_SIZE,mem[CC_CFG_BASE+j]=mem[b+j];j+=1;););cc_runtime_reset(););
cc_defaults();cc_runtime_reset();

function tf_defaults()
local(j,b,k)
(mem[TF_CFG_BASE]=TF_SCHEMA;j=0;loop(INSTRUMENTS*TRANSFORM_TYPES,mem[TF_PRIMARY_IDS+j]=-j-1;j+=1;);
 j=0;loop(CC_EXTRA,b=tf_record(j);k=0;loop(TF_STRIDE,mem[b+k]=0;k+=1;);mem[b]=6;
 mem[b+2]=2;mem[b+4]=1;mem[b+4+EXP_POINTS]=1;j+=1;););
function tf_runtime_reset()
local(j)
(j=0;loop(CC_EXTRA,mem[TF_LAST_BASE+j]=-999;mem[TF_PENDING_BASE+j]=-999;j+=1;);tf_queue_read=0;ui_tf_queue_write=0;);
function tf_bank_save(slot)
local(j,b)
(b=slot==2?TF_BANK2_BASE:TF_BANK1_BASE;j=0;loop(TF_CFG_SIZE,mem[b+j]=mem[TF_CFG_BASE+j];j+=1;););
function tf_bank_load(slot)
local(j,b)
(b=slot==2?TF_BANK2_BASE:TF_BANK1_BASE;tf_defaults();mem[b]==TF_SCHEMA?(
 j=0;loop(TF_CFG_SIZE,mem[TF_CFG_BASE+j]=mem[b+j];j+=1;););tf_runtime_reset(););
tf_defaults();tf_runtime_reset();

function param_ti(gi,kind)
(
  gi>=0 && gi<INSTRUMENTS && gi==floor(gi) && kind>=0 && kind<PARAM_TARGETS && kind==floor(kind) ?
    (kind<EXP_TARGETS ? gi*EXP_TARGETS+kind : EXP_TOTAL+gi*(PARAM_TARGETS-EXP_TARGETS)+kind-EXP_TARGETS) : -1;
);
function param_gi(ti)
(
  ti>=PARAM_TOTAL ? floor(extra_index(ti)/(TRANSFORM_SLOTS-1)) : ti<EXP_TOTAL ? floor(ti/EXP_TARGETS) : floor((ti-EXP_TOTAL)/(PARAM_TARGETS-EXP_TARGETS));
);
function param_kind(ti)
(
  ti>=PARAM_TOTAL ? (mem[tf_record(extra_index(ti))]==1?PARAM_TRANSPOSE:mem[tf_record(extra_index(ti))]==2?PARAM_RANGE_MODE+extra_row(ti):mem[tf_record(extra_index(ti))]==4?EXP_T_VEL:extra_row(ti)==0?EXP_T_MOD:PARAM_MOD_CC) : ti<EXP_TOTAL ? ti%EXP_TARGETS : EXP_TARGETS+(ti-EXP_TOTAL)%(PARAM_TARGETS-EXP_TARGETS);
);
function exp_assign_addr(ti) (ti>=PARAM_TOTAL ? cc_curve(ti)+0 : ti<EXP_TOTAL ? INST_EXP_ASSIGN_BASE+ti : PARAM_ASSIGN_BASE+ti-EXP_TOTAL;);
function exp_count_addr(ti) (ti>=PARAM_TOTAL ? cc_curve(ti)+1 : ti<EXP_TOTAL ? INST_EXP_COUNT_BASE+ti : PARAM_COUNT_BASE+ti-EXP_TOTAL;);
function exp_x_addr(ti) (ti>=PARAM_TOTAL ? cc_curve(ti)+2 : ti<EXP_TOTAL ? INST_EXP_X_BASE+ti*EXP_POINTS : PARAM_X_BASE+(ti-EXP_TOTAL)*EXP_POINTS;);
function exp_y_addr(ti) (ti>=PARAM_TOTAL ? cc_curve(ti)+2+EXP_POINTS : ti<EXP_TOTAL ? INST_EXP_Y_BASE+ti*EXP_POINTS : PARAM_Y_BASE+(ti-EXP_TOTAL)*EXP_POINTS;);
function exp_bend_addr(ti) (ti>=PARAM_TOTAL ? cc_curve(ti)+2+2*EXP_POINTS : ti<EXP_TOTAL ? INST_EXP_BEND_BASE+ti*EXP_POINTS : PARAM_BEND_BASE+(ti-EXP_TOTAL)*EXP_POINTS;);
function payload_addr(j) (j>=DS_LEGACY_PAYLOAD?DS_CFG_BASE+j-DS_LEGACY_PAYLOAD:j>=TF_LEGACY_PAYLOAD?TF_CFG_BASE+j-TF_LEGACY_PAYLOAD:j>=CC_LEGACY_PAYLOAD ? CC_CFG_BASE+j-CC_LEGACY_PAYLOAD : j<WORK_MEM_SIZE ? j : j<SW_LEGACY_PAYLOAD ? PARAM_EXT_BASE+j-WORK_MEM_SIZE : SW_CFG_BASE+j-SW_LEGACY_PAYLOAD;);
function param_addr(gi,kind)
(
  kind==EXP_T_VEL ? INST_VEL_BASE+gi : kind==EXP_T_LEVEL ? INST_LEVEL_BASE+gi :
  kind==EXP_T_MOD ? INST_MOD_BASE+gi : kind==EXP_T_ARP_ON ? INST_ARP_ENABLED_BASE+gi :
  kind==EXP_T_ARP_MODE ? INST_ARP_MODE_BASE+gi : kind==EXP_T_ARP_RATE ? INST_ARP_RATE_BASE+gi :
  kind==EXP_T_ARP_GATE ? INST_ARP_GATE_BASE+gi : kind==PARAM_TRANSPOSE ? INST_TRANSPOSE_BASE+gi :
  kind==PARAM_RANGE_MODE ? INST_RANGE_MODE_BASE+gi : kind==PARAM_RANGE_LOW ? INST_RANGE_LOW_BASE+gi :
  kind==PARAM_RANGE_HIGH ? INST_RANGE_HIGH_BASE+gi : kind==PARAM_NOTE_MODE ? INST_NOTE_MODE_BASE+gi :
  kind==PARAM_ARP_HOLD ? INST_ARP_HOLD_BASE+gi : PARAM_MOD_CC_BASE+gi;
);
function param_min(kind)
(kind==PARAM_TRANSPOSE ? -48 : kind==EXP_T_VEL ? .2 : kind==EXP_T_ARP_RATE ? .25 : kind==EXP_T_ARP_GATE ? .02 : 0;);
function param_max(kind)
(kind==PARAM_TRANSPOSE ? 48 : kind==EXP_T_VEL ? 3 : kind==EXP_T_ARP_RATE ? 16 :
 kind==EXP_T_ARP_GATE || kind==EXP_T_ARP_ON || kind==PARAM_ARP_HOLD ? 1 :
 kind==EXP_T_ARP_MODE ? 2 : kind==PARAM_RANGE_MODE || kind==PARAM_NOTE_MODE ? 3 : 127;);
function param_step(kind)
(kind==EXP_T_VEL || kind==EXP_T_ARP_GATE ? .01 : kind==EXP_T_ARP_RATE ? .25 : 1;);
function param_name(kind)
(kind==EXP_T_VEL ? "VELOCITY" : kind==EXP_T_LEVEL ? "VOLUME" : kind==EXP_T_MOD ? "MOD LEVEL" :
 kind==EXP_T_ARP_ON ? "ARP ENABLED" : kind==EXP_T_ARP_MODE ? "MODE" : kind==EXP_T_ARP_RATE ? "RATE" :
 kind==EXP_T_ARP_GATE ? "GATE" : kind==PARAM_TRANSPOSE ? "SEMITONES" : kind==PARAM_RANGE_MODE ? "RANGE MODE" :
 kind==PARAM_RANGE_LOW ? "LOW NOTE" : kind==PARAM_RANGE_HIGH ? "HIGH NOTE" : kind==PARAM_NOTE_MODE ? "NOTE MODE" :
 kind==PARAM_ARP_HOLD ? "HOLD" : "CC NUMBER";);
function param_editor_kind(typ,row)
(typ==1 ? PARAM_TRANSPOSE : typ==2 ? PARAM_RANGE_MODE+row : typ==3 ? PARAM_NOTE_MODE :
 typ==4 ? EXP_T_VEL : typ==5 ? (row==0 ? EXP_T_ARP_MODE : row==1 ? EXP_T_ARP_RATE : row==2 ? EXP_T_ARP_GATE : PARAM_ARP_HOLD) :
 typ==6 ? (row==0 ? EXP_T_MOD : PARAM_MOD_CC) : -1;);
function param_discrete(kind)
(kind!=EXP_T_VEL && kind!=EXP_T_ARP_RATE && kind!=EXP_T_ARP_GATE;);
function param_scale(kind,pos)
local(lo,hi,step,v)
(
  lo=param_min(kind);hi=param_max(kind);step=param_step(kind);pos=max(0,min(1,pos));
  // Enums/toggles have equal-width bins. Signed semitones and CC/note numbers round.
  kind==EXP_T_ARP_ON || kind==PARAM_ARP_HOLD || kind==EXP_T_ARP_MODE || kind==PARAM_NOTE_MODE || kind==PARAM_RANGE_MODE ?
    min(hi,floor(pos*(hi+1))) : (
    v=lo+(hi-lo)*pos;
    max(lo,min(hi,floor(v/step+.5)*step));
  );
);
function param_extension_reset()
local(j,k,ti,gi)
(
  mem[PARAM_EXT_BASE]=PARAM_SCHEMA;
  j=0;loop(PARAM_EXTRA,
    ti=EXP_TOTAL+j;mem[exp_assign_addr(ti)]=0;mem[exp_count_addr(ti)]=2;
    k=0;loop(EXP_POINTS,
      mem[exp_x_addr(ti)+k]=(k==1);mem[exp_y_addr(ti)+k]=(k==1);
      mem[exp_bend_addr(ti)+k]=0;k+=1;
    );j+=1;
  );
  gi=0;loop(INSTRUMENTS,mem[PARAM_MOD_CC_BASE+gi]=1;gi+=1;);
);
function param_input_reset()
local(j)
(j=0;loop(PARAM_INPUT_SIZE+INSTRUMENTS,mem[PARAM_INPUT_BASE+j]=0;j+=1;););
function param_runtime_reset()
local(j)
(
  j=0;loop(PARAM_TOTAL,mem[PARAM_LAST_BASE+j]=-999;mem[PARAM_PENDING_BASE+j]=-999;j+=1;);
  param_input_reset();cc_runtime_reset();
);
function sw_committed_cfg(si) (si<4?SW_CFG_BASE+1+si*SW_STRIDE:DS_CFG_BASE+2+(si-4)*SW_STRIDE;);
function sw_cfg(si) (sw_preview_target==si?SW_DRAFT_BASE:sw_committed_cfg(si););
function sw_edit_cfg(si) (sw_edit_target==si?SW_DRAFT_BASE:sw_cfg(si););
function sw_bag(si) (si<4?SW_BAG_BASE+si*SW_STEPS:DS_BAG_BASE+(si-4)*SW_STEPS;);
function sw_undo(si) (si<4?SW_UNDO_BASE+si*SW_STRIDE:DS_UNDO_BASE+(si-4)*SW_STRIDE;);
function sw_rt(si) (si<4?SW_RT_BASE+si*SW_RT_STRIDE:DS_RT_BASE+(si-4)*SW_RT_STRIDE;);
function sw_defaults()
local(si,b,j)
(
  mem[SW_CFG_BASE]=SW_SCHEMA;mem[DS_CFG_BASE]=IO_SCHEMA;mem[DS_CFG_BASE+1]=5;si=0;loop(SW_COUNT,
    b=sw_cfg(si);j=0;loop(SW_STRIDE,mem[b+j]=0;j+=1;);
    mem[b+2]=0;mem[b+4]=60+si;mem[b+7]=300;mem[b+8]=800;
    mem[b+12]=127;mem[b+13]=0;mem[b+14]=SW_NEXT;mem[b+17]=si;mem[b+18]=si;mem[b+19]=si;mem[b+20]=si<4;mem[b+21]=si<4?si+1:0;j=0;si<4?loop(4,mem[b+112+j]=1;j+=1;);si+=1;
  );
);
function sw_reset(si)
local(r)
(r=sw_rt(si);mem[r+6]=-1;mem[r+7]=-1;mem[r+8]=1;mem[r+9]=0;mem[r+10]=-1;);
function sw_runtime_reset()
local(si,r,j,t)
(
  // Quarantine releases from commands held across preset changes, even if remapped.
  si=0;loop(SW_COUNT,
    r=sw_rt(si);mem[r]>0 || mem[r+17]==3 ? (
      j=0;t=-1;loop(SW_RELEASE_SIZE,mem[SW_RELEASE_BASE+j*4]==0 && t<0?t=j;j+=1;);
      t>=0 ? (t=SW_RELEASE_BASE+t*4;mem[t]=mem[r+13];mem[t+1]=mem[r+14];mem[t+2]=mem[r+15];mem[t+3]=mem[r+19];mem[SW_LEARN_RELEASE_DEADLINE_BASE+(t-SW_RELEASE_BASE)/4]=0;);
    );
    j=0;loop(SW_RT_STRIDE,mem[r+j]=0;j+=1;);sw_reset(si);si+=1;
  );
  sw_edit_target=-1;sw_preview_target=-1;sw_edit_new=0;sw_draft_undo_valid=0;ui_sw_editor_open=0;ui_sw_delete_slot=-1;
  learn_candidate=-1;learn_conflict=-1;controller_learn=-1;phrase_note_learn=-1;sw_last_active=-1;sw_learn=-1;sw_learn_request=-1;sw_clock=0;
  sw_queue_read=0;sw_queue_write=0;sw_playback_origin=0;
  j=SW_PHRASE_OUT_BASE;loop(SW_MEMORY_END-SW_PHRASE_OUT_BASE,mem[j]=0;j+=1;);
  j=0;loop(INSTRUMENTS*TRANSFORM_TYPES,mem[SW_MODULE_BASE+j]=-999;j+=1;);
);
// Normalize only the appended configuration; existing patch fields stay untouched.
function sw_validate()
local(si,b,j,k,other)
(
  si=0;loop(SW_COUNT,
    b=sw_cfg(si);mem[b]=mem[b]>0;mem[b+1]=mem[b+1]>0;
    mem[b+2]=max(0,min(2,floor(mem[b+2])));mem[b+3]=max(0,min(15,floor(mem[b+3])));
    mem[b+4]=max(0,min(127,floor(mem[b+4])));mem[b+5]=mem[b+5]>0;mem[b+6]=mem[b+6]>0;
    mem[b+7]=max(50,min(2000,mem[b+7]));mem[b+8]=max(100,min(5000,mem[b+8]));
    mem[b+9]=max(0,min(3,floor(mem[b+9])));mem[b+10]=mem[b+10]>0;mem[b+11]=max(0,min(SW_STEPS,floor(mem[b+11])));
    mem[b+12]=max(0,min(127,floor(mem[b+12])));mem[b+13]=max(0,min(127,floor(mem[b+13])));
    mem[b+2]==2 && mem[b+12]==mem[b+13] ? mem[b]=0;
    j=0;loop(3,
      mem[b+14+j]=max(0,min(SW_DISABLE,floor(mem[b+14+j])));
      k=mem[b+14+j];mem[b+17+j]=max(0,min(k>=SW_TOGGLE?INSTRUMENTS*TRANSFORM_TYPES-1:SW_COUNT,floor(mem[b+17+j])));j+=1;
    );
    j=0;si<4?loop(4,mem[b+112+j]=phrase_time_ratio(si*4+j);j+=1;);
    j=0;loop(si,other=sw_cfg(j);
      mem[other]>0 && mem[b+2]>0 && mem[other+2]==mem[b+2] && mem[other+3]==mem[b+3] && mem[other+4]==mem[b+4] ? mem[b]=0;j+=1;
    );
    si+=1;
  );
);
function ds_migrate()
local(si,b,j)
(mem[DS_CFG_BASE]=IO_SCHEMA;mem[DS_CFG_BASE+1]=5;si=0;loop(4,b=sw_cfg(si);mem[b+20]=1;mem[b+21]=si+1;j=0;
 loop(3,(mem[b+14+j]==SW_RESET || mem[b+14+j]==SW_STOP_RESET) && mem[b+17+j]==4?mem[b+17+j]=SW_COUNT;j+=1;);si+=1;););
function ds_bank_save(slot)
local(b,j)
(b=slot==2?DS_BANK2_BASE:DS_BANK1_BASE;j=0;loop(DS_CFG_SIZE,mem[b+j]=mem[DS_CFG_BASE+j];j+=1;););
function ds_bank_load(slot)
local(b,j)
(b=slot==2?DS_BANK2_BASE:DS_BANK1_BASE;mem[b]==IO_SCHEMA?(j=0;loop(DS_CFG_SIZE,mem[DS_CFG_BASE+j]=mem[b+j];j+=1;);):ds_migrate(););

function sw_bank_save(slot)
local(b,j,pb)
(
  b=slot==2?SW_BANK2_BASE:SW_BANK1_BASE;pb=slot==2?PATCH2_BASE:PATCH1_BASE;
  mem[pb+10]=SW_SCHEMA;j=0;loop(SW_CFG_SIZE,mem[b+j]=mem[SW_CFG_BASE+j];j+=1;);ds_bank_save(slot);
);
function sw_bank_load(slot)
local(b,j,pb)
(
  pb=slot==2?PATCH2_BASE:PATCH1_BASE;sw_defaults();
  mem[pb+10]==SW_SCHEMA ? (
    b=slot==2?SW_BANK2_BASE:SW_BANK1_BASE;j=0;loop(SW_CFG_SIZE,mem[SW_CFG_BASE+j]=mem[b+j];j+=1;);
  );ds_bank_load(slot);sw_validate();sw_runtime_reset();
);
sw_defaults();sw_runtime_reset();

function param_bank_save(slot)
local(j,b)
(b=slot==2 ? PARAM_BANK2_BASE : PARAM_BANK1_BASE;j=0;loop(PARAM_EXT_SIZE,mem[b+j]=mem[PARAM_EXT_BASE+j];j+=1;););
function param_bank_load(slot)
local(j,b,pb)
(
  pb=slot==2 ? PATCH2_BASE : PATCH1_BASE;
  mem[pb+9]==PARAM_SCHEMA ? (
    b=slot==2 ? PARAM_BANK2_BASE : PARAM_BANK1_BASE;j=0;
    loop(PARAM_EXT_SIZE,mem[PARAM_EXT_BASE+j]=mem[b+j];j+=1;);
  ) : param_extension_reset();
  param_runtime_reset();sw_bank_load(slot);cc_bank_load(slot);tf_bank_load(slot);
);
param_extension_reset();param_runtime_reset();

function save_patch(slot)
local(pb,j)
(
  pb = slot==1 ? PATCH1_BASE : PATCH2_BASE;
  mem[pb+0]=loop_len_samples;
  mem[pb+1]=analysis_done;
  mem[pb+2]=slider4;
  mem[pb+3]=slider5;
  mem[pb+4]=slider6;
  mem[pb+5]=slider7;
  mem[pb+6]=slider8;
  mem[pb+7]=slider9;
  mem[pb+8]=record_layer;
  mem[pb+9]=PARAM_SCHEMA;
  param_bank_save(slot);
  sw_bank_save(slot);
  cc_bank_save(slot);tf_bank_save(slot);
  j=0;
  loop(WORK_MEM_SIZE,
    mem[pb+PATCH_HEADER_SIZE+j]=mem[j];
    j+=1;
  );
  slot==1 ? patch_valid1=1 : patch_valid2=1;
  current_patch=slot;
  save_flash_patch=slot;
  save_flash=srate*1.5;
);

function load_patch(slot)
local(pb,j,valid,oldslot)
(
  oldslot=current_patch;
  oldslot!=slot ? (
    save_patch(oldslot);
    valid = slot==1 ? patch_valid1 : patch_valid2;
    panic_pending=1;
    valid ? (
      pb = slot==1 ? PATCH1_BASE : PATCH2_BASE;
      j=0;
      loop(WORK_MEM_SIZE,
        mem[j]=mem[pb+PATCH_HEADER_SIZE+j];
        j+=1;
      );
      param_bank_load(slot);
      loop_len_samples=mem[pb+0];
      analysis_done=mem[pb+1];
      slider4=mem[pb+2];
      slider5=mem[pb+3];
      slider6=mem[pb+4];
      slider7=mem[pb+5];
      slider8=mem[pb+6];
      slider9=mem[pb+7];
      record_layer=mem[pb+8];
    ) : (
      reset_all_phrases();
      param_extension_reset();param_runtime_reset();sw_defaults();sw_runtime_reset();cc_defaults();cc_runtime_reset();tf_defaults();tf_runtime_reset();
      slider4=0;
      slider5=0;
      slider6=120;
      slider7=4;
      slider8=0;
      slider9=1;
    );
    record_sample_pos=0;
    play_sample_pos=0;
    overdub_armed=0;
    overdub_active=0;
    overdub_pos=0;
    state = loop_len_samples>0 ? STATE_STOPPED : STATE_IDLE;
    current_patch=slot;
  );
);

function arm_layer(layer)
(
  // An existing take cannot be armed as a new recording.
  layer_count(layer)>0 ? (
    overdub_layer=layer;
    overdub_armed=1;
    overdub_active=0;
    overdub_wait_note=mem[MODE_BASE+layer]>=0.5;
    play_sample_pos=0;
    overdub_pos=0;
  ) : (
  panic_pending=1;
  overdub_wait_note=0;
  record_layer=layer;
  record_sample_pos=0;
  play_sample_pos=0;
  overdub_armed=0;
  overdub_active=0;
  overdub_wait_note=0;
  state=STATE_READY;
  );
);

function store_event(layer, ts, st, d1, d2, offs)
local(count,base)
(
  count=layer_count(layer);
  count < MAX_EVENTS_PER_LAYER ? (
    base=layer_base(layer,count);
    mem[base]=ts;
    mem[base+1]=st;
    mem[base+2]=d1;
    mem[base+3]=d2;
    mem[base+4]=offs;
    set_layer_count(layer,count+1);
  );
);

function arp_capture_note(gi, outst, note, vel, is_on)
local(idx,sidx)
(
  idx=ARP_HELD_COUNT_BASE+gi*128+note;
  sidx=ARP_SOURCE_COUNT_BASE+gi*128+note;
  is_on ? (
    mem[sidx]+=1;
    mem[idx]+=1;
    mem[ARP_HELD_VEL_BASE+gi*128+note]=vel;
    mem[ARP_ACTIVE_CH_BASE+gi]=outst&15;
  ) : (
    mem[sidx]=max(0,mem[sidx]-1);
    // HOLD OFF follows source releases. HOLD ON keeps the note latched.
    mem[INST_ARP_HOLD_BASE+gi]<0.5 ? mem[idx]=max(0,mem[idx]-1);
  );
);

function arp_clear_latch(gi)
local(n,sidx,hidx)
(
  n=0;
  loop(128,
    sidx=ARP_SOURCE_COUNT_BASE+gi*128+n;
    hidx=ARP_HELD_COUNT_BASE+gi*128+n;
    // When leaving HOLD, retain only notes that are physically/source-held now.
    mem[hidx]=mem[sidx];
    mem[SW_ARP_PHRASE_BASE+gi*128+n]=mem[SW_ARP_PHRASE_SOURCE_BASE+gi*128+n];
    n+=1;
  );
);

function arp_release_instrument(gi)
local(an,ch)
(
  an=mem[ARP_ACTIVE_NOTE_BASE+gi];
  ch=mem[ARP_ACTIVE_CH_BASE+gi]&15;
  an>=0 ? midisend(0,128|ch,an);
  mem[ARP_ACTIVE_NOTE_BASE+gi]=-1;
  mem[ARP_GATE_REMAIN_BASE+gi]=0;
);


function arp_flush_nonhold_sources()
local(ai,n)
(
  ai=0;
  loop(INSTRUMENTS,
    mem[INST_ARP_ENABLED_BASE+ai]>0.5 && mem[INST_ARP_HOLD_BASE+ai]<0.5 ? (
      n=0;
      loop(128,
        mem[ARP_SOURCE_COUNT_BASE+ai*128+n]=0;
        mem[ARP_HELD_COUNT_BASE+ai*128+n]=0;
        mem[SW_ARP_PHRASE_BASE+ai*128+n]=0;mem[SW_ARP_PHRASE_SOURCE_BASE+ai*128+n]=0;
        n+=1;
      );
      arp_release_instrument(ai);
      mem[ARP_STEP_REMAIN_BASE+ai]=0;
    );
    ai+=1;
  );
);

function transformer_on(gi, typ)
local(k,c,found)
(
  k=0;found=0;c=max(0,min(TRANSFORM_SLOTS,floor(mem[INST_TRANSFORM_COUNT_BASE+gi]+.5)));
  loop(c,
    mem[INST_TRANSFORM_TYPE_BASE+gi*TRANSFORM_SLOTS+k]==typ ? found=1;
    k+=1;
  );
  found;
);
function arp_process_instrument(gi)
local(rate,gate,step_samples,step_rem,gate_rem,held,n,choice,pick,vel,ch,an,offs)
(
  mem[INST_ARP_ENABLED_BASE+gi]>0.5 && transformer_on(gi,5) ? (
    rate=max(0.25,min(16,mem[INST_ARP_RATE_BASE+gi]));
    gate=max(0.02,min(1,mem[INST_ARP_GATE_BASE+gi]));
    step_samples=max(1,srate*60/max(1,tempo)/rate);

    step_rem=mem[ARP_STEP_REMAIN_BASE+gi];
    gate_rem=mem[ARP_GATE_REMAIN_BASE+gi];

    // Gate-off may happen inside this audio block.
    an=mem[ARP_ACTIVE_NOTE_BASE+gi];
    an>=0 && gate_rem<=samplesblock ? (
      offs=max(0,min(samplesblock-1,gate_rem));
      ch=mem[ARP_ACTIVE_CH_BASE+gi]&15;
      midisend(offs,128|ch,an);
      mem[ARP_ACTIVE_NOTE_BASE+gi]=-1;
      gate_rem=0;
    ) : gate_rem=max(0,gate_rem-samplesblock);

    held=0; n=0;
    loop(128,
      mem[ARP_HELD_COUNT_BASE+gi*128+n]>0 ? held+=1;
      n+=1;
    );

    held<=0 ? (
      arp_release_instrument(gi);
      step_rem=0;
    ) : (
      // Generate every step that falls in this block. RANDOM chooses among currently held notes.
      step_rem<=0 ? step_rem=0;
      while(step_rem<samplesblock) (
        // End previous arp note before retriggering the next one.
        an=mem[ARP_ACTIVE_NOTE_BASE+gi];
        an>=0 ? (
          ch=mem[ARP_ACTIVE_CH_BASE+gi]&15;
          midisend(max(0,min(samplesblock-1,step_rem)),128|ch,an);
          mem[ARP_ACTIVE_NOTE_BASE+gi]=-1;
        );

        mode=floor(mem[INST_ARP_MODE_BASE+gi]+0.5);
        choice=-1;
        mode==0 ? (
          pick=floor(rand(held)); n=0;
          loop(128,
            mem[ARP_HELD_COUNT_BASE+gi*128+n]>0 ? (
              pick<=0 && choice<0 ? choice=n;
              pick-=1;
            );
            n+=1;
          );
        ) : mode==1 ? (
          // UP: next held note above cursor, wrapping to the lowest.
          cur=mem[ARP_CURSOR_BASE+gi]; n=0;
          loop(128, n>cur && choice<0 && mem[ARP_HELD_COUNT_BASE+gi*128+n]>0 ? choice=n; n+=1;);
          choice<0 ? (n=0; loop(128, choice<0 && mem[ARP_HELD_COUNT_BASE+gi*128+n]>0 ? choice=n; n+=1;););
        ) : (
          // DOWN: next held note below cursor, wrapping to the highest.
          cur=mem[ARP_CURSOR_BASE+gi]; n=127;
          loop(128, n<cur && choice<0 && mem[ARP_HELD_COUNT_BASE+gi*128+n]>0 ? choice=n; n-=1;);
          choice<0 ? (n=127; loop(128, choice<0 && mem[ARP_HELD_COUNT_BASE+gi*128+n]>0 ? choice=n; n-=1;););
        );
        choice>=0 ? mem[ARP_CURSOR_BASE+gi]=choice;
        choice>=0 ? (
          vel=max(1,min(127,mem[ARP_HELD_VEL_BASE+gi*128+choice]));
          ch=mem[ARP_ACTIVE_CH_BASE+gi]&15;
          offs=max(0,min(samplesblock-1,step_rem));
          midisend(offs,144|ch,choice|(vel*256));
          mem[ARP_ACTIVE_NOTE_BASE+gi]=choice;
          gate_rem=step_samples*gate;
        );
        step_rem+=step_samples;
      );
      step_rem-=samplesblock;
    );

    mem[ARP_STEP_REMAIN_BASE+gi]=step_rem;
    mem[ARP_GATE_REMAIN_BASE+gi]=gate_rem;
  ) : (
    // Turning ARP off must never leave a generated note hanging.
    arp_release_instrument(gi);
    mem[ARP_STEP_REMAIN_BASE+gi]=0;
  );
);

function note_in_range(gi, note)
local(rm,lo,hi,ok)
(
  rm=floor(mem[INST_RANGE_MODE_BASE+gi]+0.5);
  lo=max(0,min(127,floor(mem[INST_RANGE_LOW_BASE+gi]+0.5)));
  hi=max(0,min(127,floor(mem[INST_RANGE_HIGH_BASE+gi]+0.5)));
  ok=1;
  rm==1 ? ok=(note>=lo) :
  rm==2 ? ok=(note<=hi) :
  rm==3 ? ok=(note>=lo && note<=hi);
  ok;
);

// Legacy single-instance patches keep the established fixed stages. Adding a
// stateless duplicate opts the note processors into the visible serial order.
function tf_serial(gi)
local(k,c,code,typ,found)
(k=0;found=0;c=max(0,min(TRANSFORM_SLOTS,floor(mem[INST_TRANSFORM_COUNT_BASE+gi])));loop(c,code=mem[INST_TRANSFORM_TYPE_BASE+gi*TRANSFORM_SLOTS+k];code>=7?(typ=transform_type(gi,code);typ==1 || typ==2 || typ==4?found=1;);k+=1;);found;);
function tf_pitch(gi,note)
local(k,c,code,typ,b,mode,lo,hi)
(
  !tf_serial(gi) ? (note+=transformer_on(gi,1)?floor(mem[INST_TRANSPOSE_BASE+gi]+.5):0;
    transformer_on(gi,2) && !note_in_range(gi,note)?note=-1;
  ) : (
    k=0;c=max(0,min(TRANSFORM_SLOTS,floor(mem[INST_TRANSFORM_COUNT_BASE+gi])));loop(c,code=mem[INST_TRANSFORM_TYPE_BASE+gi*TRANSFORM_SLOTS+k];
      code>0 && note>=0 && note<=127?(
        typ=transform_type(gi,code);b=code>=7?cc_cfg(cc_index(gi,code)):-1;
        typ==1?note+=floor((b>=0?mem[b+2]:mem[INST_TRANSPOSE_BASE+gi])+.5);
        typ==2?(
          mode=b>=0?mem[b+2]:mem[INST_RANGE_MODE_BASE+gi];lo=b>=0?mem[b+1]:mem[INST_RANGE_LOW_BASE+gi];hi=b>=0?mem[b+3]:mem[INST_RANGE_HIGH_BASE+gi];
          ((mode==1 && note<lo) || (mode==2 && note>hi) || (mode==3 && (note<lo || note>hi)))?note=-1;
        );
      );k+=1;
    );
  );note>=0 && note<=127?note:-1;
);
function tf_velocity(gi,vel,gain)
local(k,c,code)
(
  !tf_serial(gi)?gain*=transformer_on(gi,4)?mem[INST_VEL_BASE+gi]:1:(
    k=0;c=max(0,min(TRANSFORM_SLOTS,floor(mem[INST_TRANSFORM_COUNT_BASE+gi])));loop(c,code=mem[INST_TRANSFORM_TYPE_BASE+gi*TRANSFORM_SLOTS+k];
      code>0 && transform_type(gi,code)==4?gain*=code>=7?mem[cc_cfg(cc_index(gi,code))+2]:mem[INST_VEL_BASE+gi];k+=1;
    );
  );max(1,min(127,floor(vel*gain+.5)));
);

function route_emit_note(gi, offs, outst, note, vel, is_on, owned, origin_override)
local(ch,key,origin,idx)
(
  ch=outst&15;origin=origin_override==0?(owned || sw_playback_origin):origin_override>0;
  idx=(gi*16+ch)*128+note;
  !(mem[INST_ARP_ENABLED_BASE+gi]>.5 && transformer_on(gi,5)) ? (
    origin ? (is_on?mem[SW_PHRASE_OUT_BASE+idx]+=1:mem[SW_PHRASE_OUT_BASE+idx]=max(0,mem[SW_PHRASE_OUT_BASE+idx]-1);) :
      (is_on?mem[SW_LIVE_OUT_BASE+idx]+=1:mem[SW_LIVE_OUT_BASE+idx]=max(0,mem[SW_LIVE_OUT_BASE+idx]-1););
  );
  mem[INST_ARP_ENABLED_BASE+gi]>0.5 && transformer_on(gi,5) ? (
    origin ? (
      is_on ? (mem[SW_ARP_PHRASE_SOURCE_BASE+gi*128+note]+=1;mem[SW_ARP_PHRASE_BASE+gi*128+note]+=1;) : (mem[SW_ARP_PHRASE_SOURCE_BASE+gi*128+note]=max(0,mem[SW_ARP_PHRASE_SOURCE_BASE+gi*128+note]-1);mem[INST_ARP_HOLD_BASE+gi]<.5 ? mem[SW_ARP_PHRASE_BASE+gi*128+note]=max(0,mem[SW_ARP_PHRASE_BASE+gi*128+note]-1););
    );
    arp_capture_note(gi,outst,note,vel,is_on);
  ) : owned ? (
    key=NOTE_REF_BASE+ch*128+note;
    is_on ? (
      mem[key]+=1;
      midisend(offs,outst,note|(vel*256));
    ) : (
      mem[key]=max(0,mem[key]-1);
      mem[key]<=0 ? midisend(offs,128|ch,note);
    );
  ) : (
    is_on ? midisend(offs,outst,note|(vel*256)) : midisend(offs,128|ch,note);
  );
);

function mono_desired_note(gi, mode)
local(n,best,best_order,ord)
(
  best=-1;
  mode==1 ? (
    n=0;
    loop(128,
      best<0 && mem[MONO_HELD_COUNT_BASE+gi*128+n]>0 ? best=n;
      n+=1;
    );
  ) : (
    best_order=-1; n=0;
    loop(128,
      mem[MONO_HELD_COUNT_BASE+gi*128+n]>0 ? (
        ord=mem[MONO_ORDER_BASE+gi*128+n];
        ord>best_order ? (best_order=ord; best=n;);
      );
      n+=1;
    );
  );
  best;
);

function route_mono_note(gi, offs, outst, note, vel, is_on, owned)
local(mode,idx,desired,active,active_ch,newst,newvel,old_owner,new_owner,key)
(
  mode=floor(mem[INST_NOTE_MODE_BASE+gi]+0.5);
  idx=MONO_HELD_COUNT_BASE+gi*128+note;
  owned || sw_playback_origin ? (is_on?mem[SW_MONO_PHRASE_BASE+gi*128+note]+=1:mem[SW_MONO_PHRASE_BASE+gi*128+note]=max(0,mem[SW_MONO_PHRASE_BASE+gi*128+note]-1););
  is_on ? (
    mem[idx]+=1;
    mem[MONO_HELD_VEL_BASE+gi*128+note]=vel;
    mono_order_counter+=1;
    mem[MONO_ORDER_BASE+gi*128+note]=mono_order_counter;
  ) : (
    mem[idx]=max(0,mem[idx]-1);
  );

  desired=mono_desired_note(gi,mode);
  active=mem[MONO_ACTIVE_NOTE_BASE+gi];
  active_ch=mem[MONO_ACTIVE_CH_BASE+gi]&15;
  old_owner=mem[SW_MONO_OWNER_BASE+gi];
  new_owner=desired>=0 && mem[SW_MONO_PHRASE_BASE+gi*128+desired]>=mem[MONO_HELD_COUNT_BASE+gi*128+desired]?1:-1;

  desired!=active ? (
    desired>=0 ? (
      newst=144|(outst&15);
      newvel=max(1,min(127,mem[MONO_HELD_VEL_BASE+gi*128+desired]));
      mode==3 ? (
        // LEGATO: overlap the transition so mono synths can engage their own legato/glide behavior.
        route_emit_note(gi,offs,newst,desired,newvel,1,owned,new_owner);
        active>=0 ? route_emit_note(gi,offs,128|active_ch,active,0,0,owned,old_owner);
      ) : (
        active>=0 ? route_emit_note(gi,offs,128|active_ch,active,0,0,owned,old_owner);
        route_emit_note(gi,offs,newst,desired,newvel,1,owned,new_owner);
      );
      mem[SW_MONO_OWNER_BASE+gi]=new_owner;mem[MONO_ACTIVE_NOTE_BASE+gi]=desired;
      mem[MONO_ACTIVE_CH_BASE+gi]=outst&15;
    ) : (
      active>=0 ? route_emit_note(gi,offs,128|active_ch,active,0,0,owned,old_owner);
      mem[MONO_ACTIVE_NOTE_BASE+gi]=-1;
    );
  );
  // A mono transition may be caused by the other source owner. Track the
  // resulting audible voice, rather than attributing its note-off to that input.
  !(mem[INST_ARP_ENABLED_BASE+gi]>.5 && transformer_on(gi,5)) ? (
    active>=0 && active!=desired ? (
      key=(gi*16+active_ch)*128+active;mem[SW_LIVE_OUT_BASE+key]=0;mem[SW_PHRASE_OUT_BASE+key]=0;
    );
    desired>=0 ? (
      key=(gi*16+mem[MONO_ACTIVE_CH_BASE+gi])*128+desired;
      mem[SW_LIVE_OUT_BASE+key]=mem[MONO_HELD_COUNT_BASE+gi*128+desired]>mem[SW_MONO_PHRASE_BASE+gi*128+desired];
      mem[SW_PHRASE_OUT_BASE+key]=mem[SW_MONO_PHRASE_BASE+gi*128+desired]>0;
    );
  );
);

function param_track_input(gi,ch,note,is_on,owned)
local(idx)
(
  idx=PARAM_INPUT_BASE+((owned*INSTRUMENTS+gi)*16+ch)*128+note;
  is_on ? (mem[idx]+=1;mem[PARAM_ACTIVE_BASE+gi]+=1;) : mem[idx]>0 ? (
    mem[idx]-=1;mem[PARAM_ACTIVE_BASE+gi]=max(0,mem[PARAM_ACTIVE_BASE+gi]-1);
  );
);
function param_release_owned()
local(gi,j,idx)
(
  gi=0;loop(INSTRUMENTS,
    j=0;loop(16*128,
      idx=PARAM_INPUT_BASE+(INSTRUMENTS+gi)*16*128+j;
      mem[PARAM_ACTIVE_BASE+gi]=max(0,mem[PARAM_ACTIVE_BASE+gi]-mem[idx]);mem[idx]=0;j+=1;
    );gi+=1;
  );
);

function send_to_instruments(offs, st, d1, d2, extra_gain)
local(srcch,typ,ii,in_ch,out_ch,outst,outd2,matched,velmul,nmode,tn)
(
  srcch=(st&15)+1;
  typ=st&240;
  matched=0;
  ii=0;
  loop(INSTRUMENTS,
    mem[INST_ENABLED_BASE+ii]>0.5 ? (
      in_ch=mem[INST_IN_BASE+ii];
      (in_ch==0 || in_ch==srcch) ? (
        matched=1;
        out_ch=mem[INST_OUT_BASE+ii];
        outst=st;
        out_ch>0 ? outst=(st&240)|(max(1,min(16,out_ch))-1);
        outd2=d2;
        nmode=transformer_on(ii,3) ? floor(mem[INST_NOTE_MODE_BASE+ii]+0.5) : 0;

        typ==176 && d1==64 ? (sw_playback_origin ? mem[SW_PHRASE_SUSTAIN_BASE+(outst&15)]=d2 : mem[SW_LIVE_SUSTAIN_BASE+(outst&15)]=d2;);
        (typ==144 && d2>0) ? (
          sw_playback_origin ? mem[SW_LOOP_INPUT_BASE+(ii*16+srcch-1)*128+d1]+=1;
          param_track_input(ii,srcch-1,d1,1,0);
          tn=tf_pitch(ii,d1);
          tn>=0 && tn<=127 ? (
            outd2=tf_velocity(ii,d2,extra_gain);
            nmode>0 ? route_mono_note(ii,offs,outst,tn,outd2,1,0) :
                      route_emit_note(ii,offs,outst,tn,outd2,1,0,0);
          );
        ) :
        ((typ==128) || (typ==144 && d2==0)) ? (
          sw_playback_origin ? mem[SW_LOOP_INPUT_BASE+(ii*16+srcch-1)*128+d1]=max(0,mem[SW_LOOP_INPUT_BASE+(ii*16+srcch-1)*128+d1]-1);
          param_track_input(ii,srcch-1,d1,0,0);
          tn=tf_pitch(ii,d1);
          tn>=0 && tn<=127 ? (
            nmode>0 ? route_mono_note(ii,offs,outst,tn,0,0,0) :
                      route_emit_note(ii,offs,outst,tn,0,0,0,0);
          );
        ) :
          midisend(offs,outst,d1|(d2*256));
      );
    );
    ii+=1;
  );
  matched==0 ? (
    typ==144 || typ==128 ? (
      nmode=(st&15)*128+d1;tn=SW_LIVE_OUT_BASE+nmode;sw_playback_origin?tn=SW_PHRASE_OUT_BASE+nmode;
      typ==144 && d2>0 ? mem[tn]+=1 : mem[tn]=max(0,mem[tn]-1);
    );
    typ==176 && d1==64 ? (sw_playback_origin?mem[SW_PHRASE_SUSTAIN_BASE+(st&15)]=d2:mem[SW_LIVE_SUSTAIN_BASE+(st&15)]=d2;);
    midisend(offs,st,d1|(d2*256));
  );
);

function send_expression_ccs()
local(ii,out_ch,ch,lev,mod)
(
  ii=0;
  loop(INSTRUMENTS,
    mem[INST_ENABLED_BASE+ii]>0.5 ? (
      out_ch=mem[INST_OUT_BASE+ii];
      ch=out_ch>0 ? max(1,min(16,out_ch))-1 : 0;
      // EXP A currently drives LEVEL, EXP B drives MOD. These are test sources;
      // the next mapping layer will make source/target/range freely assignable.
      lev=max(0,min(127,floor(mem[INST_LEVEL_BASE+ii]+0.5)));
      mod=max(0,min(127,floor(mem[INST_MOD_BASE+ii]+0.5)));
      midisend(0,176|ch,7,lev);
      midisend(0,176|ch,1,mod);
    );
    ii+=1;
  );
);

function send_once_to_instruments(offs, st, d1, d2, phrase_gain)
local(srcch,typ,ii,in_ch,out_ch,outst,outd2,matched,velmul,msg_chan,note_key,nmode,tn)
(
  srcch=(st&15)+1;
  typ=st&240;
  matched=0;
  ii=0;
  loop(INSTRUMENTS,
    mem[INST_ENABLED_BASE+ii]>0.5 ? (
      in_ch=mem[INST_IN_BASE+ii];
      (in_ch==0 || in_ch==srcch) ? (
        matched=1;
        out_ch=mem[INST_OUT_BASE+ii];
        outst=st;
        out_ch>0 ? outst=(st&240)|(max(1,min(16,out_ch))-1);
        msg_chan=outst&15;
        outd2=d2;
        nmode=transformer_on(ii,3) ? floor(mem[INST_NOTE_MODE_BASE+ii]+0.5) : 0;

        (typ==144 && d2>0) ? (
          param_track_input(ii,srcch-1,d1,1,1);
          tn=tf_pitch(ii,d1);
          tn>=0 && tn<=127 ? (
            outd2=tf_velocity(ii,d2,phrase_gain);
            nmode>0 ? route_mono_note(ii,offs,outst,tn,outd2,1,1) :
                      route_emit_note(ii,offs,outst,tn,outd2,1,1,0);
          );
        ) :
        ((typ==128) || (typ==144 && d2==0)) ? (
          param_track_input(ii,srcch-1,d1,0,1);
          tn=tf_pitch(ii,d1);
          tn>=0 && tn<=127 ? (
            nmode>0 ? route_mono_note(ii,offs,outst,tn,0,0,1) :
                      route_emit_note(ii,offs,outst,tn,0,0,1,0);
          );
        ) :
        (typ==176 && d1==64) ? (
          mem[SW_PHRASE_SUSTAIN_BASE+msg_chan]=d2;
          d2>=64 ? (
            mem[SUSTAIN_REF_BASE+msg_chan]+=1;
            midisend(offs,outst,d1|(d2*256));
          ) : (
            mem[SUSTAIN_REF_BASE+msg_chan]=max(0,mem[SUSTAIN_REF_BASE+msg_chan]-1);
            mem[SUSTAIN_REF_BASE+msg_chan]<=0 ? midisend(offs,outst,d1);
          );
        ) : midisend(offs,outst,d1|(d2*256));
      );
    );
    ii+=1;
  );
  matched==0 ? (
    msg_chan=st&15;
    typ==144 || typ==128 ? (
      note_key=SW_PHRASE_OUT_BASE+msg_chan*128+d1;
      typ==144 && d2>0?mem[note_key]+=1:mem[note_key]=max(0,mem[note_key]-1);
    );
    typ==176 && d1==64 ? mem[SW_PHRASE_SUSTAIN_BASE+msg_chan]=d2;
    (typ==144 && d2>0) ? (
      outd2=max(1,min(127,floor(d2*phrase_gain+0.5)));
      note_key=NOTE_REF_BASE+msg_chan*128+d1; mem[note_key]+=1;
      midisend(offs,st,d1|(outd2*256));
    ) :
    ((typ==128)||(typ==144&&d2==0)) ? (
      note_key=NOTE_REF_BASE+msg_chan*128+d1; mem[note_key]=max(0,mem[note_key]-1);
      mem[note_key]<=0 ? midisend(offs,128|msg_chan,d1);
    ) : midisend(offs,st,d1|(d2*256));
  );
);

function controller_value(ci)
(
  ci==0?ctrl_val0:ci==1?ctrl_val1:ci==2?ctrl_val2:ctrl_val3;
);
function controller_set_value(ci,v)
(
  ci==0?ctrl_val0=v:ci==1?ctrl_val1=v:ci==2?ctrl_val2=v:ctrl_val3=v;
);
function controller_name(ci)
(
  ci==0?"EXP 1 CODIE":ci==1?"EXP 2 CODIE":ci==2?"EXP 1 PIERRE":"EXP 2 PIERRE";
);

function exp_segment_t(t, bend)
local(p)
(
  t=max(0,min(1,t));
  bend=max(-0.98,min(0.98,bend));
  bend>0 ? (
    p=1+5*bend;
    pow(t,p);
  ) : bend<0 ? (
    p=1+5*(-bend);
    1-pow(1-t,p);
  ) : t;
);

function exp_curve_value(ti, xpos)
local(cnt,k,x0,y0,x1,y1,t,bend,res)
(
  cnt=max(2,min(EXP_POINTS,floor(mem[exp_count_addr(ti)]+0.5)));
  xpos=max(0,min(1,xpos));
  x0=mem[exp_x_addr(ti)];
  y0=mem[exp_y_addr(ti)];
  res=y0;
  k=1;
  loop(cnt-1,
    x1=mem[exp_x_addr(ti)+k];
    y1=mem[exp_y_addr(ti)+k];
    xpos>=x1 ? res=y1 :
    xpos>=x0 && xpos<x1 ? (
      t=(xpos-x0)/max(0.000001,x1-x0);
      bend=mem[exp_bend_addr(ti)+k-1];
      t=exp_segment_t(t,bend);
      res=y0+(y1-y0)*t;
    );
    x0=x1; y0=y1;
    k+=1;
  );
  xpos>=x0 ? res=y0;
  max(0,min(1,res));
);

function exp_sort_points(ti)
local(cnt,a,b,xa,xb,tmp)
(
  cnt=max(2,min(EXP_POINTS,floor(mem[exp_count_addr(ti)]+0.5)));
  a=0;
  loop(cnt,
    b=0;
    loop(cnt-1,
      xa=mem[exp_x_addr(ti)+b];
      xb=mem[exp_x_addr(ti)+b+1];
      xa>xb ? (
        tmp=xa; mem[exp_x_addr(ti)+b]=xb; mem[exp_x_addr(ti)+b+1]=tmp;
        tmp=mem[exp_y_addr(ti)+b];
        mem[exp_y_addr(ti)+b]=mem[exp_y_addr(ti)+b+1];
        mem[exp_y_addr(ti)+b+1]=tmp;
      );
      b+=1;
    );
    a+=1;
  );
);

// Audio writes are centralized here. Unsafe note-transform changes wait until
// all source notes release. No panic bursts and no reinterpretation of Note Offs.
function param_apply(gi,kind,value)
local(addr,old,ti,unsafe)
(
  ti=param_ti(gi,kind);
  ti>=0 ? (
    addr=param_addr(gi,kind);old=mem[addr];
    value=max(param_min(kind),min(param_max(kind),value));
    unsafe=(kind==PARAM_TRANSPOSE || kind==PARAM_RANGE_MODE || kind==PARAM_RANGE_LOW ||
            kind==PARAM_RANGE_HIGH || kind==PARAM_NOTE_MODE || kind==EXP_T_ARP_ON);
    unsafe && mem[PARAM_ACTIVE_BASE+gi]>0 ? mem[param_pending_addr(ti)]=value : (
      mem[param_pending_addr(ti)]=-999;
      old!=value ? (
        mem[addr]=value;
        kind==EXP_T_LEVEL ? mem[CC_DIRTY_BASE+gi]=1;
        kind==EXP_T_MOD || kind==PARAM_MOD_CC ? mem[CC_DIRTY_MOD_BASE+gi]=1;
        kind==PARAM_ARP_HOLD && value<.5 ? arp_clear_latch(gi);
        kind==EXP_T_ARP_ON && value<.5 ? (arp_release_instrument(gi);arp_clear_latch(gi););
      );
    );
  );
);
function param_expression_tick()
local(ti,gi,kind,asg,value,pending)
(
  ti=0;loop(PARAM_TOTAL,
    gi=param_gi(ti);kind=param_kind(ti);asg=floor(mem[exp_assign_addr(ti)]+.5);
    pending=mem[param_pending_addr(ti)];
    asg>=1 && asg<=CONTROLLERS ? (
      value=param_scale(kind,exp_curve_value(ti,controller_value(asg-1)));
      value!=mem[param_last_addr(ti)] || pending!=-999 ? (
        param_apply(gi,kind,value);mem[param_last_addr(ti)]=value;
      );
    ) : pending!=-999 ? param_apply(gi,kind,pending);
    ti+=1;
  );
);
function cc_expression_tick()
local(j,row,ti,b,asg,value,pending,kind,typ,addr,unsafe)
(
  j=0;loop(CC_EXTRA,b=cc_cfg(j);mem[b]>0?(
    typ=mem[tf_record(j)];row=0;loop(typ==2?3:typ==6?2:1,
      ti=cc_ti(j,row);kind=param_kind(ti);asg=floor(mem[exp_assign_addr(ti)]+.5);pending=mem[param_pending_addr(ti)];
      asg>=1 && asg<=CONTROLLERS ? value=param_scale(kind,exp_curve_value(ti,controller_value(asg-1))) : value=pending;
      value!=-999 ? (
        unsafe=(typ==1 || typ==2) && mem[PARAM_ACTIVE_BASE+floor(j/(TRANSFORM_SLOTS-1))]>0;
        unsafe ? mem[param_pending_addr(ti)]=value : (
          addr=b+(row==0?2:row==1?1:3);mem[addr]=max(param_min(kind),min(param_max(kind),value));mem[param_pending_addr(ti)]=-999;
        );
      );row+=1;
    );
  );j+=1;);
);
function cc_route_channel(gi,override)
local(ch)
(ch=override>0?override:mem[INST_OUT_BASE+gi]>0?mem[INST_OUT_BASE+gi]:mem[INST_IN_BASE+gi]>0?mem[INST_IN_BASE+gi]:1;
 max(0,min(15,floor(ch)-1)););
function cc_record(gi,code) (CC_RT_BASE+(code==6?CC_EXTRA+gi:cc_index(gi,code))*CC_RT_STRIDE;);
function cc_generators_tick()
local(gi,k,c,code,index,b,r,ch,cc,value,on,dirty,j,other)
(
  gi=0;loop(INSTRUMENTS,
    k=0;c=max(0,min(TRANSFORM_SLOTS,floor(mem[INST_TRANSFORM_COUNT_BASE+gi])));
    loop(TRANSFORM_SLOTS,
      code=k==TRANSFORM_SLOTS-1?6:k+7;r=cc_record(gi,code);on=0;
      j=0;loop(c,mem[INST_TRANSFORM_TYPE_BASE+gi*TRANSFORM_SLOTS+j]==code?on=1;j+=1;);
      code==6 ? (ch=cc_route_channel(gi,0);cc=mem[PARAM_MOD_CC_BASE+gi];value=mem[INST_MOD_BASE+gi];) : (
        b=cc_cfg(cc_index(gi,code));on=on && mem[b]>0 && mem[tf_record(cc_index(gi,code))]==6;ch=cc_route_channel(gi,mem[b+3]);cc=mem[b+1];value=mem[b+2];
      );
      mem[r+4]=on && mem[INST_ENABLED_BASE+gi]>.5;mem[r+5]=ch;
      mem[r+6]=max(0,min(127,floor(cc+.5)));mem[r+7]=max(0,min(127,floor(value+.5)));k+=1;
    );gi+=1;
  );
  // A CC64 destination is released using its saved channel before it disappears.
  index=0;loop(CC_EXTRA+INSTRUMENTS,r=CC_RT_BASE+index*CC_RT_STRIDE;
    mem[r]>0 && mem[r+2]==64 && (!mem[r+4] || mem[r+1]!=mem[r+5] || mem[r+2]!=mem[r+6]) ? midisend(0,176|mem[r+1],64,0);
    index+=1;
  );
  gi=0;loop(INSTRUMENTS,k=0;c=max(0,min(TRANSFORM_SLOTS,floor(mem[INST_TRANSFORM_COUNT_BASE+gi])));
    loop(c,code=mem[INST_TRANSFORM_TYPE_BASE+gi*TRANSFORM_SLOTS+k];code>=6 && code<=11 && transform_type(gi,code)==6?(
      r=cc_record(gi,code);on=mem[r+4];ch=mem[r+5];cc=mem[r+6];value=mem[r+7];dirty=0;
      j=0;loop(CC_EXTRA+INSTRUMENTS,other=CC_RT_BASE+j*CC_RT_STRIDE;
        // Both old and new targets participate: removing the last writer restores
        // the preceding writer immediately, even if its own value did not change.
        ((mem[other+4]>0 && mem[other+5]==ch && mem[other+6]==cc) || (mem[other]>0 && mem[other+1]==ch && mem[other+2]==cc)) &&
          (mem[other]!=mem[other+4] || mem[other+1]!=mem[other+5] || mem[other+2]!=mem[other+6] || mem[other+3]!=mem[other+7]) ? dirty=1;
        j+=1;
      );
      on && (dirty || mem[CC_DIRTY_MOD_BASE+gi]>0) ? midisend(0,176|ch,cc,value);
    );k+=1;);gi+=1;
  );
  index=0;loop(CC_EXTRA+INSTRUMENTS,r=CC_RT_BASE+index*CC_RT_STRIDE;j=0;loop(4,mem[r+j]=mem[r+4+j];j+=1;);index+=1;);
);

function send_instrument_cc(gi, cc, value)
local(in_ch,out_ch,ch)
(
  mem[INST_ENABLED_BASE+gi]>0.5 ? (
    in_ch=mem[INST_IN_BASE+gi];
    out_ch=mem[INST_OUT_BASE+gi];
    // Fixed OUT wins. ORIGINAL follows a fixed IN channel; ALL+ORIGINAL uses CH1.
    ch=out_ch>0 ? max(1,min(16,out_ch))-1 :
       in_ch>0 ? max(1,min(16,in_ch))-1 : 0;
    midisend(0,176|ch,cc,max(0,min(127,floor(value+0.5))));
  );
);

function external_patch_save_request(slot)
local(j)
(
  // Copy a stable snapshot to shared memory; Lua writes JSON outside the JSFX.
  io_status=1;
  gmem[1]=slot;
  gmem[2]=IO_SCHEMA;
  gmem[3]=PATCH_PAYLOAD_SIZE;
  gmem[4]=loop_len_samples;
  gmem[5]=analysis_done;
  gmem[6]=slider4;
  gmem[7]=slider5;
  gmem[8]=slider6;
  gmem[9]=slider7;
  gmem[10]=slider8;
  gmem[11]=slider9;
  gmem[12]=record_layer;
  j=0;
  loop(PATCH_PAYLOAD_SIZE,
    gmem[IO_PAYLOAD_BASE+j]=mem[payload_addr(j)];
    j+=1;
  );
  gmem[0]=1;
);

function save_patch_file_snapshot(slot)
local(previous)
(
  previous=current_patch;save_patch(slot);current_patch=previous;
  // Only Lua's acknowledgement means the external file was saved.
  save_flash=0;external_patch_save_request(slot);
);

function external_patch_load_request(slot)
(
  gmem[1]=slot;
  gmem[0]=2;
);

function external_patch_apply()
local(j,n)
(
  n=gmem[3];
  ((gmem[2]==1 && n>0 && n<=WORK_MEM_SIZE) ||
   (gmem[2]==2 && n==SW_LEGACY_PAYLOAD && gmem[IO_PAYLOAD_BASE+WORK_MEM_SIZE]==PARAM_SCHEMA) ||
   (gmem[2]==3 && n==CC_LEGACY_PAYLOAD && gmem[IO_PAYLOAD_BASE+WORK_MEM_SIZE]==PARAM_SCHEMA && gmem[IO_PAYLOAD_BASE+SW_LEGACY_PAYLOAD]==SW_SCHEMA) ||
   (gmem[2]==4 && n==TF_LEGACY_PAYLOAD && gmem[IO_PAYLOAD_BASE+WORK_MEM_SIZE]==PARAM_SCHEMA && gmem[IO_PAYLOAD_BASE+SW_LEGACY_PAYLOAD]==SW_SCHEMA && gmem[IO_PAYLOAD_BASE+CC_LEGACY_PAYLOAD]==CC_SCHEMA) ||
   (gmem[2]==5 && n==DS_LEGACY_PAYLOAD && gmem[IO_PAYLOAD_BASE+WORK_MEM_SIZE]==PARAM_SCHEMA && gmem[IO_PAYLOAD_BASE+SW_LEGACY_PAYLOAD]==SW_SCHEMA && gmem[IO_PAYLOAD_BASE+CC_LEGACY_PAYLOAD]==CC_SCHEMA && gmem[IO_PAYLOAD_BASE+TF_LEGACY_PAYLOAD]==TF_SCHEMA) ||
   (gmem[2]==IO_SCHEMA && n==PATCH_PAYLOAD_SIZE && gmem[IO_PAYLOAD_BASE+WORK_MEM_SIZE]==PARAM_SCHEMA && gmem[IO_PAYLOAD_BASE+SW_LEGACY_PAYLOAD]==SW_SCHEMA && gmem[IO_PAYLOAD_BASE+CC_LEGACY_PAYLOAD]==CC_SCHEMA && gmem[IO_PAYLOAD_BASE+TF_LEGACY_PAYLOAD]==TF_SCHEMA && gmem[IO_PAYLOAD_BASE+DS_LEGACY_PAYLOAD]==IO_SCHEMA)) ? (
    // Patch memory only grows by appending fields, so older JSON patches remain valid prefixes.
    param_extension_reset();param_runtime_reset();sw_defaults();sw_runtime_reset();cc_defaults();cc_runtime_reset();tf_defaults();tf_runtime_reset();
    j=n;
    n<WORK_MEM_SIZE ? loop(WORK_MEM_SIZE-n, mem[j]=0; j+=1;);
    loop_len_samples=gmem[4];
    analysis_done=gmem[5];
    slider4=gmem[6];
    slider5=gmem[7];
    slider6=gmem[8];
    slider7=gmem[9];
    slider8=gmem[10];
    slider9=gmem[11];
    record_layer=gmem[12];
    j=0;
    loop(n,
      mem[payload_addr(j)]=gmem[IO_PAYLOAD_BASE+j];
      j+=1;
    );
    gmem[2]<IO_SCHEMA?ds_migrate();sw_validate();
    record_sample_pos=0;
    play_sample_pos=0;
    overdub_armed=0;
    overdub_active=0;
    overdub_pos=0;
