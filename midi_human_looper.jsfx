  ui_found=0;ui_g=0;loop(INSTRUMENTS,ui_k=0;ui_c=max(0,min(TRANSFORM_SLOTS,mem[INST_TRANSFORM_COUNT_BASE+ui_g]));
    loop(ui_c,ui_other=mem[INST_TRANSFORM_TYPE_BASE+ui_g*TRANSFORM_SLOTS+ui_k];
      ui_other>=6 && ui_other<=11 && transform_type(ui_g,ui_other)==6 && (ui_g!=gi || ui_other!=ui_code) && mem[INST_ENABLED_BASE+ui_g]>.5?(
        ui_ob=ui_other==6?-1:cc_cfg(cc_index(ui_g,ui_other));
