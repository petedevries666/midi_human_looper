 k=0;loop(SW_COUNT,other=sw_cfg(k);j=0;loop(3,(mem[other+14+j]==SW_RESET || mem[other+14+j]==SW_STOP_RESET) && mem[other+17+j]==si?mem[other+14+j]=SW_NONE;j+=1;);k+=1;);
