// Compact two-line instrument strip, matching the visual mockup.
function transform_has(gi, ui_typ)
local(ui_k,c,found)
(
  found=0; c=max(0,min(TRANSFORM_SLOTS,floor(mem[INST_TRANSFORM_COUNT_BASE+gi]+0.5))); ui_k=0;
