        op==4 && arg>=0 && arg<n ? (j=arg;loop(n-arg-1,mem[b+SW_LIST+j]=mem[b+SW_LIST+j+1];j+=1;);mem[b+11]=n-1;);
        op==5 ? mem[b+11]=0;
