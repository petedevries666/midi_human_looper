    target=sw_cfg(si);changed=sw_edit_new;j=0;loop(20,mem[target+j]!=mem[b+j]?changed=1;j+=1;);j=48;loop(64,mem[target+j]!=mem[b+j]?changed=1;j+=1;);
    changed?sw_quarantine_slot(si);sw_edit_new?(mem[sw_rt(si)+11]=0;mem[sw_rt(si)+12]=0;);j=0;loop(24,mem[target+j]=mem[b+j];j+=1;);j=32;loop(80,mem[target+j]=mem[b+j];j+=1;);mem[target+23]=0;sw_end_edit();
