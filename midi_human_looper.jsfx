    ui_ci==1?(slider11=controller_value(ui_ci););
  );
  gfx_set(.72,.72,.72,1);gfx_x=962;gfx_y=rowy+3;gfx_drawnumber(controller_value(ui_ci)*100,0);gfx_drawstr("%");
  ui_ci+=1;
);
exp_y+=216;
ui_modal ? mouse_cap=0;
!(ui_real_cap&1)?ui_td_reset_latch=0;

exp_editor_ti>=0 && exp_editor_ti<UI_PARAM_TOTAL ? (
  smallbtn(914,exp_y+8,92,22,"CLOSE CURVE",0);
  hit(914,exp_y+8,92,22) ? (
    exp_editor_ti=-1;exp_drag_point=-1;exp_drag_segment=-1;exp_bend_segment=-1;
  );
);

// Multipoint editor appears for any assigned instrument ui_target.
exp_editor_ti>=0 && exp_editor_ti<UI_PARAM_TOTAL ? (
  curve_ti=floor(exp_editor_ti+0.5);
  curve_gi=param_gi(curve_ti);
  curve_kind=param_kind(curve_ti);
  cx=128; cy=exp_y+38; cw=500; ui_ch=150;
  gfx_set(0.10,0.10,0.10,1); gfx_rect(cx,cy,cw,ui_ch,1);
  gfx_set(0.35,0.35,0.35,1); gfx_rect(cx,cy,cw,ui_ch,0);
  // Clear identity block: what are we editing, and what controls it?
  gfx_setfont(1,"Arial",11); gfx_set(0.95,0.95,0.15,1);
  gfx_x=8; gfx_y=cy+2; gfx_drawstr("INSTR. "); gfx_drawnumber(curve_gi+1,0);
  gfx_setfont(1,"Arial",14);
  gfx_x=8; gfx_y=cy+20;
  gfx_drawstr(param_name(curve_kind));
  gfx_setfont(1,"Arial",9); gfx_set(0.55,0.55,0.55,1);
  gfx_x=8; gfx_y=cy+43; gfx_drawstr("MAPPED TO");
  gfx_setfont(1,"Arial",12); gfx_set(0.90,0.90,0.90,1);
  gfx_x=8; gfx_y=cy+57;
  gfx_drawstr(controller_name(mem[exp_assign_addr(curve_ti)]-1));
  gfx_setfont(1,"Arial",8); gfx_set(0.48,0.48,0.48,1);
  gfx_x=8; gfx_y=cy+92; gfx_drawstr("L  add / drag");
  gfx_x=8; gfx_y=cy+104; gfx_drawstr("R  remove");
  gfx_x=8; gfx_y=cy+116; gfx_drawstr("SHIFT  segment");
  gfx_x=8; gfx_y=cy+128; gfx_drawstr("ALT  bend");

  // Particular-style preset strip on the right of the editor.
  ppx=646; ppw=88; pph=16; ppy=cy+18;
  gfx_setfont(1,"Arial",9); gfx_set(0.72,0.72,0.72,1);
  gfx_x=ppx; gfx_y=ppy-14; gfx_drawstr("PRESETS");
  pi=0;
  loop(5,
    draw_curve_preset_thumb(ppx,ppy+pi*(pph+3),ppw,pph,0,pi);
    hit(ppx,ppy+pi*(pph+3),ppw,pph) ? curve_factory(curve_ti,pi);
    pi+=1;
  );
  // Custom slots: compact row under factory presets.
  cpy=ppy+5*(pph+3)+1; cpw=20;
  pi=0;
  loop(CUSTOM_PRESETS,
    draw_curve_preset_thumb(ppx+pi*22,cpy,cpw,pph,1,pi);
    hit(ppx+pi*22,cpy,cpw,pph) ? (
      custom_save_armed ? (
        curve_custom_save(curve_ti,pi); custom_save_armed=0;
      ) : curve_custom_load(curve_ti,pi);
    );
    pi+=1;
  );
  smallbtn(ppx,cpy+pph+4,ppw,18,custom_save_armed ? "CHOOSE C1-C4" : "SAVE CUSTOM",custom_save_armed);
  hit(ppx,cpy+pph+4,ppw,18) ? custom_save_armed=1-custom_save_armed;

  kk=1;
  loop(4,
    gx=cx+cw*(kk/5); gy=cy+ui_ch*(kk/5);
    gfx_set(0.20,0.20,0.20,1); gfx_line(gx,cy,gx,cy+ui_ch); gfx_line(cx,gy,cx+cw,gy);
    kk+=1;
  );

  cnt=max(2,min(EXP_POINTS,floor(mem[exp_count_addr(curve_ti)]+0.5)));
  // Hard invariant: extreme nodes always live at X=0 and X=1.
  // Endpoint invariants are established by initialization/migration and edits.
  // Drawing must not repair persistent data on every frame.

  // Draw curved segments and find nearest segment by sampling.
  hover_seg=-1; seg_best=999999;
  kk=0;
  loop(cnt-1,
    x0=mem[exp_x_addr(curve_ti)+kk];
    x1=mem[exp_x_addr(curve_ti)+kk+1];
    px0=cx+cw*x0; py0=cy+ui_ch*(1-gui_exp_curve_value(curve_ti,x0));
    ui_ss=1;
    loop(20,
      ui_st=ui_ss/20; ui_sx=x0+(x1-x0)*ui_st;
      px1=cx+cw*ui_sx; py1=cy+ui_ch*(1-gui_exp_curve_value(curve_ti,ui_sx));
      gfx_set(0.75,0.75,0.75,1); gfx_line(px0,py0,px1,py1);
      // Distance to this tiny sampled line segment, sufficient for segment hit-testing.
      vx_=px1-px0; vy_=py1-py0; wx_=mouse_x-px0; wy_=mouse_y-py0;
      den_=vx_*vx_+vy_*vy_;
      tt_=den_>0 ? max(0,min(1,(wx_*vx_+wy_*vy_)/den_)) : 0;
      qx_=px0+tt_*vx_; qy_=py0+tt_*vy_;
      dd_=(mouse_x-qx_)*(mouse_x-qx_)+(mouse_y-qy_)*(mouse_y-qy_);
      dd_<seg_best ? (seg_best=dd_; hover_seg=kk;);
      px0=px1; py0=py1; ui_ss+=1;
    );
    kk+=1;
  );
  seg_best>100 ? hover_seg=-1;

  hover=-1; bestd=999999; kk=0;
  loop(cnt,
    px=cx+cw*mem[exp_x_addr(curve_ti)+kk];
    py=cy+ui_ch*(1-mem[exp_y_addr(curve_ti)+kk]);
    dd=(mouse_x-px)*(mouse_x-px)+(mouse_y-py)*(mouse_y-py);
    dd<100 && dd<bestd ? (bestd=dd; hover=kk;);
    gfx_set(0.9,0.9,0.9,1); gfx_rect(px-4,py-4,8,8,1);
    kk+=1;
  );

  // Only interior nodes may be removed.
  (mouse_cap&2) && !(last_mouse_cap&2) && hover>0 && hover<cnt-1 && cnt>2 ? (
    kk=hover;
    loop(cnt-hover-1,
      mem[exp_x_addr(curve_ti)+kk]=mem[exp_x_addr(curve_ti)+kk+1];
      mem[exp_y_addr(curve_ti)+kk]=mem[exp_y_addr(curve_ti)+kk+1];
      kk+=1;
    );
    mem[exp_count_addr(curve_ti)]=cnt-1;
    // Topology changed: reset segment bends rather than attach a bend to the wrong neighbours.
    kk=0; loop(EXP_POINTS, mem[exp_bend_addr(curve_ti)+kk]=0; kk+=1;);
    exp_drag_point=-1;
  );

  fresh_left=(mouse_cap&1) && !(last_mouse_cap&1);
  shift_down=(mouse_cap&8)>0;
  alt_down=(mouse_cap&16)>0;

  // ALT + segment: capture curvature drag.
  fresh_left && alt_down && hover_seg>=0 ? (
    exp_bend_segment=hover_seg;
    exp_bend_start_y=mouse_y;
    exp_bend_start=mem[exp_bend_addr(curve_ti)+hover_seg];
  );

  // SHIFT + segment: capture both endpoints and their original coordinates.
  fresh_left && shift_down && !alt_down && hover_seg>=0 ? (
    exp_drag_segment=hover_seg;
    exp_seg_start_x=mouse_x; exp_seg_start_y=mouse_y;
    exp_seg_x0=mem[exp_x_addr(curve_ti)+hover_seg];
    exp_seg_y0=mem[exp_y_addr(curve_ti)+hover_seg];
    exp_seg_x1=mem[exp_x_addr(curve_ti)+hover_seg+1];
    exp_seg_y1=mem[exp_y_addr(curve_ti)+hover_seg+1];
  );

  // Plain left click: point drag or point creation.
  fresh_left && !shift_down && !alt_down &&
  mouse_x>=cx && mouse_x<=cx+cw && mouse_y>=cy && mouse_y<=cy+ui_ch ? (
    hover>=0 ? exp_drag_point=hover : (
      cnt<EXP_POINTS ? (
        mem[exp_x_addr(curve_ti)+cnt]=max(0.001,min(0.999,(mouse_x-cx)/cw));
        mem[exp_y_addr(curve_ti)+cnt]=max(0,min(1,1-(mouse_y-cy)/ui_ch));
        mem[exp_count_addr(curve_ti)]=cnt+1;
        exp_sort_points(curve_ti);
        kk=0; loop(EXP_POINTS, mem[exp_bend_addr(curve_ti)+kk]=0; kk+=1;);
        exp_drag_point=-1; bestd=999999; kk=0;
        loop(cnt+1,
          px=cx+cw*mem[exp_x_addr(curve_ti)+kk];
          py=cy+ui_ch*(1-mem[exp_y_addr(curve_ti)+kk]);
          dd=(mouse_x-px)*(mouse_x-px)+(mouse_y-py)*(mouse_y-py);
          dd<bestd ? (bestd=dd; exp_drag_point=kk;);
          kk+=1;
        );
      );
    );
  );

  // Individual point drag. Extreme nodes are vertical-only.
  exp_drag_point>=0 && mouse_cap&1 && !shift_down && !alt_down ? (
    newy=max(0,min(1,1-(mouse_y-cy)/ui_ch));
    mem[exp_y_addr(curve_ti)+exp_drag_point]=newy;
    exp_drag_point>0 && exp_drag_point<cnt-1 ? (
      leftx=mem[exp_x_addr(curve_ti)+exp_drag_point-1]+0.001;
      rightx=mem[exp_x_addr(curve_ti)+exp_drag_point+1]-0.001;
      mem[exp_x_addr(curve_ti)+exp_drag_point]=max(leftx,min(rightx,(mouse_x-cx)/cw));
    );
    mem[param_last_addr(curve_ti)]=-999;
  );

  // SHIFT segment drag. Edge segments are vertical-only; fully interior segments also move horizontally.
  exp_drag_segment>=0 && mouse_cap&1 ? (
    ds=exp_drag_segment;
    dy_=-(mouse_y-exp_seg_start_y)/ui_ch;
    max_up=min(1-exp_seg_y0,1-exp_seg_y1);
    max_dn=min(exp_seg_y0,exp_seg_y1);
    dy_=max(-max_dn,min(max_up,dy_));
    mem[exp_y_addr(curve_ti)+ds]=exp_seg_y0+dy_;
    mem[exp_y_addr(curve_ti)+ds+1]=exp_seg_y1+dy_;
    ds>0 && ds+1<cnt-1 ? (
      dx_=(mouse_x-exp_seg_start_x)/cw;
      left_lim=mem[exp_x_addr(curve_ti)+ds-1]+0.001-exp_seg_x0;
      right_lim=mem[exp_x_addr(curve_ti)+ds+2]-0.001-exp_seg_x1;
      dx_=max(left_lim,min(right_lim,dx_));
      mem[exp_x_addr(curve_ti)+ds]=exp_seg_x0+dx_;
      mem[exp_x_addr(curve_ti)+ds+1]=exp_seg_x1+dx_;
    );
    mem[param_last_addr(curve_ti)]=-999;
  );

  // ALT segment drag controls signed curvature.
  exp_bend_segment>=0 && mouse_cap&1 ? (
    ds=exp_bend_segment;
    bend_=exp_bend_start+(mouse_y-exp_bend_start_y)/80;
    mem[exp_bend_addr(curve_ti)+ds]=max(-0.98,min(0.98,bend_));
    mem[param_last_addr(curve_ti)]=-999;
  );

  !(mouse_cap&1) ? (
    exp_drag_point=-1;
    exp_drag_segment=-1;
    exp_bend_segment=-1;
  );

  pedalx=mem[exp_assign_addr(curve_ti)]>0?controller_value(max(0,min(CONTROLLERS-1,mem[exp_assign_addr(curve_ti)]-1))):0;
  gfx_set(0.55,0.55,0.55,1); gfx_line(cx+cw*pedalx,cy,cx+cw*pedalx,cy+ui_ch);
);


// Smart Switch GUI produces commands; DSP owns gesture/traversal/action state.
function sw_ui_button(x,y,w,label,active)
(smallbtn(x,y,w,24,label,active);hit(x,y,w,24););
function sw_ui_action_name(action)
(action==0?"NONE":action==1?"NEXT PHRASE":action==2?"STOP PHRASES":action==3?"RESET SWITCH":action==4?"RESET ALL":action==5?"STOP + RESET":action==6?"PANIC ALL":action==7?"TOGGLE MODULE":action==8?"ENABLE MODULE":"DISABLE MODULE";);
function sw_ui_adjust(x,y,w,field,lo,hi,delta,label)
local(b)
(
  b=sw_edit_cfg(ui_sw_selected);gfx_set(.8,.8,.8,1);gfx_x=x+27;gfx_y=y+5;gfx_drawstr(label);
  sw_ui_button(x,y,22,"-",0)?sw_submit(ui_sw_selected,2,field,max(lo,mem[b+field]-delta));
  sw_ui_button(x+w-22,y,22,"+",0)?sw_submit(ui_sw_selected,2,field,min(hi,mem[b+field]+delta));
);
function draw_smart_switch_editor(y)
local(b,r,k,x,row,step,page,n,act,target)
(
  ui_sw_selected=max(0,min(SW_COUNT-1,ui_sw_selected));b=sw_edit_cfg(ui_sw_selected);r=sw_rt(ui_sw_selected);
  gfx_set(.75,.75,.75,1);gfx_x=20;gfx_y=y;gfx_drawstr("SMART SWITCHES / PHRASE CONDUCTOR");
  sw_ui_button(600,y+24,120,mem[b]>0?"ENABLED":"DISABLED",mem[b]>0)?sw_submit(ui_sw_selected,2,0,1-mem[b]);
  sw_ui_button(730,y+24,230,mem[b+1]==0?"TYPE: PHRASE":"TYPE: SPECIAL",0)?sw_submit(ui_sw_selected,2,1,1-mem[b+1]);
  smallbtn(20,y+56,250,24,"",0);draw_name_chars(b+SW_NAME,28,y+61);
  name_len(b+SW_NAME)==0?(gfx_x=28;gfx_y=y+61;gfx_drawstr("CLICK TO NAME SWITCH"););
  hit(20,y+56,250,24)?(edit_name_type=3;edit_name_index=ui_sw_selected;);
  sw_ui_button(285,y+56,145,sw_learn==ui_sw_selected?"LISTENING...":"MIDI LEARN",sw_learn==ui_sw_selected)?sw_learn_request=sw_learn==ui_sw_selected?-2:ui_sw_selected;
  sw_ui_button(440,y+56,160,mem[b+5]>0?"MIDI THRU: ON":"MIDI THRU: OFF",mem[b+5]>0)?sw_submit(ui_sw_selected,2,5,1-mem[b+5]);
  sw_ui_button(610,y+56,150,mem[b+2]==1?"INPUT: NOTE":mem[b+2]==2?"INPUT: CC":"UNASSIGNED",0)?sw_submit(ui_sw_selected,1,(mem[b+2]+1)%3,mem[b+4]);
  sprintf(#sw_label,"NUMBER %d",mem[b+4]);
  sw_ui_button(770,y+56,24,"-",0)?sw_submit(ui_sw_selected,1,mem[b+2],max(0,mem[b+4]-1));
  smallbtn(798,y+56,125,24,#sw_label,0);
  sw_ui_button(930,y+56,24,"+",0)?sw_submit(ui_sw_selected,1,mem[b+2],min(127,mem[b+4]+1));
  sw_ui_button(790,y+88,170,"FORGET MIDI",0)?(sw_learn_request=-2;sw_submit(ui_sw_selected,8,ui_sw_selected,0););
  sprintf(#sw_label,"CHANNEL %d",mem[b+3]+1);sw_ui_adjust(20,y+88,220,3,0,15,1,#sw_label);
  sprintf(#sw_label,"CC PRESS %d",mem[b+12]);sw_ui_adjust(260,y+88,220,12,0,127,1,#sw_label);
  sprintf(#sw_label,"CC RELEASE %d",mem[b+13]);sw_ui_adjust(500,y+88,220,13,0,127,1,#sw_label);

  mem[b+1]==0 ? (
    gfx_x=20;gfx_y=y+125;gfx_drawstr("PHRASE POOL: click to append (duplicates allowed)");
    k=0;loop(LAYERS,
      sprintf(#sw_label,"P%d",k+1);sw_ui_button(20+k*59,y+146,54,#sw_label,layer_count(k)>0)?sw_submit(ui_sw_selected,3,k,0);k+=1;
    );
    n=mem[b+11];ui_sw_step=max(0,min(max(0,n-1),ui_sw_step));page=floor(ui_sw_step/16)*16;
    k=0;loop(16,
      step=page+k;x=20+(k%8)*118;row=y+180+floor(k/8)*30;
      step<n ? (
        sprintf(#sw_label,"%d: P%d%s",step+1,mem[b+SW_LIST+step]+1,step==ui_sw_step?" *":"");
        sw_ui_button(x,row,112,#sw_label,step==mem[r+7])?ui_sw_step=step;
      );k+=1;
    );
    sw_ui_button(20,y+244,85,"PAGE <",0)?ui_sw_step=max(0,page-16);
    sw_ui_button(112,y+244,85,"PAGE >",0)?ui_sw_step=min(max(0,n-1),page+16);
    sw_ui_button(210,y+244,85,"MOVE <",0)?(sw_submit(ui_sw_selected,6,ui_sw_step,max(0,ui_sw_step-1))?ui_sw_step=max(0,ui_sw_step-1););
    sw_ui_button(302,y+244,85,"MOVE >",0)?(sw_submit(ui_sw_selected,6,ui_sw_step,min(n-1,ui_sw_step+1))?ui_sw_step=min(n-1,ui_sw_step+1););
    sw_ui_button(400,y+244,85,"REMOVE",0)?sw_submit(ui_sw_selected,4,ui_sw_step,0);
    sw_ui_button(492,y+244,85,"CLEAR",0)?sw_submit(ui_sw_selected,5,0,0);
    sw_ui_button(584,y+244,85,"UNDO",0)?sw_submit(ui_sw_selected,7,0,0);
    sw_ui_button(690,y+244,150,mem[b+9]==0?"FORWARD":mem[b+9]==1?"BACKWARD":mem[b+9]==2?"PING-PONG":"SHUFFLE BAG",0)?sw_submit(ui_sw_selected,2,9,(mem[b+9]+1)%4);
    sw_ui_button(850,y+244,130,mem[b+10]==0?"RESUME":"RESTART",mem[b+10]>0)?sw_submit(ui_sw_selected,2,10,1-mem[b+10]);
    sprintf(#sw_label,"%d / 64 steps | lit = last triggered position; * = selected | re-entry: RESUME / RESTART",n);
    gfx_x=20;gfx_y=y+280;gfx_drawstr(#sw_label);
  ) : (gfx_x=20;gfx_y=y+145;gfx_drawstr("SPECIAL SWITCH: choose independent actions and targets below."););
  k=0;loop(3,
    row=y+316+k*30;act=mem[b+14+k];target=mem[b+17+k];
    gfx_x=20;gfx_y=row+5;gfx_drawstr(k==0?"TAP":k==1?"DOUBLE":"HOLD");
    sw_ui_button(110,row,215,sw_ui_action_name(act),act>0)?sw_submit(ui_sw_selected,2,14+k,mem[b+1]>0 && act==0?2:(act+1)%10);
    act==3 || act==5 ? sprintf(#sw_label,target==SW_COUNT?"TARGET: ALL SWITCHES":"TARGET: SWITCH %d",target+1) : act>=7 ? sprintf(#sw_label,"INST %d / %s",floor(target/TRANSFORM_TYPES)+1,target%TRANSFORM_TYPES==0?"TRANSPOSE":target%TRANSFORM_TYPES==1?"RANGE":target%TRANSFORM_TYPES==2?"MONO":target%TRANSFORM_TYPES==3?"VELOCITY":target%TRANSFORM_TYPES==4?"ARP":"CC / MOD") : strcpy(#sw_label,"GLOBAL / NO TARGET");
    sw_ui_button(340,row,300,#sw_label,0) && (act==3 || act==5 || act>=7)?sw_submit(ui_sw_selected,2,17+k,(target+1)%(act>=7?INSTRUMENTS*TRANSFORM_TYPES:SW_COUNT+1));
    sw_ui_button(660,row,120,k==0?"TEST TAP":k==1?"TEST DOUBLE":"TEST HOLD",0)?sw_submit(ui_sw_selected,0,k,0);k+=1;
  );
  sw_ui_button(20,y+420,220,mem[b+6]==0?"POLICY: INSTANT":"POLICY: EXCLUSIVE",mem[b+6]>0)?sw_submit(ui_sw_selected,2,6,1-mem[b+6]);
  sprintf(#sw_label,"DOUBLE %d ms",mem[b+7]);sw_ui_adjust(260,y+420,240,7,50,2000,50,#sw_label);
  sprintf(#sw_label,"HOLD %d ms",mem[b+8]);sw_ui_adjust(520,y+420,240,8,100,5000,100,#sw_label);
  gfx_x=20;gfx_y=y+454;gfx_drawstr(mem[b+6]==0?"INSTANT: tap now; double / hold may add an action.":"EXCLUSIVE: waits only for enabled gestures; one action per gesture.");
  sprintf(#sw_label,"Actions: %d | Last: %s | %s",mem[r+12],sw_ui_action_name(mem[r+11]),mem[r+17]==1?"ASSIGNMENT CONFLICT / INVALID CC":mem[r+17]==2?"EMPTY / UNAVAILABLE PHRASE":mem[r+17]==3?"MISSING RELEASE: 10s timeout":mem[r+17]==4?"MODULE NOT IN CHAIN":"READY");
  gfx_x=20;gfx_y=y+480;gfx_drawstr(#sw_label);
);
function draw_smart_switch_cards(y)
local(ui_i,ui_n,ui_b,ui_r,ui_x,ui_y)
(
  gfx_setfont(1,"Arial",14);gfx_set(.8,.8,.8,1);gfx_x=20;gfx_y=y;gfx_drawstr("SMART SWITCHES");ui_i=0;ui_n=0;
  loop(SW_COUNT,ui_b=sw_committed_cfg(ui_i);mem[ui_b+20]>0?(
    ui_x=20+(ui_n%4)*250;ui_y=y+26+floor(ui_n/4)*84;ui_r=sw_rt(ui_i);
    gfx_set(.1,.1,.1,1);gfx_rect(ui_x,ui_y,240,78,1);gfx_set(.5,.5,.5,1);gfx_rect(ui_x,ui_y,240,78,0);
    gfx_setfont(1,"Arial",11);gfx_set(.9,.9,.9,1);
    name_len(ui_b+SW_NAME)>0?draw_name_chars(ui_b+SW_NAME,ui_x+8,ui_y+6):(
      sprintf(#sw_label,"SWITCH %d",mem[ui_b+21]);gfx_x=ui_x+8;gfx_y=ui_y+6;gfx_drawstr(#sw_label););
    gfx_setfont(1,"Arial",9);sprintf(#sw_label,"%s / %s %d / CH %d",mem[ui_b+1]==0?"PHRASE":"SPECIAL",mem[ui_b+2]==0?"UNASSIGNED":mem[ui_b+2]==1?"NOTE":"CC",mem[ui_b+4],mem[ui_b+3]+1);
    gfx_x=ui_x+8;gfx_y=ui_y+25;gfx_drawstr(#sw_label);
    sprintf(#sw_label,"STEP %d / %d | ID %d",mem[ui_r+7]+1,mem[ui_b+11],mem[ui_b+21]);gfx_x=ui_x+8;gfx_y=ui_y+42;gfx_drawstr(#sw_label);
    sw_ui_button(ui_x+8,ui_y+53,74,"EDIT",0)?sw_submit(ui_i,11,0,0);
    sw_ui_button(ui_x+188,ui_y+3,44,mem[ui_b]>0?"ON":"OFF",mem[ui_b]>0)?sw_submit(ui_i,2,0,1-mem[ui_b]);
    sw_ui_button(ui_x+212,ui_y+53,22,"×",0)?(ui_sw_delete_slot=ui_i;ui_sw_delete_id=mem[ui_b+21];);
    ui_n+=1;
  );ui_i+=1;);
  sw_ui_button(20,y+26+ceil(ui_n/4)*84,190,"+ ADD SMART SWITCH",0)?sw_submit(0,14,0,0);
  ui_n==SW_COUNT?(gfx_x=230;gfx_y=y+31+ceil(ui_n/4)*84;gfx_drawstr("ENGINE CAPACITY: 16 SWITCHES"););
);
draw_smart_switch_cards(1490);

// Overlay input is restored after all underlying controls have finished.
mouse_cap=ui_real_cap;ui_modal=learn_candidate>=0;
draw_transform_menu_overlay(0,transform_rows_y);
draw_transform_menu_overlay(1,transform_rows_y+124);
draw_transform_menu_overlay(2,transform_rows_y+248);

ui_sw_editor_open && learn_candidate<0 ? (
  ui_modal=0;ui_sw_editor_y=max(ui_scroll+8,min(ui_scroll+gfx_h-554,1490));
  gfx_set(.025,.025,.025,1);gfx_rect(10,ui_sw_editor_y-6,990,548,1);gfx_set(.75,.75,.75,1);gfx_rect(10,ui_sw_editor_y-6,990,548,0);
  draw_smart_switch_editor(ui_sw_editor_y);
  sw_ui_button(690,ui_sw_editor_y+508,130,"DONE",0)?sw_submit(ui_sw_selected,12,0,0);
  sw_ui_button(830,ui_sw_editor_y+508,130,"CANCEL",0)?sw_submit(ui_sw_selected,13,0,0);
  sw_ui_button(960,ui_sw_editor_y,28,"×",0)?sw_submit(ui_sw_selected,13,0,0);
  keychar==27 || (ui_frame_modal && (mouse_cap&3) && !(last_mouse_cap&3) && (mouse_x<10 || mouse_x>=1000 || mouse_y<ui_sw_editor_y-6 || mouse_y>=ui_sw_editor_y+542))?sw_submit(ui_sw_selected,13,0,0);
  ui_modal=1;
);
ui_sw_delete_slot>=0 && learn_candidate<0 ? (
  ui_modal=0;ui_sw_delete_y=ui_scroll+max(8,(gfx_h-130)/2);
  gfx_set(.035,.035,.035,1);gfx_rect(240,ui_sw_delete_y,540,130,1);gfx_set(.85,.85,.85,1);gfx_rect(240,ui_sw_delete_y,540,130,0);
  gfx_x=260;gfx_y=ui_sw_delete_y+20;gfx_drawstr("DELETE THIS SMART SWITCH? Phrase data is retained.");
  sw_ui_button(270,ui_sw_delete_y+75,180,"DELETE",0)?(sw_submit(ui_sw_delete_slot,15,0,ui_sw_delete_id);ui_sw_delete_slot=-1;);
  (sw_ui_button(480,ui_sw_delete_y+75,180,"CANCEL",0) || keychar==27 || (ui_frame_modal && (mouse_cap&3) && !(last_mouse_cap&3) && (mouse_x<240 || mouse_x>=780 || mouse_y<ui_sw_delete_y || mouse_y>=ui_sw_delete_y+130)))?ui_sw_delete_slot=-1;
  ui_modal=1;
);

// Named controller assignment popup.
controller_assign_ti>=0 ? (
  ax=max(8,min(760,controller_assign_x));ay=max(ui_scroll+8,min(ui_scroll+gfx_h-142,controller_assign_y));aw=190;
  gfx_set(.03,.03,.03,1);gfx_rect(ax,ay,aw,132,1);gfx_set(.8,.8,.8,1);gfx_rect(ax,ay,aw,132,0);
  smallbtn(ax+4,ay+4,aw-8,20,"NONE",mem[exp_assign_addr(controller_assign_ti)]==0);
  hit(ax+4,ay+4,aw-8,20)?(mem[exp_assign_addr(controller_assign_ti)]=0;mem[param_last_addr(controller_assign_ti)]=-999;mem[param_pending_addr(controller_assign_ti)]=-999;exp_editor_ti==controller_assign_ti?(exp_editor_ti=-1;exp_drag_point=-1;exp_drag_segment=-1;exp_bend_segment=-1;);controller_assign_ti=-1;);
  ui_ci=0;loop(CONTROLLERS,
    controller_assign_ti>=0?(
      smallbtn(ax+4,ay+28+ui_ci*24,aw-8,20,controller_name(ui_ci),mem[exp_assign_addr(controller_assign_ti)]==ui_ci+1);
      hit(ax+4,ay+28+ui_ci*24,aw-8,20)?(mem[exp_assign_addr(controller_assign_ti)]=ui_ci+1;mem[param_last_addr(controller_assign_ti)]=-999;exp_editor_ti=controller_assign_ti;exp_drag_point=-1;exp_drag_segment=-1;exp_bend_segment=-1;ui_capture_ti=-1;controller_assign_ti=-1;);
    );ui_ci+=1;
  );
);

controller_assign_ti>=0 && ((mouse_cap&3 && !(last_mouse_cap&3) &&
  (mouse_x<ax || mouse_x>=ax+aw || mouse_y<ay || mouse_y>=ay+132)) || keychar==27) ? controller_assign_ti=-1;


options_open && learn_candidate<0 ? (
  ox=500;oy=104;ow=500;oh=188;gfx_set(.025,.025,.025,1);gfx_rect(ox,oy,ow,oh,1);gfx_set(.82,.82,.82,1);gfx_rect(ox,oy,ow,oh,0);
  gfx_setfont(1,"Arial",15);gfx_x=ox+12;gfx_y=oy+10;gfx_drawstr("CONTROLLERS");
  smallbtn(ox+ow-30,oy+6,24,24,"×",0);
  ui_close_options=hit(ox+ow-30,oy+6,24,24) || keychar==27 ||
    (ui_frame_modal && (mouse_cap&3) && !(last_mouse_cap&3) && (mouse_x<ox || mouse_x>=ox+ow || mouse_y<oy || mouse_y>=oy+oh));
  ui_ci=0;loop(CONTROLLERS,
    cy=oy+38+ui_ci*34;gfx_setfont(1,"Arial",11);gfx_set(.82,.82,.82,1);gfx_x=ox+12;gfx_y=cy+6;gfx_drawstr(controller_name(ui_ci));
    gfx_setfont(1,"Arial",10);gfx_x=ox+150;gfx_y=cy+7;
    mem[CONTROLLER_CC_BASE+ui_ci]<0?gfx_drawstr("UNASSIGNED"):(
      sprintf(#learn_label,"%s %d / CH %s",mem[sw_committed_cfg(ui_ci)+25]==1?"NOTE":"CC",mem[CONTROLLER_CC_BASE+ui_ci],"ANY");
      mem[sw_committed_cfg(ui_ci)+24]>0?sprintf(#learn_label,"%s %d / CH %d",mem[sw_committed_cfg(ui_ci)+25]==1?"NOTE":"CC",mem[CONTROLLER_CC_BASE+ui_ci],mem[sw_committed_cfg(ui_ci)+24]);gfx_drawstr(#learn_label);
    );
    smallbtn(ox+300,cy,84,24,controller_learn==ui_ci?"CANCEL":"LEARN",controller_learn==ui_ci);
    hit(ox+300,cy,84,24)?sw_learn_request=controller_learn==ui_ci?-2:SW_COUNT+ui_ci;
    smallbtn(ox+390,cy,96,24,"FORGET",0);
    hit(ox+390,cy,96,24)?(sw_learn_request=-2;sw_submit(0,8,SW_COUNT+ui_ci,0););
    ui_ci+=1;
  );
  ui_close_options ? (options_open=0;sw_learn_request=-2;);
);
// Explicit reassignment confirmation is modal and never activates underlying controls.
ui_modal=0;
learn_candidate>=0 && learn_conflict>=0 ? (
  gfx_set(.04,.04,.04,1);gfx_rect(340,ui_scroll+330,620,108,1);gfx_set(.9,.9,.9,1);
  sprintf(#learn_conflict_label,"Input assigned to %s %d. Reassign removes that mapping.",learn_conflict<SW_COUNT?"SWITCH":learn_conflict<SW_COUNT+CONTROLLERS?"CONTROLLER":"PHRASE",learn_conflict<SW_COUNT?learn_conflict+1:learn_conflict<SW_COUNT+CONTROLLERS?learn_conflict-SW_COUNT+1:learn_conflict-SW_COUNT-CONTROLLERS+1);
  gfx_x=354;gfx_y=ui_scroll+342;gfx_drawstr(#learn_conflict_label);
  sw_ui_button(354,ui_scroll+375,170,"REASSIGN",0)?sw_submit(0,9,0,0);
  sw_ui_button(540,ui_scroll+375,120,"CANCEL",0)?sw_submit(0,10,0,0);
  sw_ui_button(928,ui_scroll+334,24,"×",0)?sw_submit(0,10,0,0);
  keychar==27 || (ui_frame_modal && (mouse_cap&3) && !(last_mouse_cap&3) && (mouse_x<340 || mouse_x>=960 || mouse_y<ui_scroll+330 || mouse_y>=ui_scroll+438))?sw_submit(0,10,0,0);
);

// Present the scrolled viewport after the single topmost overlay pass.
gfx_dest=-1;
gfx_set(0,0,0,1); gfx_rect(0,0,gfx_w,gfx_h,1);
gfx_blit(1,1,0, 0,ui_scroll,gfx_w,gfx_h, 0,0,gfx_w,gfx_h);

// Restore physical mouse Y for the fixed viewport scrollbar.
mouse_y=screen_mouse_y;
ui_max_scroll=max(0,ui_content_h-gfx_h);
ui_max_scroll>0 ? (
  sbw=12; sbx=gfx_w-sbw-3; sby=3; sbh=max(30,gfx_h-6);
  thumbh=max(28,sbh*(gfx_h/ui_content_h));
  thumby=sby+(sbh-thumbh)*(ui_scroll/ui_max_scroll);

  gfx_set(0.12,0.12,0.12,1); gfx_rect(sbx,sby,sbw,sbh,1);
  gfx_set(0.55,0.55,0.55,1); gfx_rect(sbx+2,thumby,sbw-4,thumbh,1);

  !ui_frame_modal && (mouse_cap&1) && mouse_x>=sbx && mouse_x<=sbx+sbw ? (
    !(last_mouse_cap&1) ? sb_drag_offset=mouse_y-thumby;
    target_thumb_y=max(sby,min(sby+sbh-thumbh,mouse_y-sb_drag_offset));
    ui_scroll=(target_thumb_y-sby)/max(1,sbh-thumbh)*ui_max_scroll;
  );
);

last_mouse_cap=mouse_cap;
